---
// Google Maps iframe embed. `src` should be a Google Maps embed URL (the one
// from "Share → Embed a map", not a regular maps.google.com link).
interface Props {
  src: string;
  title?: string;
  id?: string;
}
const { src, title = 'Map', id = 'map' } = Astro.props;
---
<section id={id} class="map">
  <iframe
    src={src}
    title={title}
    width="100%"
    height="400"
    style="border:0;"
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    allowfullscreen
  ></iframe>
</section>
