---
import { primaryNav, business } from '../data/site';
import { TRACK } from '../data/tracking';
const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href !== '#' && href !== '/' ? path.startsWith(href) : path === href;
---
<header class="site-header">
  <div class="site-header__bar">
    <div class="site-header__left">
    <a href="/" class="brand" aria-label="Shutter Envy — home">
      <img
        src="/wp-content/uploads/2024/08/shutter-envy-horizontal-300x73.png"
        srcset="/wp-content/uploads/2024/08/shutter-envy-horizontal-300x73.png 300w, /wp-content/uploads/2024/08/shutter-envy-horizontal-650x159.png 650w"
        sizes="(max-width: 768px) 160px, 200px"
        width="200"
        height="49"
        alt="Shutter Envy"
        decoding="async"
      />
    </a>

    <nav class="primary-nav" aria-label="Primary">
      <ul>
        {primaryNav.map((item) => {
          const isMega = 'type' in item && item.type === 'mega';
          const isSimple = 'type' in item && item.type === 'simple';
          const isLocations = 'type' in item && item.type === 'locations';
          const hasDrop = isMega || isSimple || isLocations;
          return (
            <li
              class:list={['nav-item', hasDrop ? 'has-drop' : '']}
              data-has-drop={hasDrop ? '' : undefined}
            >
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                aria-expanded={hasDrop ? 'false' : undefined}
              >
                {item.label}
                {hasDrop && (
                  <svg class="caret" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                    <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                )}
              </a>

              {isMega && 'columns' in item && (
                <div class="mega-panel" role="region" aria-label={`${item.label} menu`}>
                  <div class="mega-panel__inner">
                    <div class="mega-panel__cols">
                      {item.columns.map((col) => (
                        <div class="mega-col">
                          <p class="mega-col__title">
                            {col.href ? <a href={col.href}>{col.heading}</a> : col.heading}
                          </p>
                          <ul>
                            {col.items.map((it) => (
                              <li>
                                <a href={it.href}>
                                  <span class="mega-col__label">{it.label}</span>
                                  {it.description && <span class="mega-col__desc">{it.description}</span>}
                                </a>
                              </li>
                            ))}
                          </ul>
                        </div>
                      ))}
                    </div>
                    {item.featured && (
                      <a class="mega-feature" href={item.featured.cta.href} data-track={TRACK.megaMenuFeaturedLocations}>
                        <img src={item.featured.image} alt="Shutter Envy van — free home survey across Leicestershire" loading="lazy" decoding="async" />
                        <div class="mega-feature__body">
                          <p class="mega-feature__title">{item.featured.heading}</p>
                          <p>{item.featured.body}</p>
                          <span class="mega-feature__cta">{item.featured.cta.label} →</span>
                        </div>
                      </a>
                    )}
                  </div>
                </div>
              )}

              {isSimple && 'items' in item && (
                <div class="simple-drop" role="region" aria-label={`${item.label} menu`}>
                  <a class="simple-drop__heading" href={item.href}>View all {item.label.toLowerCase()} →</a>
                  <ul>
                    {item.items.map((it) => (
                      <li><a href={it.href}>{it.label}</a></li>
                    ))}
                  </ul>
                </div>
              )}

              {isLocations && 'items' in item && (
                <div class="locations-panel" role="region" aria-label={`${item.label} menu`}>
                  <div class="locations-panel__inner">
                    <header class="locations-panel__head">
                      <div>
                        <span class="locations-panel__eyebrow">Coverage</span>
                        <p class="locations-panel__title">Areas we cover across Leicestershire</p>
                      </div>
                      {item.footerCta && (
                        <a class="locations-panel__cta" href={item.footerCta.href} data-track={TRACK.megaMenuFeaturedLocations}>
                          {item.footerCta.label}
                          <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                            <path d="M3 7h8m0 0L7 3m4 4l-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </a>
                      )}
                    </header>
                    <ul class="locations-panel__grid">
                      {item.items.map((loc) => (
                        <li>
                          <a href={loc.href} class="loc-tile">
                            <span class="loc-tile__media">
                              <img src={loc.image} alt={`Plantation shutters in ${loc.label}`} loading="lazy" decoding="async" />
                            </span>
                            <span class="loc-tile__body">
                              <span class="loc-tile__label">{loc.label}</span>
                              {loc.sublabel && <span class="loc-tile__sub">{loc.sublabel}</span>}
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              )}
            </li>
          );
        })}
      </ul>
    </nav>
    </div>

    <div class="site-header__right">
    <a class="header-phone" href={`tel:${business.phoneTel}`} aria-label={`Call ${business.phoneDisplay}`} data-track={TRACK.headerCtaPhone}>
      <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M20 15.5c-1.25 0-2.45-.2-3.57-.57a1 1 0 0 0-1.02.24l-2.2 2.2a15.05 15.05 0 0 1-6.59-6.59l2.2-2.2a1 1 0 0 0 .25-1.01A11.36 11.36 0 0 1 8.5 4a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1c0 9.39 7.61 17 17 17a1 1 0 0 0 1-1v-3.5a1 1 0 0 0-1-1z"/></svg>
      {business.phoneDisplay}
    </a>
    <a class="header-cta" href="/contact/" data-track={TRACK.headerCtaPhone}>
      Arrange a Home Visit
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M3 7h8m0 0L7 3m4 4l-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>

    <button class="mobile-toggle" aria-label="Open menu" aria-expanded="false" type="button" aria-controls="mobile-nav">
      <span></span><span></span><span></span>
    </button>
    </div>
  </div>
</header>

{/*
  Mobile menu lives OUTSIDE <header> on purpose. The header has
  `backdrop-filter` which makes it a containing block for any fixed-positioned
  descendant — so a `position: fixed` drawer placed inside the header would
  be trapped inside it instead of covering the viewport. Rendering it as a
  body-level sibling lets `position: fixed; inset: 0` actually fill the
  screen on every browser, especially iOS Safari.
*/}
<nav id="mobile-nav" class="mobile-nav" aria-label="Mobile" aria-hidden="true">
  <div class="mobile-nav__head">
    <a href="/" class="mobile-nav__brand" aria-label="Shutter Envy — home">
      <img
        src="/wp-content/uploads/2024/08/shutter-envy-horizontal-300x73.png"
        srcset="/wp-content/uploads/2024/08/shutter-envy-horizontal-300x73.png 300w, /wp-content/uploads/2024/08/shutter-envy-horizontal-650x159.png 650w"
        sizes="160px"
        width="200"
        height="49"
        alt="Shutter Envy"
        decoding="async"
      />
    </a>
    <button class="mobile-nav__close" type="button" aria-label="Close menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <div class="mobile-nav__body">
    <ul class="mobile-nav__list">
      {primaryNav.map((item) => {
        const hasDrop = 'type' in item && (item.type === 'mega' || item.type === 'simple' || item.type === 'locations');
        return (
          <li class:list={['mobile-nav__item', hasDrop ? 'has-children' : '']}>
            {hasDrop ? (
              <details>
                <summary>{item.label}</summary>
                <div class="mobile-nav__children">
                  <a class="mobile-nav__parent" href={item.href}>View all →</a>
                  {item.type === 'mega' && 'columns' in item && item.columns.map((col) => (
                    <div class="mobile-nav__group">
                      <p class="mobile-nav__group-title">{col.heading}</p>
                      <ul>
                        {col.items.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
                      </ul>
                    </div>
                  ))}
                  {item.type === 'simple' && 'items' in item && (
                    <ul>
                      {item.items.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
                    </ul>
                  )}
                  {item.type === 'locations' && 'items' in item && (
                    <ul>
                      {item.items.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
                    </ul>
                  )}
                </div>
              </details>
            ) : (
              <a href={item.href}>{item.label}</a>
            )}
          </li>
        );
      })}
    </ul>

    <div class="mobile-nav__footer">
      <a class="mobile-cta" href="/contact/" data-track={TRACK.mobileMenuCtaPhone}>Arrange a Home Visit</a>
      <a class="mobile-contact" href={`tel:${business.phoneTel}`} aria-label={`Call ${business.phoneDisplay}`} data-track={TRACK.mobileMenuCtaPhone}>
        <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M20 15.5c-1.25 0-2.45-.2-3.57-.57a1 1 0 0 0-1.02.24l-2.2 2.2a15.05 15.05 0 0 1-6.59-6.59l2.2-2.2a1 1 0 0 0 .25-1.01A11.36 11.36 0 0 1 8.5 4a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1c0 9.39 7.61 17 17 17a1 1 0 0 0 1-1v-3.5a1 1 0 0 0-1-1z"/></svg>
        {business.phoneDisplay}
      </a>
    </div>
  </div>
</nav>

<script>
  // Mega-menu + simple dropdown interactions.
  // Behaviour: hover (with small delay) on desktop, click on touch/keyboard.
  const navItems = document.querySelectorAll<HTMLElement>('.site-header .nav-item.has-drop');
  let hoverCloseTimers = new WeakMap<HTMLElement, number>();
  const HOVER_OPEN_MS = 80;
  const HOVER_CLOSE_MS = 180;

  const closeAll = (except?: HTMLElement) => {
    navItems.forEach((li) => {
      if (li === except) return;
      const trigger = li.querySelector<HTMLAnchorElement>(':scope > a');
      trigger?.setAttribute('aria-expanded', 'false');
      li.classList.remove('is-open');
    });
  };

  navItems.forEach((li) => {
    const trigger = li.querySelector<HTMLAnchorElement>(':scope > a');
    if (!trigger) return;

    let openTimer: number | undefined;

    const open = () => {
      window.clearTimeout(hoverCloseTimers.get(li));
      closeAll(li);
      trigger.setAttribute('aria-expanded', 'true');
      li.classList.add('is-open');
    };
    const close = () => {
      trigger.setAttribute('aria-expanded', 'false');
      li.classList.remove('is-open');
    };

    // Hover (with delay so quick mouse-sweeps don't pop everything open)
    li.addEventListener('mouseenter', () => {
      window.clearTimeout(hoverCloseTimers.get(li));
      openTimer = window.setTimeout(open, HOVER_OPEN_MS);
    });
    li.addEventListener('mouseleave', () => {
      window.clearTimeout(openTimer);
      hoverCloseTimers.set(li, window.setTimeout(close, HOVER_CLOSE_MS));
    });

    // Click on the trigger toggles (for touch + when JS-driven feels better)
    trigger.addEventListener('click', (e) => {
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';
      // Only intercept when the link is a placeholder (#) — real links navigate
      if (trigger.getAttribute('href') === '#') {
        e.preventDefault();
        isOpen ? close() : open();
      }
    });

    // Keyboard: open on Enter/Space when focused
    trigger.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        open();
        li.querySelector<HTMLAnchorElement>('.mega-panel a, .simple-drop a')?.focus();
      }
    });
  });

  // Esc closes everything
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAll(); });
  // Click outside closes
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('.site-header .nav-item.has-drop')) closeAll();
  });

  // Mobile menu (full-screen overlay)
  // The drawer is rendered outside <header> so its `position: fixed` isn't
  // trapped by the header's `backdrop-filter` containing block. When open
  // it covers the viewport and the body is scroll-locked using the
  // iOS-safe pattern (plain `overflow: hidden` on <body> does NOT actually
  // freeze scrolling on iOS Safari).
  const toggle = document.querySelector<HTMLButtonElement>('.mobile-toggle');
  const mobileNav = document.querySelector<HTMLElement>('.mobile-nav');
  const closeBtn = document.querySelector<HTMLButtonElement>('.mobile-nav__close');
  const header = document.querySelector<HTMLElement>('.site-header');

  let lockedScrollY = 0;

  const lockScroll = () => {
    lockedScrollY = window.scrollY;
    document.body.style.position = 'fixed';
    document.body.style.top = `-${lockedScrollY}px`;
    document.body.style.left = '0';
    document.body.style.right = '0';
    document.body.style.width = '100%';
  };

  const unlockScroll = () => {
    document.body.style.position = '';
    document.body.style.top = '';
    document.body.style.left = '';
    document.body.style.right = '';
    document.body.style.width = '';
    window.scrollTo(0, lockedScrollY);
  };

  const openMenu = () => {
    if (!toggle || !mobileNav) return;
    toggle.setAttribute('aria-expanded', 'true');
    mobileNav.classList.add('mobile-nav--open');
    mobileNav.setAttribute('aria-hidden', 'false');
    header?.classList.add('site-header--menu-open');
    lockScroll();
    // Move focus to the close button so keyboard users land inside the
    // overlay rather than stuck on the now-covered hamburger.
    requestAnimationFrame(() => closeBtn?.focus());
  };

  const closeMenu = () => {
    if (!toggle || !mobileNav) return;
    toggle.setAttribute('aria-expanded', 'false');
    mobileNav.classList.remove('mobile-nav--open');
    mobileNav.setAttribute('aria-hidden', 'true');
    header?.classList.remove('site-header--menu-open');
    unlockScroll();
    toggle.focus();
  };

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    isOpen ? closeMenu() : openMenu();
  });

  closeBtn?.addEventListener('click', closeMenu);

  // Tapping any link inside the drawer should close it so we never leave
  // the body in a scroll-locked state after navigation.
  mobileNav?.addEventListener('click', (e) => {
    const link = (e.target as Element).closest('a');
    if (link && mobileNav.contains(link)) closeMenu();
  });

  // Esc closes the mobile menu.
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mobileNav?.classList.contains('mobile-nav--open')) {
      closeMenu();
    }
  });

  // If the viewport crosses into desktop while the menu is open, close it
  // so the body doesn't stay scroll-locked behind a hidden drawer.
  const desktopMQ = window.matchMedia('(min-width: 1024px)');
  desktopMQ.addEventListener('change', (e) => {
    if (e.matches && mobileNav?.classList.contains('mobile-nav--open')) closeMenu();
  });
</script>

<style>
  /* ─── Base header ────────────────────────────────────────────── */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 60;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: saturate(180%) blur(10px);
    border-bottom: 1px solid rgba(207, 207, 207, 0.6);
  }
  /* Top gold hairline */
  .site-header::before {
    content: "";
    display: block;
    height: 3px;
    background: linear-gradient(90deg, var(--color-gold-400) 0%, var(--color-gold-600) 50%, var(--color-gold-400) 100%);
  }
  .site-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    width: 100%;
    padding: 0.875rem clamp(1.25rem, 3vw, 2.5rem);
  }
  .site-header__left {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 3vw, 3rem);
    flex: 1 1 auto;
    min-width: 0;
  }
  .site-header__right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }
  .site-header .brand {
    display: flex;
    align-items: center;
    text-decoration: none;
    line-height: 0;
    flex-shrink: 0;
  }
  .site-header .brand img {
    height: 44px;
    width: auto;
    display: block;
    transition: opacity 200ms;
  }
  @media (max-width: 767px) {
    .site-header .brand img { height: 38px; }
  }
  .site-header .brand:hover img { opacity: 0.8; }

  /* ─── Primary nav (desktop) ──────────────────────────────────── */
  .primary-nav { display: none; }
  @media (min-width: 1024px) { .primary-nav { display: block; } }

  .primary-nav > ul {
    list-style: none;
    margin: 0; padding: 0;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .primary-nav .nav-item { position: static; }

  .primary-nav > ul > li > a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.625rem 0.875rem;
    color: var(--color-ink);
    text-decoration: none;
    /* link-15-600 — brand nav link */
    font-size: 0.9375rem;
    line-height: 1.875;
    font-weight: 600;
    border-radius: 6px;
    position: relative;
    transition: color 150ms, background 150ms;
  }
  .primary-nav > ul > li > a:hover { background: rgba(199, 154, 8, 0.08); color: var(--color-gold-600); }
  .primary-nav .caret {
    opacity: 0.5;
    transition: transform 200ms, opacity 200ms;
  }
  .primary-nav > ul > li > a:hover .caret { opacity: 1; }
  .primary-nav .is-open > a .caret { transform: rotate(180deg); opacity: 1; }
  .primary-nav .is-open > a { background: rgba(199, 154, 8, 0.08); color: var(--color-gold-600); }
  .primary-nav > ul > li > a[aria-current="page"]::after {
    content: "";
    position: absolute;
    left: 0.875rem; right: 0.875rem;
    bottom: 0.25rem;
    height: 2px;
    background: var(--color-gold-400);
    border-radius: 2px;
  }

  /* ─── Mega panel ─────────────────────────────────────────────── */
  .mega-panel {
    position: absolute;
    top: 100%;
    left: 0; right: 0;
    background: #fff;
    border-top: 1px solid rgba(207,207,207,0.6);
    box-shadow: 0 24px 64px -24px rgba(7,7,7,0.18);
    opacity: 0;
    pointer-events: none;
    transform: translateY(-8px);
    transition: opacity 200ms, transform 200ms;
    z-index: 10;
  }
  .nav-item.is-open .mega-panel,
  .nav-item:focus-within .mega-panel {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }
  .mega-panel__inner {
    /* Match the header bar: full-bleed, with the same edge padding. */
    max-width: none;
    margin: 0;
    padding: 2.5rem clamp(1.25rem, 3vw, 2.5rem) 2.75rem;
    display: grid;
    grid-template-columns: 3fr 1fr;
    gap: 3rem;
  }
  .mega-panel__cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
  }
  .mega-col__title {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-gold-600);
    margin: 0 0 1rem;
    padding-bottom: 0.625rem;
    border-bottom: 1px solid var(--color-line);
  }
  .mega-col__title a {
    color: inherit;
    text-decoration: none;
  }
  .mega-col__title a:hover { color: var(--color-gold-400); }
  .mega-col ul { list-style: none; padding: 0; margin: 0; }
  .mega-col li { margin: 0; }
  .mega-col li a {
    display: block;
    padding: 0.625rem 0;
    text-decoration: none;
    color: var(--color-ink);
    transition: transform 150ms, color 150ms;
  }
  .mega-col li a:hover {
    color: var(--color-gold-600);
    transform: translateX(3px);
  }
  .mega-col__label {
    display: block;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.2;
  }
  .mega-col__desc {
    display: block;
    color: var(--color-ink-mute);
    font-size: 0.8125rem;
    margin-top: 0.125rem;
  }

  /* Featured panel */
  .mega-feature {
    display: block;
    background: var(--color-cream);
    border-radius: 8px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 200ms, box-shadow 200ms;
  }
  .mega-feature:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 32px -16px rgba(199,154,8,0.25);
  }
  .mega-feature img {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    display: block;
  }
  .mega-feature__body { padding: 1rem 1.125rem 1.25rem; }
  .mega-feature__body .mega-feature__title {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 500;
    margin: 0 0 0.375rem;
    color: var(--color-ink);
  }
  .mega-feature__body p {
    color: var(--color-ink-soft);
    font-size: 0.8125rem;
    line-height: 1.5;
    margin: 0 0 0.75rem;
  }
  .mega-feature__cta {
    color: var(--color-gold-600);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  /* ─── Locations panel (full-width, thumbnail grid) ───────────── */
  .locations-panel {
    position: absolute;
    top: 100%;
    left: 0; right: 0;
    background: #fff;
    border-top: 1px solid rgba(207,207,207,0.6);
    box-shadow: 0 24px 64px -24px rgba(7,7,7,0.18);
    opacity: 0;
    pointer-events: none;
    transform: translateY(-8px);
    transition: opacity 200ms, transform 200ms;
    z-index: 10;
  }
  .nav-item.is-open .locations-panel,
  .nav-item:focus-within .locations-panel {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }
  .locations-panel__inner {
    /* Match the header bar: full-bleed, with the same edge padding. */
    max-width: none;
    margin: 0;
    padding: 2rem clamp(1.25rem, 3vw, 2.5rem) 2.5rem;
  }
  .locations-panel__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: 1.5rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-line);
  }
  .locations-panel__eyebrow {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gold-600);
    margin-bottom: 0.375rem;
  }
