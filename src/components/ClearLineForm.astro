---
// ClearLine Connect enquiry form embed (CLAUDE.md §5).
// THIS IS THE CONVERSION PATH — preserve the embed exactly as the live site uses it.
// Source: link.clearlineconnect.io  ·  Form: "Form for website by Ben Wall"
// Form ID: HLEAdfiqbR0txyg0BfKl
//
// Includes the same "Is the form not showing? Click here" fallback the live
// site uses, linking directly to the hosted ClearLine form.
const FORM_ID = 'HLEAdfiqbR0txyg0BfKl';
const FORM_URL = `https://link.clearlineconnect.io/widget/form/${FORM_ID}`;

interface Props {
  showIntro?: boolean;
}
const { showIntro = true } = Astro.props;
---
<div class="clearline-embed">
  {showIntro && (
    <p>Fill in the form below to get started.</p>
  )}
  <iframe
    src={FORM_URL}
    style="width:100%;height:100%;border:none;border-radius:0px"
    id={`inline-${FORM_ID}`}
    data-layout="{'id':'INLINE'}"
    data-trigger-type="alwaysShow"
    data-trigger-value=""
    data-activation-type="alwaysActivated"
    data-activation-value=""
    data-deactivation-type="neverDeactivate"
    data-deactivation-value=""
    data-form-name="Form for website by Ben Wall"
    data-height="516"
    data-layout-iframe-id={`inline-${FORM_ID}`}
    data-form-id={FORM_ID}
    title="Form for website by Ben Wall"
  ></iframe>
  <p class="clearline-fallback">
    Is the form not showing?{' '}
    <a href={FORM_URL} target="_blank" rel="noopener noreferrer nofollow">
      Click here
    </a>.
  </p>
</div>
<script src="https://link.clearlineconnect.io/js/form_embed.js"></script>
