---
// ClearLine Connect enquiry form embed (CLAUDE.md §5).
// THIS IS THE CONVERSION PATH — preserve the embed exactly as the live site uses it.
// Source: link.clearlineconnect.io  ·  Form: "Form for website by Ben Wall"
// Form ID: HLEAdfiqbR0txyg0BfKl
//
// Includes the same "Is the form not showing? Click here" fallback the live
// site uses, linking directly to the hosted ClearLine form.
const FORM_ID = 'HLEAdfiqbR0txyg0BfKl';
const FORM_URL = `https://link.clearlineconnect.io/widget/form/${FORM_ID}`;

interface Props {
  showIntro?: boolean;
}
const { showIntro = true } = Astro.props;
---
<div class="clearline-embed" data-clearline-form>
  {showIntro && (
    <p>Fill in the form below to get started.</p>
  )}
  <iframe
    data-src={FORM_URL}
    style="width:100%;height:100%;border:none;border-radius:0px"
    id={`inline-${FORM_ID}`}
    data-layout="{'id':'INLINE'}"
    data-trigger-type="alwaysShow"
    data-trigger-value=""
    data-activation-type="alwaysActivated"
    data-activation-value=""
    data-deactivation-type="neverDeactivate"
    data-deactivation-value=""
    data-form-name="Form for website by Ben Wall"
    data-height="516"
    data-layout-iframe-id={`inline-${FORM_ID}`}
    data-form-id={FORM_ID}
    title="Form for website by Ben Wall"
  ></iframe>
  <p class="clearline-fallback">
    Is the form not showing?{' '}
    <a href={FORM_URL} target="_blank" rel="noopener noreferrer nofollow">
      Click here
    </a>.
  </p>
</div>
<script is:inline>
  (() => {
    const SCRIPT_SRC = 'https://link.clearlineconnect.io/js/form_embed.js';

    function loadClearLine() {
      if (window.__seClearLineLoaded) return;
      window.__seClearLineLoaded = true;

      document.querySelectorAll('[data-clearline-form]').forEach((root) => {
        const iframe = root.querySelector('iframe[data-src]');
        if (iframe && !iframe.getAttribute('src')) {
          iframe.setAttribute('src', iframe.dataset.src);
        }
      });

      if (!document.querySelector(`script[src="${SCRIPT_SRC}"]`)) {
        const s = document.createElement('script');
        s.src = SCRIPT_SRC;
        document.head.appendChild(s);
      }
    }

    const roots = document.querySelectorAll('[data-clearline-form]');
    if (!roots.length) return;

    const start = () => {
      if ('requestIdleCallback' in window) {
        requestIdleCallback(loadClearLine, { timeout: 2500 });
      } else {
        setTimeout(loadClearLine, 1500);
      }
    };

    // If any form is already on screen (hero), still defer briefly for LCP.
    const visible = [...roots].some((el) => {
      const r = el.getBoundingClientRect();
      return r.top < window.innerHeight && r.bottom > 0;
    });

    if (visible) {
      start();
      return;
    }

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          loadClearLine();
          io.disconnect();
        }
      }, { rootMargin: '200px' });
      roots.forEach((el) => io.observe(el));
    } else {
      start();
    }
  })();
</script>
