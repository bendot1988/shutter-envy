---
import ClearLineForm from '../ClearLineForm.astro';

interface Props {
  backgroundImage?: string;
  eyebrow: string;
  heading: string;
  body?: string;
  location?: string;
  cta?: { label: string; href: string };
  awardImages?: string[];
}
const { backgroundImage, eyebrow, heading, body, location, cta, awardImages = [] } = Astro.props;
---
<section class="home-hero" style={backgroundImage ? `background-image: url('${backgroundImage}')` : undefined}>
  <div class="home-hero__overlay"></div>
  <div class="home-hero__grid container">
    <div class="home-hero__copy">
      {eyebrow && <p class="home-hero__eyebrow" set:html={eyebrow} />}
      <h1 class="home-hero__heading">{heading}</h1>
      {body && <p class="home-hero__body">{body}</p>}
      {location && (
        <p class="home-hero__location">
          <svg aria-hidden="true" width="14" height="16" viewBox="0 0 14 16" fill="none">
            <path d="M7 0C3.13 0 0 3.13 0 7c0 5.25 7 9 7 9s7-3.75 7-9c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5z" fill="currentColor"/>
          </svg>
          {location}
        </p>
      )}
      {cta && <a href={cta.href} class="home-hero__cta">{cta.label}</a>}
      {awardImages.length > 0 && (
        <div class="home-hero__awards">
          {awardImages.map((src) => (
            <img src={src} alt="IE 100 Awards Winner" loading="lazy" />
          ))}
        </div>
      )}
    </div>

    <div class="home-hero__form">
      <div class="home-hero__form-head">
        <p class="home-hero__form-eyebrow">★ Free home survey</p>
        <h2>Get your free quote in 60 seconds</h2>
        <p class="home-hero__form-sub">No obligation. We'll call you back to book a convenient time.</p>
      </div>
      <ClearLineForm showIntro={false} />
    </div>
  </div>
</section>

<style>
  .home-hero {
    position: relative;
    margin: 0 calc(50% - 50vw);
    padding: 4rem 1.25rem 5rem;
    background-color: var(--color-cream);
    background-size: cover;
    background-position: center;
  }
  .home-hero__overlay {
    position: absolute; inset: 0;
    background: rgba(249, 248, 244, 0.75);
  }
  .home-hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .home-hero__grid { grid-template-columns: 1.1fr 1fr; gap: 4rem; }
  }
  .home-hero__copy { text-align: center; }
  @media (min-width: 1024px) { .home-hero__copy { text-align: left; } }

  .home-hero__eyebrow {
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--color-ink-soft);
    margin: 0 0 1rem;
    letter-spacing: 0.01em;
  }
  .home-hero__eyebrow :global(strong) {
    color: var(--color-gold-600);
    font-weight: 600;
  }
  .home-hero__heading {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5.5vw, 4rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.015em;
    margin: 0 0 1.5rem;
    color: var(--color-ink);
  }
  .home-hero__body {
    font-size: 1.0625rem;
    color: var(--color-ink-soft);
    max-width: 36rem;
    margin: 0 0 1.5rem;
    line-height: 1.6;
  }
  @media (max-width: 1023px) {
    .home-hero__body { margin-left: auto; margin-right: auto; }
  }
  .home-hero__location {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    color: var(--color-gold-600);
    font-weight: 500;
    margin: 0 0 1.75rem;
  }
  .home-hero__cta {
    display: inline-block;
    padding: 0.875rem 2rem;
    background: var(--color-cream);
    color: var(--color-ink);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: all 200ms;
  }
  .home-hero__cta:hover {
    background: var(--color-gold-400);
    color: #fff;
    border-color: var(--color-gold-400);
  }

  .home-hero__awards {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2rem;
    justify-content: center;
  }
  @media (min-width: 1024px) { .home-hero__awards { justify-content: flex-start; } }
  .home-hero__awards img {
    height: 56px;
    width: auto;
    max-width: 100%;
  }

  .home-hero__form {
    background: rgba(255,255,255,0.98);
    border-radius: 12px;
    padding: 1.75rem 1.25rem 1.25rem;
    box-shadow: 0 24px 64px -24px rgba(7,7,7,0.18);
    border: 1px solid rgba(199,154,8,0.15);
  }
  .home-hero__form-head { text-align: center; margin-bottom: 1rem; }
  .home-hero__form-eyebrow {
    display: inline-block;
    background: rgba(199,154,8,0.12);
    color: var(--color-gold-600);
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    margin: 0 0 0.625rem;
  }
  .home-hero__form-head h2 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 500;
    margin: 0 0 0.375rem;
    line-height: 1.15;
  }
  .home-hero__form-sub {
    color: var(--color-ink-mute);
    font-size: 0.8125rem;
    margin: 0;
  }
  .home-hero__form :global(.clearline-embed) {
    background: transparent;
    padding: 0;
    border-radius: 0;
  }
  .home-hero__form :global(.clearline-embed iframe) {
    min-height: 560px;
  }
</style>
