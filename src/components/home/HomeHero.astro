---
import ClearLineForm from '../ClearLineForm.astro';
import HelpDropdown from './HelpDropdown.astro';

interface Badge { icon?: 'star' | 'award' | 'home' | 'check'; label: string }

interface Props {
  backgroundImage?: string;
  eyebrow: string;
  heading: string;
  body?: string;
  location?: string;
  cta?: { label: string; href: string };
  badges?: Badge[];
}
const { backgroundImage, eyebrow, heading, body, location, badges = [] } = Astro.props;
---
<section class="home-hero" style={backgroundImage ? `background-image: url('${backgroundImage}')` : undefined}>
  <div class="home-hero__overlay"></div>
  <div class="home-hero__grid container">
    <div class="home-hero__copy">
      {eyebrow && <p class="home-hero__eyebrow" set:html={eyebrow} />}
      <h1 class="home-hero__heading">{heading}</h1>
      {body && <p class="home-hero__body">{body}</p>}
      {location && (
        <p class="home-hero__location">
          <svg aria-hidden="true" width="14" height="16" viewBox="0 0 14 16" fill="none">
            <path d="M7 0C3.13 0 0 3.13 0 7c0 5.25 7 9 7 9s7-3.75 7-9c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5z" fill="currentColor"/>
          </svg>
          {location}
        </p>
      )}
      <div class="home-hero__help">
        <HelpDropdown />
      </div>

      {badges.length > 0 && (
        <ul class="home-hero__badges" aria-label="Why choose Shutter Envy">
          {badges.map((b, i) => (
            <li class="hero-badge" style={`--i: ${i};`}>
              <span class="hero-badge__icon" aria-hidden="true">
                {b.icon === 'star' && (
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                )}
                {b.icon === 'award' && (
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M19 4h-3V2H8v2H5c-1.1 0-2 .9-2 2v1c0 2.55 1.92 4.63 4.39 4.94.63 1.5 1.98 2.63 3.61 2.96V18H8v2h8v-2h-3v-3.1c1.63-.33 2.98-1.46 3.61-2.96C19.08 11.63 21 9.55 21 7V6c0-1.1-.9-2-2-2zM5 7V6h2v3.82C5.84 9.4 5 8.3 5 7zm14 0c0 1.3-.84 2.4-2 2.82V6h2v1z"/></svg>
                )}
                {b.icon === 'home' && (
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 3 2 12h3v8h6v-6h2v6h6v-8h3z"/></svg>
                )}
                {b.icon === 'check' && (
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="m9 16.17-4.17-4.17L3.41 13.41 9 19l12-12-1.41-1.41z"/></svg>
                )}
              </span>
              <span class="hero-badge__text" set:html={b.label} />
            </li>
          ))}
        </ul>
      )}
    </div>

    <div class="home-hero__form">
      <div class="home-hero__form-head">
        <p class="home-hero__form-eyebrow">★ Free home survey</p>
        <h2>Get Your Free Quote in 60 Seconds</h2>
        <p class="home-hero__form-sub">No obligation. We'll call you back to book a convenient time.</p>
      </div>
      <ClearLineForm showIntro={false} />
    </div>
  </div>
</section>

<style>
  .home-hero {
    position: relative;
    margin: 0 calc(50% - 50vw);
    padding: 4rem 1.25rem 5rem;
    background-color: var(--color-cream);
    background-size: cover;
    background-position: center;
  }
  .home-hero__overlay {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(249,248,244,0.85) 0%, rgba(249,248,244,0.7) 100%);
  }
  .home-hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .home-hero__grid { grid-template-columns: 0.85fr 1.15fr; gap: 3.5rem; }
  }
  .home-hero__copy { text-align: center; }
  @media (min-width: 1024px) { .home-hero__copy { text-align: left; } }

  .home-hero__eyebrow {
    font-family: var(--font-sans);
    font-size: var(--text-subheading-21-400);
    line-height: 1.6;
    color: var(--color-ink-soft);
    margin: 0 0 1rem;
    letter-spacing: 0.01em;
  }
  .home-hero__eyebrow :global(strong) { color: var(--color-gold-600); font-weight: 600; }

  .home-hero__heading {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, var(--text-h2-60-500));
    font-weight: 500;
    line-height: 1.075;
    letter-spacing: -0.027em;
    margin: 0 0 1.5rem;
    color: var(--color-ink);
  }
  .home-hero__body {
    font-size: var(--text-large-body-19-400);
    line-height: 1.6;
    color: var(--color-ink-soft);
    max-width: 36rem;
    margin: 0 0 1.5rem;
  }
  @media (max-width: 1023px) {
    .home-hero__body { margin-left: auto; margin-right: auto; }
  }
  .home-hero__location {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-small-body-15-400);
    color: var(--color-gold-600);
    font-weight: 500;
    margin: 0 0 1.75rem;
  }
  .home-hero__help {
    display: inline-block;
    /* Stacking context so the dropdown panel never gets covered */
    position: relative;
    z-index: 5;
  }
  @media (max-width: 1023px) {
    .home-hero__help { display: flex; justify-content: center; }
  }

  /* ─── Trust badges (lifted from the old TrustStrip) ───────── */
  .home-hero__badges {
    list-style: none;
    padding: 0;
    margin: 2.5rem 0 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    max-width: 32rem;
  }
  @media (max-width: 1023px) {
    .home-hero__badges { margin-inline: auto; }
  }
  @media (max-width: 480px) {
    .home-hero__badges { grid-template-columns: 1fr; }
  }

  .hero-badge {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    background: rgba(255,255,255,0.95);
    border: 1px solid rgba(199,154,8,0.15);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    text-align: left;
    margin: 0;
    transition: transform 220ms, box-shadow 220ms, border-color 220ms;

    /* Staggered intro */
    opacity: 0;
    transform: translateY(8px);
    animation: hero-badge-in 600ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(0.35s + var(--i, 0) * 0.1s);
  }
  .hero-badge:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-gold-400);
  }

  .hero-badge__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    background: rgba(199,154,8,0.12);
    color: var(--color-gold-600);
    border-radius: 50%;
    transition: background 220ms, transform 220ms;
  }
  .hero-badge:hover .hero-badge__icon {
    background: var(--color-gold-400);
    color: #fff;
    transform: scale(1.05);
  }

  .hero-badge__text {
    font-family: var(--font-sans);
    font-size: var(--text-small-body-15-400);
    line-height: 1.35;
    color: var(--color-ink);
    font-weight: 500;
  }
  .hero-badge__text :global(strong) {
    color: var(--color-gold-600);
    font-weight: 700;
  }

  @keyframes hero-badge-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Respect reduced motion preference */
  @media (prefers-reduced-motion: reduce) {
    .hero-badge {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }

  /* ─── Form ─────────────────────────────────────────────── */
  .home-hero__form {
    background: #fff;
    border-radius: var(--radius-lg);
    padding: 1.125rem 1.125rem 1rem;
    box-shadow: var(--shadow-xl);
    border: 1px solid rgba(199,154,8,0.12);

    /* Subtle intro for the form panel */
    animation: hero-form-in 700ms cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: 0.15s;
  }
  @keyframes hero-form-in {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .home-hero__form { animation: none; }
  }

  .home-hero__form-head { text-align: center; margin-bottom: 0.875rem; }
  .home-hero__form-eyebrow {
    display: inline-block;
    background: rgba(199,154,8,0.12);
    color: var(--color-gold-600);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-pill);
    font-size: var(--text-link-12-700);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0 0 0.625rem;
  }
  .home-hero__form-head h2 {
    font-family: var(--font-display);
    font-size: var(--text-h3-24-500);
    font-weight: 500;
    letter-spacing: -0.027em;
    margin: 0 0 0.375rem;
    line-height: 1.15;
  }
  .home-hero__form-sub {
    color: var(--color-ink-mute);
    font-size: var(--text-small-body-15-400);
    line-height: 1.5;
    margin: 0;
  }
  .home-hero__form :global(.clearline-embed) {
    background: transparent;
    padding: 0;
    border-radius: 0;
    box-shadow: none;
  }
  .home-hero__form :global(.clearline-embed iframe) {
    min-height: 480px;
    width: 100%;
  }
</style>
