---
interface Item { icon?: 'star' | 'award' | 'home' | 'check'; label: string }
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---
<section class="trust-strip">
  <div class="container">
    <ul>
      {items.map((it) => (
        <li>
          {it.icon === 'star' && (
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          )}
          {it.icon === 'award' && (
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M19 4h-3V2H8v2H5c-1.1 0-2 .9-2 2v1c0 2.55 1.92 4.63 4.39 4.94.63 1.5 1.98 2.63 3.61 2.96V18H8v2h8v-2h-3v-3.1c1.63-.33 2.98-1.46 3.61-2.96C19.08 11.63 21 9.55 21 7V6c0-1.1-.9-2-2-2zM5 7V6h2v3.82C5.84 9.4 5 8.3 5 7zm14 0c0 1.3-.84 2.4-2 2.82V6h2v1z"/></svg>
          )}
          {it.icon === 'home' && (
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12 3 2 12h3v8h6v-6h2v6h6v-8h3z"/></svg>
          )}
          {it.icon === 'check' && (
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="m9 16.17-4.17-4.17L3.41 13.41 9 19l12-12-1.41-1.41z"/></svg>
          )}
          <span set:html={it.label} />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .trust-strip {
    background: var(--color-cream);
    border-top: 1px solid rgba(199,154,8,0.15);
    border-bottom: 1px solid rgba(199,154,8,0.15);
    padding: 0.875rem 0;
    margin: 0 calc(50% - 50vw);
  }
  .trust-strip ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1rem 2rem;
  }
  .trust-strip li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-ink);
    /* button-14-500 */
    font-size: var(--text-button-14-500);
    line-height: 1.715;
    font-weight: 500;
    letter-spacing: 0.01em;
    margin: 0;
  }
  .trust-strip li svg { color: var(--color-gold-600); flex-shrink: 0; }
  .trust-strip li :global(strong) { color: var(--color-gold-600); }
</style>
