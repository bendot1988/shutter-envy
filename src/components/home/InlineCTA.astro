---
interface Props {
  eyebrow?: string;
  heading: string;
  body?: string;
  cta: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  tone?: 'cream' | 'gold' | 'dark';
}
const { eyebrow, heading, body, cta, secondaryCta, tone = 'cream' } = Astro.props;
---
<section class:list={['inline-cta', `inline-cta--${tone}`]}>
  <div class="container-narrow inline-cta__inner">
    {eyebrow && <p class="inline-cta__eyebrow">{eyebrow}</p>}
    <h2>{heading}</h2>
    {body && <p>{body}</p>}
    <div class="inline-cta__actions">
      <a href={cta.href} class="inline-cta__btn inline-cta__btn--primary">
        {cta.label}
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 7h8m0 0L7 3m4 4l-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      {secondaryCta && (
        <a href={secondaryCta.href} class="inline-cta__btn inline-cta__btn--secondary">{secondaryCta.label}</a>
      )}
    </div>
  </div>
</section>

<style>
  .inline-cta { margin: 4rem auto; padding: 0 1.25rem; }
  .inline-cta__inner {
    border-radius: 16px;
    padding: 3rem 1.5rem;
    text-align: center;
  }
  @media (min-width: 768px) { .inline-cta__inner { padding: 3.5rem 2rem; } }
  .inline-cta--cream .inline-cta__inner { background: var(--color-cream); }
  .inline-cta--gold .inline-cta__inner {
    background: linear-gradient(135deg, var(--color-gold-400), var(--color-gold-600));
    color: #fff;
  }
  .inline-cta--gold h2, .inline-cta--gold p { color: #fff; }
  .inline-cta--dark .inline-cta__inner { background: var(--color-ink); color: #fff; }
  .inline-cta--dark h2, .inline-cta--dark p { color: #fff; }

  .inline-cta__eyebrow {
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-gold-600);
    margin: 0 0 0.75rem;
    font-weight: 600;
  }
  .inline-cta--gold .inline-cta__eyebrow,
  .inline-cta--dark .inline-cta__eyebrow {
    color: var(--color-gold-400);
  }
  .inline-cta h2 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 400;
    margin: 0 0 0.75rem;
    line-height: 1.2;
  }
  .inline-cta p {
    color: var(--color-ink-soft);
    margin: 0 auto 1.5rem;
    max-width: 32rem;
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  .inline-cta--gold p { color: rgba(255,255,255,0.92); }
  .inline-cta__actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .inline-cta__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.875rem 1.75rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9375rem;
    transition: background 200ms, transform 200ms;
  }
  .inline-cta__btn--primary {
    background: var(--color-gold-400);
    color: #fff;
  }
  .inline-cta--gold .inline-cta__btn--primary { background: #fff; color: var(--color-gold-600); }
  .inline-cta__btn--primary:hover { background: var(--color-gold-600); color: #fff; transform: translateY(-1px); }
  .inline-cta__btn--secondary {
    background: transparent;
    color: var(--color-ink);
    border: 1px solid var(--color-line);
  }
  .inline-cta--gold .inline-cta__btn--secondary { color: #fff; border-color: rgba(255,255,255,0.6); }
  .inline-cta__btn--secondary:hover { background: rgba(199,154,8,0.08); color: var(--color-gold-600); border-color: var(--color-gold-400); }
</style>
