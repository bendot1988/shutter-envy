---
import { TRACK } from '../../data/tracking';
interface Props {
  eyebrow?: string;
  heading: string;
  body?: string;
  cta: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  tone?: 'cream' | 'gold' | 'dark';
  backgroundImage?: string;
}
const {
  eyebrow,
  heading,
  body,
  cta,
  secondaryCta,
  tone = 'cream',
  // Default behind-image for the gold tone — a real shutter install shot
  // that adds texture to what was otherwise a flat gold panel.
  backgroundImage = tone === 'gold'
    ? '/wp-content/uploads/2026/01/shutter-envy-full-height-shutters-vs-tier-on-tier-shutters-1-1024x853.webp'
    : undefined,
} = Astro.props;
---
<section
  class:list={['inline-cta', `inline-cta--${tone}`, backgroundImage && 'inline-cta--has-bg']}
  data-reveal
  style={backgroundImage ? `--bg-image: url('${backgroundImage}')` : undefined}
>
  <div class="inline-cta__inner">
    {eyebrow && <span class="inline-cta__eyebrow">{eyebrow}</span>}
    <h2>{heading}</h2>
    {body && <p class="inline-cta__body">{body}</p>}
    <div class="inline-cta__actions">
      <a href={cta.href} class="inline-cta__btn inline-cta__btn--primary" data-track={TRACK.inlineCta}>
        {cta.label}
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M3 7h8m0 0L7 3m4 4l-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      {secondaryCta && (
        <a href={secondaryCta.href} class="inline-cta__btn inline-cta__btn--secondary" data-track={TRACK.inlineCta}>{secondaryCta.label}</a>
      )}
    </div>
  </div>
</section>

<style>
  .inline-cta {
    position: relative;
    margin: 0 calc(50% - 50vw);
    padding: 0;
    isolation: isolate;
    overflow: hidden;
  }

  /* ─── Background image layer ──────────────────────────── */
  .inline-cta--has-bg::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: var(--bg-image);
    background-size: cover;
    background-position: center;
    z-index: -2;
  }

  /* ─── Tone-specific overlays ─────────────────────────── */
  .inline-cta--cream { background: var(--color-cream); }
  .inline-cta--cream.inline-cta--has-bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(249,248,244,0.88) 0%, rgba(249,248,244,0.94) 100%);
    z-index: -1;
  }

  .inline-cta--gold {
    background: linear-gradient(135deg, var(--color-gold-400), var(--color-gold-600));
  }
  /* Rich overlay that keeps the gold feel but lets the photo texture show through */
  .inline-cta--gold.inline-cta--has-bg::before {
    /* Slightly desaturate the photo so it doesn't fight the gold */
    filter: saturate(0.6) brightness(0.95);
  }
  .inline-cta--gold.inline-cta--has-bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 30% 20%, rgba(255,255,255,0.18), transparent 55%),
      linear-gradient(135deg, rgba(199,154,8,0.62) 0%, rgba(139,105,0,0.78) 100%);
    z-index: -1;
  }

  .inline-cta--dark { background: var(--color-ink); }
  .inline-cta--dark.inline-cta--has-bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(7,7,7,0.78) 0%, rgba(7,7,7,0.9) 100%);
    z-index: -1;
  }

  /* ─── Inner layout ────────────────────────────────────── */
  .inline-cta__inner {
    position: relative;
    max-width: 48rem;
    margin: 0 auto;
    padding: 3.5rem 1.25rem;
    text-align: center;
  }
  @media (min-width: 640px) { .inline-cta__inner { padding: 4.5rem 2rem; } }
  @media (min-width: 1024px) { .inline-cta__inner { padding: 5.5rem 2rem; } }

  /* ─── Eyebrow pill ────────────────────────────────────── */
  .inline-cta__eyebrow {
    display: inline-block;
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    background: rgba(199,154,8,0.12);
    color: var(--color-gold-600);
    font-size: 0.625rem;
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    margin: 0 0 1rem;
  }
  .inline-cta--gold .inline-cta__eyebrow {
    background: rgba(255,255,255,0.18);
    color: #fff;
    backdrop-filter: blur(4px);
    border: 1px solid rgba(255,255,255,0.25);
  }
  .inline-cta--dark .inline-cta__eyebrow {
    background: rgba(199,154,8,0.18);
    color: var(--color-gold-400);
  }

  /* ─── Headline & body ─────────────────────────────────── */
  .inline-cta h2 {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4.5vw, 2.625rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.027em;
    margin: 0 auto 1rem;
    color: var(--color-ink);
    max-width: 18ch; /* tightens line breaks — no "Survey" alone on a line */
    text-wrap: balance;
  }
  .inline-cta--gold h2,
  .inline-cta--dark h2 { color: #fff; }
  .inline-cta--gold h2 {
    text-shadow: 0 2px 18px rgba(0,0,0,0.18);
  }

  .inline-cta__body {
    color: var(--color-ink-soft);
    font-size: var(--text-body-16-400);
    line-height: 1.65;
    margin: 0 auto 2rem;
    max-width: 38ch;
    text-wrap: pretty; /* avoids 1-word last line */
  }
  @media (min-width: 768px) { .inline-cta__body { font-size: 1.0625rem; max-width: 44ch; } }
  .inline-cta--gold .inline-cta__body { color: rgba(255,255,255,0.95); }
  .inline-cta--dark .inline-cta__body { color: rgba(255,255,255,0.85); }

  /* ─── Actions ─────────────────────────────────────────── */
  .inline-cta__actions {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    align-items: stretch;
    max-width: 22rem;
    margin: 0 auto;
  }
  @media (min-width: 560px) {
    .inline-cta__actions {
      flex-direction: row;
      justify-content: center;
      align-items: center;
      gap: 0.75rem;
      max-width: none;
    }
  }

  .inline-cta__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.95rem 1.75rem;
    border-radius: 999px;
    text-decoration: none;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: var(--text-button-14-500);
    line-height: 1.4;
    letter-spacing: 0.02em;
    transition: background 200ms, color 200ms, transform 200ms, border-color 200ms, box-shadow 200ms;
    white-space: nowrap;
  }
  .inline-cta__btn svg { transition: transform 200ms; }
  .inline-cta__btn:hover svg { transform: translateX(3px); }

  /* Primary */
  .inline-cta__btn--primary {
    background: var(--color-gold-400);
    color: #fff;
    box-shadow: 0 10px 24px -10px rgba(199,154,8,0.55);
  }
  .inline-cta__btn--primary:hover {
    background: var(--color-gold-600);
    color: #fff;
    transform: translateY(-2px);
  }
  .inline-cta--gold .inline-cta__btn--primary {
    background: #fff;
    color: var(--color-gold-600);
    box-shadow: 0 12px 28px -12px rgba(0,0,0,0.35);
  }
  .inline-cta--gold .inline-cta__btn--primary:hover {
    background: var(--color-ink);
    color: #fff;
  }

  /* Secondary */
  .inline-cta__btn--secondary {
    background: transparent;
    color: var(--color-ink);
    border: 1px solid var(--color-line);
  }
  .inline-cta__btn--secondary:hover {
    background: rgba(199,154,8,0.08);
    color: var(--color-gold-600);
    border-color: var(--color-gold-400);
  }
  .inline-cta--gold .inline-cta__btn--secondary {
    color: #fff;
    border-color: rgba(255,255,255,0.55);
    background: rgba(255,255,255,0.06);
    backdrop-filter: blur(4px);
  }
  .inline-cta--gold .inline-cta__btn--secondary:hover {
    background: rgba(255,255,255,0.16);
    color: #fff;
    border-color: #fff;
  }
  .inline-cta--dark .inline-cta__btn--secondary {
    color: #fff;
    border-color: rgba(255,255,255,0.4);
  }
  .inline-cta--dark .inline-cta__btn--secondary:hover {
    background: rgba(255,255,255,0.08);
    color: #fff;
    border-color: #fff;
  }
</style>
