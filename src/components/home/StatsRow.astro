---
interface Stat {
  value: string;          // e.g. "600+" or "25" — we parse out the number and any prefix/suffix
  label: string;
  emoji?: string;         // optional emoji override; otherwise we infer from position
}
interface Props {
  items: Stat[];
}
const { items } = Astro.props;

// Parse "600+" → { prefix: "", number: 600, suffix: "+" }
function parseStat(value: string) {
  const match = value.match(/^([^\d.]*)(\d+(?:\.\d+)?)(.*)$/);
  if (!match) return { prefix: '', number: 0, suffix: value };
  return {
    prefix: match[1],
    number: parseFloat(match[2]),
    suffix: match[3],
  };
}

// Default emojis if none are provided in content — match the live brand vibe
const defaultEmojis = ['👥', '⭐', '📅', '🏆', '💛', '🛠️'];
---
{items.length > 0 && (
  <section class="stats-row container">
    <ul>
      {items.map((s, i) => {
        const parsed = parseStat(s.value);
        const emoji = s.emoji ?? defaultEmojis[i % defaultEmojis.length];
        return (
          <li class="stats-row__card" style={`--i: ${i};`}>
            <div class="stats-row__emoji" aria-hidden="true">{emoji}</div>
            <p
              class="stats-row__value"
              data-count-target={parsed.number}
              data-count-prefix={parsed.prefix}
              data-count-suffix={parsed.suffix}
            >{parsed.prefix}0{parsed.suffix}</p>
            <p class="stats-row__label">{s.label}</p>
          </li>
        );
      })}
    </ul>
  </section>
)}

<script>
  // Count-up on scroll-into-view. Uses IntersectionObserver + rAF.
  // Each value element has data-count-target plus optional prefix/suffix.
  const els = document.querySelectorAll<HTMLElement>('.stats-row__value[data-count-target]');
  if (els.length) {
    const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);

    const animate = (el: HTMLElement) => {
      const target = parseFloat(el.dataset.countTarget ?? '0');
      const prefix = el.dataset.countPrefix ?? '';
      const suffix = el.dataset.countSuffix ?? '';
      const duration = 1400;
      const isFloat = target % 1 !== 0;
      const start = performance.now();

      const tick = (now: number) => {
        const t = Math.min(1, (now - start) / duration);
        const value = easeOut(t) * target;
        el.textContent = `${prefix}${isFloat ? value.toFixed(1) : Math.round(value)}${suffix}`;
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };

    if (
      'IntersectionObserver' in window &&
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches
    ) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animate(entry.target as HTMLElement);
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.5 });
      els.forEach((el) => io.observe(el));
    } else {
      // Reduced motion / no IO support: just write the final value
      els.forEach((el) => {
        const target = parseFloat(el.dataset.countTarget ?? '0');
        const prefix = el.dataset.countPrefix ?? '';
        const suffix = el.dataset.countSuffix ?? '';
        const isFloat = target % 1 !== 0;
        el.textContent = `${prefix}${isFloat ? target.toFixed(1) : target}${suffix}`;
      });
    }
  }
</script>

<style>
  .stats-row {
    margin: 0 auto;
    padding: 4rem 1.25rem;
    background: #fff;
  }
  .stats-row ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 768px) {
    .stats-row ul { grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  }

  /* ─── Gold inverted cards ──────────────────────────────────── */
  .stats-row__card {
    position: relative;
    background: linear-gradient(135deg, var(--color-gold-400) 0%, var(--color-gold-600) 100%);
    color: #fff;
    border-radius: var(--radius-lg);
    padding: 2.5rem 1.5rem;
    text-align: center;
    box-shadow: var(--shadow-md);
    margin: 0;
    overflow: hidden;
    transition: transform 250ms cubic-bezier(0.16,1,0.3,1),
                box-shadow 250ms cubic-bezier(0.16,1,0.3,1);

    /* Subtle staggered fade-up on intro */
    opacity: 0;
    transform: translateY(12px);
    animation: stat-card-in 700ms cubic-bezier(0.16,1,0.3,1) forwards;
    animation-delay: calc(var(--i, 0) * 0.12s);
  }
  @keyframes stat-card-in {
    to { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .stats-row__card { animation: none; opacity: 1; transform: none; }
  }

  /* Soft inner highlight to give the gold some life */
  .stats-row__card::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 30% 0%, rgba(255,255,255,0.18), transparent 50%),
      radial-gradient(circle at 80% 100%, rgba(0,0,0,0.12), transparent 50%);
    pointer-events: none;
  }
  .stats-row__card > * { position: relative; }

  .stats-row__card:hover {
    transform: translateY(-4px);
    box-shadow:
      var(--shadow-lg),
      0 24px 48px -24px rgba(199,154,8,0.55);
  }

  .stats-row__emoji {
    font-size: 2.25rem;
    line-height: 1;
    margin-bottom: 0.75rem;
    /* keep emoji sharp on dark backgrounds */
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.15));
  }

  .stats-row__value {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5.5vw, var(--text-h2-60-500));
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.027em;
    color: #fff;
    margin: 0;
    /* Reserve space so the layout doesn't jump as the number counts */
    font-variant-numeric: tabular-nums;
    text-shadow: 0 2px 8px rgba(0,0,0,0.12);
  }
  .stats-row__label {
    font-family: var(--font-sans);
    font-size: var(--text-small-body-15-400);
    line-height: 1.4;
    color: rgba(255,255,255,0.92);
    margin: 0.625rem 0 0;
    font-weight: 500;
    letter-spacing: 0.01em;
  }
</style>
