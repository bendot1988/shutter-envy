---
interface Stat {
  value: string;
  label: string;
  image?: string;
}
interface Props {
  items: Stat[];
}
const { items } = Astro.props;

function parseStat(value: string) {
  const match = value.match(/^([^\d.]*)(\d+(?:\.\d+)?)(.*)$/);
  if (!match) return { prefix: '', number: 0, suffix: value };
  return {
    prefix: match[1],
    number: parseFloat(match[2]),
    suffix: match[3],
  };
}

const defaultImages = [
  '/wp-content/uploads/2026/05/01-shutter-envy.jpeg',
  '/wp-content/uploads/2026/04/Bay-window-shutters-in-Loughborough.jpeg',
  '/wp-content/uploads/2024/10/dotwall-Web-Design2024-10-07-at-14.05.55.jpeg',
];
---
{items.length > 0 && (
  <section class="stats-row container" aria-label="Company highlights">
    <ul>
      {items.map((s, i) => {
        const parsed = parseStat(s.value);
        const bg = s.image ?? defaultImages[i % defaultImages.length];
        return (
          <li
            class="stats-row__card"
            style={`--i: ${i}; --stat-bg: url("${bg}");`}
          >
            <div class="stats-row__overlay" aria-hidden="true"></div>
            <div class="stats-row__content">
              <p
                class="stats-row__value"
                data-count-target={parsed.number}
                data-count-prefix={parsed.prefix}
                data-count-suffix={parsed.suffix}
              >{parsed.prefix}0{parsed.suffix}</p>
              <p class="stats-row__label">{s.label}</p>
            </div>
          </li>
        );
      })}
    </ul>
  </section>
)}

<script>
  const els = document.querySelectorAll<HTMLElement>('.stats-row__value[data-count-target]');
  if (els.length) {
    const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);

    const animate = (el: HTMLElement) => {
      const target = parseFloat(el.dataset.countTarget ?? '0');
      const prefix = el.dataset.countPrefix ?? '';
      const suffix = el.dataset.countSuffix ?? '';
      const duration = 1400;
      const isFloat = target % 1 !== 0;
      const start = performance.now();

      const tick = (now: number) => {
        const t = Math.min(1, (now - start) / duration);
        const value = easeOut(t) * target;
        el.textContent = `${prefix}${isFloat ? value.toFixed(1) : Math.round(value)}${suffix}`;
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };

    if (
      'IntersectionObserver' in window &&
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches
    ) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animate(entry.target as HTMLElement);
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.4 });
      els.forEach((el) => io.observe(el));
    } else {
      els.forEach((el) => {
        const target = parseFloat(el.dataset.countTarget ?? '0');
        const prefix = el.dataset.countPrefix ?? '';
        const suffix = el.dataset.countSuffix ?? '';
        const isFloat = target % 1 !== 0;
        el.textContent = `${prefix}${isFloat ? target.toFixed(1) : target}${suffix}`;
      });
    }
  }
</script>

<style>
  .stats-row {
    margin: 0 auto;
    padding: 4rem 1.25rem;
    background: #fff;
  }
  .stats-row ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 768px) {
    .stats-row ul { grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  }

  .stats-row__card {
    position: relative;
    min-height: 220px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    background-color: var(--color-charcoal-900);
    background-image: var(--stat-bg);
    background-size: cover;
    background-position: center;
    transition:
      transform 400ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 400ms cubic-bezier(0.16, 1, 0.3, 1);

    opacity: 0;
    transform: translateY(16px);
    animation: stat-card-in 700ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(var(--i, 0) * 0.1s);
  }
  @keyframes stat-card-in {
    to { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .stats-row__card { animation: none; opacity: 1; transform: none; }
  }

  .stats-row__card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-lg), 0 28px 56px -28px rgba(0, 0, 0, 0.35);
  }
  @media (prefers-reduced-motion: reduce) {
    .stats-row__card:hover { transform: none; }
  }

  .stats-row__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(20, 18, 16, 0.45) 0%,
      rgba(20, 18, 16, 0.72) 100%
    );
    transition: background 400ms ease;
    pointer-events: none;
  }
  .stats-row__card:hover .stats-row__overlay {
    background: linear-gradient(
      180deg,
      rgba(20, 18, 16, 0.38) 0%,
      rgba(20, 18, 16, 0.65) 100%
    );
  }

  .stats-row__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 220px;
    padding: 2.5rem 1.5rem;
    text-align: center;
  }

  .stats-row__value {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5.5vw, var(--text-h2-60-500));
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.027em;
    color: #fff;
    margin: 0;
    font-variant-numeric: tabular-nums;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.35);
  }
  .stats-row__label {
    font-family: var(--font-sans);
    font-size: var(--text-small-body-15-400);
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.92);
    margin: 0.625rem 0 0;
    font-weight: 500;
    letter-spacing: 0.01em;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.3);
  }
</style>
