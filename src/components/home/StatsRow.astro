---
interface Props {
  items: { value: string; label: string }[];
}
const { items } = Astro.props;
const icons = ['users', 'star', 'calendar'] as const;
---
{items.length > 0 && (
  <section class="stats-row container">
    <ul>
      {items.map((s, i) => (
        <li>
          <div class="stats-row__icon" aria-hidden="true">
            {icons[i % icons.length] === 'users' && (
              <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
            )}
            {icons[i % icons.length] === 'star' && (
              <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            )}
            {icons[i % icons.length] === 'calendar' && (
              <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor"><path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20a2 2 0 0 0 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10zM9 14H7v-2h2v2zm4 0h-2v-2h2v2zm4 0h-2v-2h2v2zm-8 4H7v-2h2v2zm4 0h-2v-2h2v2zm4 0h-2v-2h2v2z"/></svg>
            )}
          </div>
          <p class="stats-row__value">{s.value}</p>
          <p class="stats-row__label">{s.label}</p>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .stats-row {
    margin: 4rem auto;
  }
  .stats-row ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 768px) {
    .stats-row ul { grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  }
  .stats-row li {
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 12px;
    padding: 2rem 1.5rem;
    text-align: center;
    box-shadow: 0 1px 0 rgba(7,7,7,0.02);
    transition: transform 200ms, box-shadow 200ms, border-color 200ms;
    margin: 0;
  }
  .stats-row li:hover {
    transform: translateY(-2px);
    border-color: var(--color-gold-400);
    box-shadow: 0 12px 32px -16px rgba(199,154,8,0.25);
  }
  .stats-row__icon {
    color: var(--color-gold-400);
    margin-bottom: 0.75rem;
    display: flex;
    justify-content: center;
  }
  .stats-row__value {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 500;
    color: var(--color-ink);
    margin: 0;
    line-height: 1;
  }
  .stats-row__label {
    font-size: 0.9375rem;
    color: var(--color-ink-mute);
    margin: 0.5rem 0 0;
    line-height: 1.3;
  }
</style>
