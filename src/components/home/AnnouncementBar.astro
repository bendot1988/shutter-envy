---
interface Props {
  message: string;
}
const { message } = Astro.props;
---
<div class="announcement-bar">
  <p>{message}</p>
</div>

<style>
  .announcement-bar {
    background: var(--color-gold-400);
    color: var(--color-ink);
    text-align: center;
    padding: 0.625rem 1rem;
    font-family: var(--font-sans);
    /* button-14-500 */
    font-size: var(--text-button-14-500);
    line-height: 1.715;
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  .announcement-bar p { margin: 0; }
</style>
