---
interface Props {
  backgroundImage?: string;
  iconImage?: string;
  eyebrow?: string;
  heading: string;
  body?: string;
  awardImages?: string[];
  awardsCaption?: string;
  ctaNote?: string;
  cta: { label: string; href: string };
}
const {
  backgroundImage,
  iconImage,
  eyebrow,
  heading,
  body,
  awardImages = [],
  awardsCaption,
  ctaNote,
  cta,
} = Astro.props;
---
<section class="awards-cta">
  <div class="awards-cta__icon">
    {iconImage ? (
      <img src={iconImage} alt="" />
    ) : (
      <svg viewBox="0 0 40 40" fill="none" aria-hidden="true">
        <rect x="6" y="6" width="28" height="28" rx="2" stroke="currentColor" stroke-width="1.5"/>
        <path d="M20 6 Q20 12 14 12 M20 6 Q20 12 26 12" stroke="currentColor" stroke-width="1.5" fill="none"/>
        <line x1="14" y1="16" x2="26" y2="16" stroke="currentColor" stroke-width="1"/>
        <line x1="14" y1="20" x2="26" y2="20" stroke="currentColor" stroke-width="1"/>
        <line x1="14" y1="24" x2="26" y2="24" stroke="currentColor" stroke-width="1"/>
        <line x1="14" y1="28" x2="26" y2="28" stroke="currentColor" stroke-width="1"/>
      </svg>
    )}
  </div>

  <div class="awards-cta__box" style={backgroundImage ? `background-image: url('${backgroundImage}')` : undefined}>
    <div class="awards-cta__overlay"></div>
    <div class="awards-cta__inner">
      {eyebrow && <span class="awards-cta__eyebrow">★ {eyebrow}</span>}
      <h2>{heading}</h2>
      {body && <p>{body}</p>}
      {awardImages.length > 0 && (
        <div class="awards-cta__badges">
          {awardImages.map((src) => <img src={src} alt="Award winner" loading="lazy" />)}
          {awardsCaption && <p class="awards-cta__caption">{awardsCaption}</p>}
        </div>
      )}
      {ctaNote && <p class="awards-cta__note">{ctaNote}</p>}
      <a href={cta.href} class="button-pill">{cta.label} <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .awards-cta {
    position: relative;
    margin: 6rem auto 4rem;
    max-width: 70rem;
    padding: 0 1.25rem;
  }
  .awards-cta__icon {
    position: absolute;
    top: -2.25rem;
    left: 50%;
    transform: translateX(-50%);
    width: 4.5rem;
    height: 4.5rem;
    background: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 24px -8px rgba(7,7,7,0.18);
    color: var(--color-gold-600);
    z-index: 2;
  }
  .awards-cta__icon img, .awards-cta__icon svg { width: 2.25rem; height: 2.25rem; }

  .awards-cta__box {
    position: relative;
    background-color: #3a2e0c;
    background-size: cover;
    background-position: center;
    border-radius: 16px;
    overflow: hidden;
    padding: 4.5rem 1.5rem 3.5rem;
    text-align: center;
    color: #fff;
  }
  .awards-cta__overlay {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(58,46,12,0.72) 0%, rgba(58,46,12,0.82) 100%);
  }
  .awards-cta__inner { position: relative; max-width: 36rem; margin: 0 auto; }
  .awards-cta__eyebrow {
    display: inline-block;
    background: rgba(199,154,8,0.25);
    color: var(--color-gold-400);
    border: 1px solid rgba(199,154,8,0.5);
    border-radius: 999px;
    padding: 0.375rem 0.875rem;
    font-size: 0.8125rem;
    font-weight: 500;
    margin-bottom: 1.25rem;
  }
  .awards-cta__box h2 {
    font-family: var(--font-display);
    color: #fff;
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 400;
    margin: 0 0 1rem;
  }
  .awards-cta__box p {
    color: rgba(255,255,255,0.85);
    font-size: 1rem;
    line-height: 1.6;
    margin: 0 0 1.5rem;
  }
  .awards-cta__badges {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    margin: 1.5rem 0;
  }
  .awards-cta__badges img {
    max-width: 200px;
    width: 100%;
    height: auto;
  }
  .awards-cta__caption {
    font-family: var(--font-display);
    color: var(--color-gold-400);
    font-style: italic;
    margin-top: 0.5rem;
  }
  .awards-cta__note {
    margin: 1rem 0 1.25rem;
    color: rgba(255,255,255,0.85);
  }
  .button-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-gold-400);
    color: #fff;
    padding: 0.875rem 2rem;
    border-radius: 999px;
    font-weight: 500;
    text-decoration: none;
    transition: background 200ms;
  }
  .button-pill:hover { background: var(--color-gold-600); color: #fff; }
</style>
