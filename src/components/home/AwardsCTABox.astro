---
import { business } from '../../data/site';

interface Props {
  backgroundImage?: string;
  iconImage?: string;
  eyebrow?: string;
  heading: string;
  body?: string;
  awardImages?: string[];
  awardsCaption?: string;
  ctaNote?: string;
  cta: { label: string; href: string };
  rating?: string;
  reviewsCount?: string;
}
const {
  backgroundImage,
  eyebrow,
  heading,
  body,
  awardImages = [],
  awardsCaption = 'Blind & Shutter Specialists of the Year',
  ctaNote,
  cta,
  rating = '5.0',
  reviewsCount = '25+',
} = Astro.props;

// Split heading on its last word so we can italic-gold it
const words = heading.trim().split(/\s+/);
const last = words.pop() ?? '';
const lead = words.join(' ');

const awardYears = ['2023', '2024', '2025'];
---
<section class="awards-cta">
  <div
    class="awards-cta__box"
    style={backgroundImage ? `background-image: url('${backgroundImage}')` : undefined}
    data-reveal="scale"
  >
    {/* Layered atmospheric overlay (depth + gold light bleed) */}
    <div class="awards-cta__overlay awards-cta__overlay--base"></div>
    <div class="awards-cta__overlay awards-cta__overlay--vignette"></div>
    <div class="awards-cta__overlay awards-cta__overlay--glow"></div>

    {/* Decorative corner flourishes */}
    <span class="awards-cta__corner awards-cta__corner--tl" aria-hidden="true"></span>
    <span class="awards-cta__corner awards-cta__corner--tr" aria-hidden="true"></span>
    <span class="awards-cta__corner awards-cta__corner--bl" aria-hidden="true"></span>
    <span class="awards-cta__corner awards-cta__corner--br" aria-hidden="true"></span>

    <div class="awards-cta__inner">
      {/* Rating row — actual gold stars + supporting line */}
      <div class="awards-cta__rating">
        <span class="awards-cta__stars" aria-label={`${rating} out of 5 stars`}>
          {Array.from({ length: 5 }).map((_, i) => (
            <svg style={`--i: ${i};`} viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
              <path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
            </svg>
          ))}
        </span>
        <span class="awards-cta__rating-meta">
          Rated <strong>{rating}</strong> · Based on <strong>{reviewsCount}</strong> Google reviews
        </span>
      </div>

      {/* Heading with italic gold accent on last word */}
      <h2>
        {lead && <>{lead}{' '}</>}
        <em>{last}</em>
      </h2>

      {body && <p class="awards-cta__body">{body}</p>}

      {/* Awards row — horizontal, glass-morphism cards */}
      {awardImages.length > 0 && (
        <div class="awards-cta__awards">
          <ul class="awards-cta__badges">
            {awardImages.map((src, i) => (
              <li class="awards-cta__badge" style={`--i: ${i};`}>
                <div class="awards-cta__badge-frame">
                  <img src={src} alt={`IE 100 Awards Winner ${awardYears[i] ?? ''}`} loading="lazy" />
                </div>
              </li>
            ))}
          </ul>
          <p class="awards-cta__caption">
            <span class="awards-cta__caption-rule" aria-hidden="true"></span>
            <span>{awardsCaption}</span>
            <span class="awards-cta__caption-rule" aria-hidden="true"></span>
          </p>
        </div>
      )}

      {ctaNote && <p class="awards-cta__note">{ctaNote}</p>}

      <div class="awards-cta__actions">
        <a href={cta.href} class="awards-cta__btn">
          {cta.label}
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M3 7h8m0 0L7 3m4 4l-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href={`tel:${business.phoneTel}`} class="awards-cta__phone">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true">
            <path d="M20 15.5c-1.25 0-2.45-.2-3.57-.57a1 1 0 0 0-1.02.24l-2.2 2.2a15.05 15.05 0 0 1-6.59-6.59l2.2-2.2a1 1 0 0 0 .25-1.01A11.36 11.36 0 0 1 8.5 4a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1c0 9.39 7.61 17 17 17a1 1 0 0 0 1-1v-3.5a1 1 0 0 0-1-1z"/>
          </svg>
          or call {business.phoneDisplay}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .awards-cta {
    position: relative;
    margin: 0 auto;
    max-width: 80rem;
    padding: 5rem 1.25rem 5rem;
    background: #fff;
  }

  /* ─── The box ─────────────────────────────────────────────── */
  .awards-cta__box {
    position: relative;
    background-color: #1f1a0a;
    background-size: cover;
    background-position: center;
    border-radius: var(--radius-xl);
    overflow: hidden;
    padding: 5rem 1.5rem 4.5rem;
    text-align: center;
    color: #fff;
    box-shadow:
      0 32px 80px -24px rgba(0,0,0,0.5),
      0 0 0 1px rgba(199,154,8,0.12);
  }
  @media (min-width: 768px) {
    .awards-cta__box { padding: 6rem 3rem 5rem; }
  }

  /* Layered atmospheric overlay */
  .awards-cta__overlay { position: absolute; inset: 0; pointer-events: none; }
  .awards-cta__overlay--base {
    background:
      linear-gradient(180deg,
        rgba(15,12,5,0.55) 0%,
        rgba(15,12,5,0.78) 60%,
        rgba(15,12,5,0.88) 100%);
  }
  .awards-cta__overlay--vignette {
    background: radial-gradient(ellipse at center, transparent 30%, rgba(0,0,0,0.55) 100%);
  }
  .awards-cta__overlay--glow {
    background:
      radial-gradient(circle at 18% 22%, rgba(199,154,8,0.16), transparent 35%),
      radial-gradient(circle at 82% 78%, rgba(199,154,8,0.12), transparent 40%);
    mix-blend-mode: screen;
  }

  /* Corner flourishes — thin gold lines forming an L in each corner */
  .awards-cta__corner {
    position: absolute;
    width: 32px;
    height: 32px;
    border: 1px solid rgba(199,154,8,0.65);
    pointer-events: none;
  }
  .awards-cta__corner--tl { top: 1.25rem; left: 1.25rem; border-right: 0; border-bottom: 0; border-top-left-radius: 8px; }
  .awards-cta__corner--tr { top: 1.25rem; right: 1.25rem; border-left: 0; border-bottom: 0; border-top-right-radius: 8px; }
  .awards-cta__corner--bl { bottom: 1.25rem; left: 1.25rem; border-right: 0; border-top: 0; border-bottom-left-radius: 8px; }
  .awards-cta__corner--br { bottom: 1.25rem; right: 1.25rem; border-left: 0; border-top: 0; border-bottom-right-radius: 8px; }

  .awards-cta__inner {
    position: relative;
    max-width: 44rem;
    margin: 0 auto;
    z-index: 2;
  }

  /* ─── Rating row ──────────────────────────────────────────── */
  .awards-cta__rating {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  .awards-cta__stars {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--color-gold-400);
    filter: drop-shadow(0 0 12px rgba(199,154,8,0.45));
  }
  .awards-cta__stars svg {
    animation: star-pop 600ms cubic-bezier(0.16,1,0.3,1) both;
    animation-delay: calc(0.1s + var(--i, 0) * 0.08s);
    transform-origin: center;
  }
  @keyframes star-pop {
    from { opacity: 0; transform: scale(0.5) rotate(-12deg); }
    to   { opacity: 1; transform: scale(1) rotate(0); }
  }
  .awards-cta__rating-meta {
    font-size: var(--text-link-12-700);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    color: rgba(255,255,255,0.7);
  }
  .awards-cta__rating-meta strong { color: var(--color-gold-400); font-weight: 700; }

  /* ─── Heading ─────────────────────────────────────────────── */
  .awards-cta__box h2 {
    font-family: var(--font-display);
    color: #fff;
    font-size: clamp(2rem, 4.5vw, 3.75rem);
    font-weight: 500;
    line-height: 1.075;
    letter-spacing: -0.027em;
    margin: 0 0 1.25rem;
    text-wrap: balance;
    text-shadow: 0 4px 24px rgba(0,0,0,0.3);
  }
  .awards-cta__box h2 em {
    color: var(--color-gold-400);
    font-style: italic;
    font-weight: 500;
    background: linear-gradient(180deg, var(--color-gold-400), var(--color-gold-600));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 0 18px rgba(199,154,8,0.4));
  }

  .awards-cta__body {
    color: rgba(255,255,255,0.82);
    font-size: var(--text-large-body-19-400);
    line-height: 1.6;
    margin: 0 auto 2rem;
    max-width: 36rem;
    text-wrap: pretty;
  }

  /* ─── Awards row (horizontal) ─────────────────────────────── */
  .awards-cta__awards { margin: 2rem 0 1.5rem; }
  .awards-cta__badges {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }
  .awards-cta__badge {
    margin: 0;
    animation: badge-in 700ms cubic-bezier(0.16,1,0.3,1) both;
    animation-delay: calc(0.3s + var(--i, 0) * 0.12s);
  }
  @keyframes badge-in {
    from { opacity: 0; transform: translateY(10px) scale(0.94); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }
  .awards-cta__badge-frame {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(199,154,8,0.35);
    border-radius: var(--radius-md);
    padding: 0.625rem 0.875rem;
    backdrop-filter: blur(8px);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.1),
      0 8px 24px -8px rgba(0,0,0,0.4);
    transition: transform 280ms cubic-bezier(0.16,1,0.3,1),
                border-color 280ms, box-shadow 280ms, background 280ms;
  }
  .awards-cta__badge:hover .awards-cta__badge-frame {
    transform: translateY(-4px);
    border-color: var(--color-gold-400);
    background: rgba(199,154,8,0.12);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.15),
      0 16px 40px -12px rgba(199,154,8,0.5);
  }
  .awards-cta__badge-frame img {
    display: block;
    height: 36px;
    width: auto;
    max-width: 100%;
  }

  /* Caption with decorative rules */
  .awards-cta__caption {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.875rem;
    margin: 1.25rem 0 0;
    font-family: var(--font-display);
    color: var(--color-gold-400);
    font-style: italic;
    font-size: var(--text-h5-20-500);
    line-height: 1.2;
    letter-spacing: -0.015em;
    text-shadow: 0 0 16px rgba(199,154,8,0.3);
  }
  .awards-cta__caption-rule {
    flex: 1;
    max-width: 56px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(199,154,8,0.55), transparent);
  }

  .awards-cta__note {
    margin: 1.5rem 0 1.5rem;
    color: rgba(255,255,255,0.75);
    font-size: var(--text-small-body-15-400);
  }

  /* ─── Actions ─────────────────────────────────────────────── */
  .awards-cta__actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin-top: 0.5rem;
  }
  .awards-cta__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1.05rem 2.25rem;
    background: linear-gradient(180deg, var(--color-gold-400) 0%, var(--color-gold-600) 100%);
    color: #fff;
    border-radius: var(--radius-pill);
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.9375rem;
    letter-spacing: 0.02em;
    text-decoration: none;
    box-shadow:
      0 12px 32px -8px rgba(199,154,8,0.55),
      inset 0 1px 0 rgba(255,255,255,0.2);
    transition: transform 220ms cubic-bezier(0.16,1,0.3,1),
                box-shadow 220ms,
                filter 220ms;
  }
  .awards-cta__btn:hover {
    transform: translateY(-2px);
    filter: brightness(1.08);
    color: #fff;
    box-shadow:
      0 20px 48px -8px rgba(199,154,8,0.7),
      inset 0 1px 0 rgba(255,255,255,0.25);
  }
  .awards-cta__btn svg { transition: transform 220ms cubic-bezier(0.16,1,0.3,1); }
  .awards-cta__btn:hover svg { transform: translateX(3px); }

  .awards-cta__phone {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: rgba(255,255,255,0.7);
    text-decoration: none;
    font-size: var(--text-small-body-15-400);
    font-weight: 500;
    transition: color 200ms;
  }
  .awards-cta__phone:hover { color: var(--color-gold-400); }
  .awards-cta__phone svg { color: var(--color-gold-400); }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .awards-cta__stars svg,
    .awards-cta__badge,
    .awards-cta__badge-frame,
    .awards-cta__btn svg { animation: none; transition: none; }
  }
</style>
