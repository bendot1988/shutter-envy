---
interface Props {
  images: string[];
  caption?: string;
}
const { images, caption = 'Blind & Shutter Specialists of the Year' } = Astro.props;

const altFor = (src: string) => {
  if (src.includes('e2-award-of-excellence-2027')) {
    return 'E2 Award of Excellence Official Winner 2027';
  }
  const year = src.match(/(\d{4})\.png$/)?.[1];
  return year ? `IE 100 Awards Winner ${year}` : 'Award winner badge';
};
---
{images.length > 0 && (
  <section class="awards-band" data-reveal>
    <div class="container">
      <ul data-reveal-children>
        {images.map((src) => (
          <li class:list={{ 'awards-band__item--seal': src.includes('e2-award') }}>
            <img src={src} alt={altFor(src)} loading="lazy" width="160" height="160" />
          </li>
        ))}
      </ul>
      {caption && <p>{caption}</p>}
    </div>
  </section>
)}

<style>
  .awards-band {
    padding: 2.25rem 1.25rem 2.75rem;
    background: #fff;
    text-align: center;
  }
  .awards-band ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1rem 1.35rem;
  }
  .awards-band li { margin: 0; }
  .awards-band img {
    display: block;
    height: clamp(5.75rem, 15vw, 9.25rem);
    width: auto;
    max-width: min(28vw, 9.25rem);
    object-fit: contain;
    opacity: 0.95;
    transition: opacity 200ms, transform 200ms;
  }
  .awards-band__item--seal img {
    height: clamp(6.25rem, 16vw, 10rem);
    max-width: min(30vw, 10rem);
  }
  .awards-band img:hover { opacity: 1; transform: translateY(-2px); }
  .awards-band p {
    font-family: var(--font-display);
    color: var(--color-gold-600);
    font-style: italic;
    font-size: var(--text-h5-20-500);
    margin: 1.25rem 0 0;
    letter-spacing: -0.015em;
  }

  @media (max-width: 479px) {
    .awards-band ul {
      gap: 0.75rem 0.9rem;
      max-width: 22rem;
      margin-inline: auto;
    }
    .awards-band img {
      height: clamp(4.75rem, 22vw, 6.5rem);
      max-width: min(40vw, 6.5rem);
    }
    .awards-band__item--seal img {
      height: clamp(5.25rem, 24vw, 7rem);
      max-width: min(42vw, 7rem);
    }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .awards-band ul {
      gap: 1.1rem 1.5rem;
      max-width: 42rem;
      margin-inline: auto;
    }
  }
</style>
