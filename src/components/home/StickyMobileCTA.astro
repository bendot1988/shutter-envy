---
import { business } from '../../data/site';
---
<div class="sticky-cta" aria-label="Get in touch">
  <a class="sticky-cta__btn sticky-cta__btn--call" href={`tel:${business.phoneTel}`}>
    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M20 15.5c-1.25 0-2.45-.2-3.57-.57a1 1 0 0 0-1.02.24l-2.2 2.2a15.05 15.05 0 0 1-6.59-6.59l2.2-2.2a1 1 0 0 0 .25-1.01A11.36 11.36 0 0 1 8.5 4a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1c0 9.39 7.61 17 17 17a1 1 0 0 0 1-1v-3.5a1 1 0 0 0-1-1z"/></svg>
    Call us
  </a>
  <a class="sticky-cta__btn sticky-cta__btn--quote" href="/contact/">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 7h8m0 0L7 3m4 4l-4 4M21 17h-8m0 0l4 4m-4-4l4-4" stroke-linecap="round" stroke-linejoin="round"/></svg>
    Get a free quote
  </a>
</div>

<style>
  .sticky-cta {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 50;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    background: #fff;
    border-top: 1px solid var(--color-line);
    box-shadow: 0 -8px 24px -8px rgba(7,7,7,0.12);
    padding-bottom: env(safe-area-inset-bottom);
  }
  @media (min-width: 1024px) {
    .sticky-cta { display: none; }
  }
  .sticky-cta__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.875rem 1rem;
    font-family: var(--font-sans);
    font-weight: 500;
    /* button-14-500 */
    font-size: var(--text-button-14-500);
    line-height: 1.715;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: background 150ms;
  }
  .sticky-cta__btn--call {
    color: var(--color-ink);
    background: #fff;
    border-right: 1px solid var(--color-line);
  }
  .sticky-cta__btn--call:hover { background: var(--color-cream); }
  .sticky-cta__btn--quote {
    color: var(--color-ink);
    background: var(--color-gold-400);
  }
  .sticky-cta__btn--quote:hover { background: var(--color-gold-600); color: var(--color-ink); }
</style>
