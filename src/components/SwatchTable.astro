---
// Reusable colour-swatch table with mobile-stack behaviour.
// Pass a list of colours; the table auto-renders the right-hand
// "Optional Hinge Colour" list as a row-spanning cell on the first row only.
interface Swatch {
  id: string;
  name: string;
  hex: string;        // approximate paint colour for the visual chip
  hinge: string;
}
interface Props {
  title: string;
  subtitle?: string;
  swatches: Swatch[];
  optionalHinges?: string[];
}
const { title, subtitle, swatches, optionalHinges = [] } = Astro.props;
---
<section class="swatch-section" data-reveal>
  <header class="swatch-section__head">
    <h3>{title}</h3>
    {subtitle && <p>{subtitle}</p>}
  </header>

  <div class="swatch-table__wrap">
    <table class="swatch-table" aria-label={title}>
      <thead>
        <tr>
          <th>ID</th>
          <th>Colour Name</th>
          <th>Swatch</th>
          <th>Recommended Hinge</th>
          {optionalHinges.length > 0 && <th>Optional Hinge Colour</th>}
        </tr>
      </thead>
      <tbody>
        {swatches.map((s, i) => (
          <tr>
            <td data-label="ID"><span class="swatch-table__id">{s.id}</span></td>
            <td data-label="Colour Name"><span class="swatch-table__name">{s.name}</span></td>
            <td data-label="Swatch">
              <div class="swatch-chip" title={s.name} style={`background-color: ${s.hex}`}></div>
            </td>
            <td data-label="Recommended Hinge">{s.hinge}</td>
            {optionalHinges.length > 0 && i === 0 && (
              <td data-label="Optional Hinge Colours" rowspan={swatches.length} class="swatch-table__hinges">
                <ol>
                  {optionalHinges.map((h) => <li>{h}</li>)}
                </ol>
              </td>
            )}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<style>
  .swatch-section { margin-bottom: 3rem; }
  .swatch-section__head {
    margin-bottom: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .swatch-section__head h3 {
    font-family: var(--font-display);
    font-size: var(--text-h4-28-500);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.027em;
    margin: 0;
    color: var(--color-ink);
  }
  .swatch-section__head p {
    color: var(--color-ink-mute);
    font-size: var(--text-small-body-15-400);
    margin: 0;
  }

  .swatch-table__wrap {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    background: #fff;
  }

  .swatch-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
    font-family: var(--font-sans);
    color: var(--color-ink);
  }
  .swatch-table th,
  .swatch-table td {
    padding: 0.875rem 1rem;
    vertical-align: middle;
    text-align: left;
    border-bottom: 1px solid var(--color-line);
  }
  .swatch-table thead th {
    background: var(--color-cream);
    color: var(--color-gold-600);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-bottom: 2px solid var(--color-gold-400);
  }
  .swatch-table tbody tr { transition: background 150ms; }
  .swatch-table tbody tr:nth-child(odd) { background: rgba(249, 248, 244, 0.5); }
  .swatch-table tbody tr:hover { background: rgba(199,154,8,0.05); }
  .swatch-table tbody tr:last-child td { border-bottom: 0; }

  .swatch-table__id {
    font-family: ui-monospace, Menlo, monospace;
    font-size: 0.8125rem;
    background: var(--color-cream);
    color: var(--color-gold-600);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-weight: 600;
  }
  .swatch-table__name {
    font-weight: 500;
    color: var(--color-ink);
  }
  .swatch-chip {
    width: 100%;
    min-width: 6rem;
    max-width: 9rem;
    height: 36px;
    border-radius: 6px;
    border: 1px solid rgba(0,0,0,0.08);
    box-shadow:
      inset 0 0 0 1px rgba(255,255,255,0.25),
      0 1px 2px rgba(0,0,0,0.06);
    transition: transform 200ms;
  }
  .swatch-table tbody tr:hover .swatch-chip { transform: scale(1.04); }

  /* Optional-hinge list */
  .swatch-table__hinges {
    background: var(--color-cream) !important;
    border-left: 1px solid var(--color-line);
    vertical-align: top !important;
  }
  .swatch-table__hinges ol {
    columns: 2 11rem;
    column-gap: 1.5rem;
    margin: 0;
    padding-left: 1.25rem;
    font-size: 0.875rem;
  }
  .swatch-table__hinges li {
    margin: 0.25rem 0;
    break-inside: avoid;
    color: var(--color-ink-soft);
  }

  /* ─── Mobile: stacked cards ──────────────────────────── */
  @media (max-width: 720px) {
    .swatch-table__wrap { background: transparent; box-shadow: none; }
    .swatch-table thead { display: none; }
    .swatch-table,
    .swatch-table tbody,
    .swatch-table tr,
    .swatch-table td { display: block; width: 100%; }
    .swatch-table tr {
      background: #fff;
      border: 1px solid var(--color-line);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-sm);
      margin-bottom: 0.875rem;
      padding: 0.5rem 0;
    }
    .swatch-table tbody tr:nth-child(odd) { background: #fff; }
    .swatch-table tbody tr:hover { background: #fff; }
    .swatch-table td {
      border: 0;
      border-bottom: 1px solid var(--color-line);
      padding: 0.625rem 1.125rem;
      position: relative;
    }
    .swatch-table td:last-child { border-bottom: 0; }
    .swatch-table td::before {
      content: attr(data-label);
      display: block;
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 0.75rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--color-gold-600);
      margin-bottom: 0.375rem;
    }
    .swatch-chip { max-width: none; height: 32px; }
    .swatch-table__hinges {
      background: var(--color-cream) !important;
      border-left: 0 !important;
      border-top: 1px solid var(--color-line);
    }
    .swatch-table__hinges ol { columns: 1; }
  }
</style>
