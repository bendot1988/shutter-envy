---
// Pure HTML renderer for FAQs. The matching FAQPage JSON-LD is emitted by
// the page's route handler via lib/schema.ts — kept separate so structured
// data and visible markup can't drift apart.
import BackgroundImage from './BackgroundImage.astro';

interface Props {
  items: { question: string; answer: string }[];
  id?: string;
  heading?: string;
  intro?: string;
  layout?: 'stacked' | 'two-column';
  closingCta?: { label: string; href: string; prompt?: string };
  backgroundImage?: string;
  className?: string;
}
const { items, id = 'faqs', heading = 'Your Questions Answered', intro, layout = 'two-column', closingCta, backgroundImage, className } = Astro.props;
// Split heading on last word to gold it (e.g. "Your questions answered" → "Your questions" + "answered.")
const words = heading.split(' ');
const lead = words.slice(0, -1).join(' ');
const last = words[words.length - 1];
---
{items.length > 0 && (
  <section id={id} class:list={['faq', `faq--${layout}`, backgroundImage ? 'faq--has-bg' : '', className]}>
    {backgroundImage && <BackgroundImage src={backgroundImage} loading="lazy" />}
    {backgroundImage && <div class="faq__overlay"></div>}
    <div class="faq__inner">
    <header class="faq__header" data-reveal>
      <h2>{lead} <span class="gold">{last}.</span></h2>
      {intro && <p>{intro}</p>}
    </header>
    <dl data-reveal-children>
      {items.map((f) => (
        <details>
          <summary><dt>{f.question}</dt></summary>
          <dd set:html={f.answer} />
        </details>
      ))}
    </dl>
    {closingCta && (
      <p class="faq__closing">
        {closingCta.prompt ?? 'Still have questions?'}
        <a href={closingCta.href}>{closingCta.label} →</a>
      </p>
    )}
    </div>
  </section>
)}

<style>
  .faq {
    position: relative;
    margin: 0 calc(50% - 50vw);
    padding: 6rem 1.25rem;
    background-color: #fff;
  }
  .faq.post-faq {
    margin: 3rem 0 0;
    padding: 0;
    background-color: transparent;
  }
  .faq--has-bg {
    background-color: var(--color-cream);
    overflow: hidden;
  }
  .faq__overlay {
    position: absolute; inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgba(255,255,255,0.94), rgba(249,248,244,0.96));
  }
  .faq__inner {
    position: relative;
    z-index: 2;
    max-width: 64rem;
    margin-inline: auto;
  }
  .post-faq .faq__inner {
    max-width: none;
    margin-inline: 0;
  }
  .faq--two-column .faq__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (min-width: 768px) {
    .faq--two-column .faq__inner { grid-template-columns: 1fr 2fr; gap: 4rem; align-items: start; }
    .faq--two-column dl { grid-column: 1 / -1; margin-top: 1.5rem; }
  }
  .faq__header h2 {
    /* h2-60-500 */
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, var(--text-h2-60-500));
    font-weight: 500;
    margin: 0 0 1rem;
    line-height: 1.175;
    letter-spacing: -0.027em;
  }
  .post-faq .faq__header h2 {
    font-size: var(--text-h2-30-500);
    line-height: 1.175;
    margin-top: 0;
  }
  .faq__header .gold {
    color: var(--color-gold-600);
    font-style: italic;
  }
  .faq__header p {
    color: var(--color-ink-soft);
    font-size: var(--text-body-16-400);
    line-height: 1.875;
    margin: 0;
  }
  .faq dl {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
  }
  .faq details {
    padding: 1.25rem 1.5rem;
    background: rgba(255,255,255,0.92);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    margin-bottom: 0.625rem;
    box-shadow: var(--shadow-sm);
    transition: border-color 200ms, box-shadow 200ms, transform 200ms;
  }
  .faq details:hover {
    border-color: var(--color-gold-400);
    box-shadow: var(--shadow-md);
  }
  .faq details[open] {
    border-color: var(--color-gold-400);
    box-shadow: var(--shadow-md);
  }
  .faq details[open] { border-color: var(--color-line); }
  .faq summary {
    /* h5-20-500 */
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-h5-20-500);
    line-height: 1.187;
    letter-spacing: -0.015em;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    color: var(--color-ink);
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after {
    content: "+";
    font-size: 1.25rem;
    color: var(--color-gold-600);
    transition: transform 200ms;
    font-family: var(--font-sans);
    line-height: 1;
  }
  .faq details[open] summary::after { transform: rotate(45deg); }
  .faq summary dt { display: inline; font-weight: inherit; }
  .faq dd {
    margin: 0.875rem 0 0;
    padding: 0;
    color: var(--color-ink-soft);
    font-size: var(--text-body-16-400);
    line-height: 1.875;
  }
  .faq__closing {
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    color: var(--color-ink-mute);
    font-size: 0.9375rem;
    text-align: center;
  }
  .post-faq .faq__closing {
    text-align: left;
  }
  @media (min-width: 768px) { .faq--two-column .faq__closing { grid-column: 1 / -1; } }
  .faq__closing a {
    color: var(--color-gold-600);
    font-weight: 600;
    text-decoration: none;
    margin-left: 0.5rem;
  }
  .faq__closing a:hover { color: var(--color-gold-400); text-decoration: underline; }
</style>
