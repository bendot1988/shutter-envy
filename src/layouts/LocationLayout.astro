---
import BaseLayout from './BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Gallery from '../components/Gallery.astro';
import ServiceBlurbs from '../components/ServiceBlurbs.astro';
import MapEmbed from '../components/MapEmbed.astro';
import FAQ from '../components/FAQ.astro';
import InlineCTA from '../components/home/InlineCTA.astro';
import ClearLineForm from '../components/ClearLineForm.astro';
import { business } from '../data/site';

interface Props {
  title: string;
  description: string;
  h1: string;
  area: string;
  hero?: {
    eyebrow?: string;
    heading: string;
    subheading?: string;
    image?: string;
    cta?: { label: string; href: string };
  };
  gallery?: { src: string; alt: string }[];
  serviceBlurbs?: { icon?: string; heading: string; body: string }[];
  mapEmbedUrl?: string;
  faqs?: { question: string; answer: string }[];
  cta?: { heading: string; body?: string; button: { label: string; href: string } };
  ogImage?: string;
  jsonLd?: object | object[];
  includeLocalBusiness?: boolean;
}

const {
  title,
  description,
  h1,
  area,
  hero,
  gallery = [],
  serviceBlurbs = [],
  mapEmbedUrl,
  faqs = [],
  cta,
  ogImage,
  jsonLd,
  includeLocalBusiness,
} = Astro.props;
---
<BaseLayout {title} {description} {ogImage} {jsonLd} {includeLocalBusiness}>
  <article>
    <h1>{h1}</h1>
    <p class="area">Serving {area} and the surrounding villages</p>

    {hero && <Hero {...hero} />}

    {/* Location intro body — markdown content from the collection entry. */}
    <div class="location-body">
      <slot />
    </div>

    {serviceBlurbs.length > 0 && (
      <ServiceBlurbs items={serviceBlurbs} heading="What we offer" />
    )}

    {gallery.length > 0 && (
      <Gallery images={gallery} heading={`Recent work in ${area}`} />
    )}

    {mapEmbedUrl && <MapEmbed src={mapEmbedUrl} title={`Map of ${area}`} />}

    {faqs.length > 0 && <FAQ items={faqs} />}

    <section id="enquire" class="enquire">
      <h2>Get a quote in {area}</h2>
      <ClearLineForm />
    </section>

  </article>

  {cta && (
    <InlineCTA
      eyebrow="Ready to Book?"
      heading={cta.heading}
      body={cta.body}
      cta={cta.button}
      secondaryCta={{ label: `Call ${business.phoneDisplay}`, href: `tel:${business.phoneTel}` }}
      tone="gold"
    />
  )}
</BaseLayout>
