---
import BaseLayout from './BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Gallery from '../components/Gallery.astro';
import FAQ from '../components/FAQ.astro';
import InlineCTA from '../components/home/InlineCTA.astro';
import { business } from '../data/site';

interface Props {
  title: string;
  description: string;
  h1: string;
  eyebrow?: string;            // optional uppercase pill above the H1
  hero?: {
    eyebrow?: string;
    heading: string;
    subheading?: string;
    image?: string;
    cta?: { label: string; href: string };
  };
  gallery?: { src: string; alt: string }[];
  faqs?: { question: string; answer: string }[];
  cta?: { heading: string; body?: string; button: { label: string; href: string } };
  ogImage?: string;
  jsonLd?: object | object[];
  isHome?: boolean;
}

const {
  title,
  description,
  h1,
  eyebrow,
  hero,
  gallery = [],
  faqs = [],
  cta,
  ogImage,
  jsonLd,
  isHome,
} = Astro.props;
---
<BaseLayout {title} {description} {ogImage} {jsonLd} {isHome}>
  {/* ─── Hero block — every standard page gets one ────────── */}
  <section class="page-hero" data-reveal>
    <div class="page-hero__inner">
      {eyebrow && <span class="page-hero__eyebrow">{eyebrow}</span>}
      <h1>{h1}</h1>
      {description && <p class="page-hero__sub">{description}</p>}
    </div>
  </section>

  <article class="page-content">
    {hero && <Hero {...hero} />}

    {/* Body markdown well */}
    <div class="page-body" data-reveal>
      <slot />
    </div>

    {gallery.length > 0 && (
      <div class="page-gallery" data-reveal>
        <Gallery images={gallery} />
      </div>
    )}

    {faqs.length > 0 && <FAQ items={faqs} />}

  </article>

  {cta && (
    <InlineCTA
      eyebrow="Ready to Book?"
      heading={cta.heading}
      body={cta.body}
      cta={cta.button}
      secondaryCta={{ label: `Call ${business.phoneDisplay}`, href: `tel:${business.phoneTel}` }}
      tone="gold"
    />
  )}
</BaseLayout>

<style>
  /* ─── Page hero ────────────────────────────────────────── */
  .page-hero {
    background: var(--color-cream);
    margin: 0 calc(50% - 50vw);
    padding: 4rem 1.25rem 3.5rem;
    text-align: center;
  }
  .page-hero__inner {
    max-width: 48rem;
    margin: 0 auto;
  }
  .page-hero__eyebrow {
    display: inline-block;
    background: rgba(199,154,8,0.12);
    color: var(--color-gold-600);
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-pill);
    font-size: var(--text-link-12-700);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 1.25rem;
  }
  .page-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, var(--text-h2-60-500));
    font-weight: 500;
    line-height: 1.075;
    letter-spacing: -0.027em;
    margin: 0 0 1rem;
    text-wrap: balance;
  }
  .page-hero__sub {
    color: var(--color-ink-soft);
    font-size: var(--text-large-body-19-400);
    line-height: 1.6;
    margin: 0;
    text-wrap: pretty;
  }

  /* ─── Page content well ────────────────────────────────── */
  .page-content {
    padding: 4rem 1.25rem 5rem;
    max-width: var(--container-narrow);
    margin: 0 auto;
  }

  /* ─── Body styling (markdown content) ──────────────────── */
  .page-body {
    font-size: var(--text-body-16-400);
    line-height: 1.875;
    color: var(--color-ink);
  }
  .page-body :global(h2) {
    font-family: var(--font-display);
    font-size: var(--text-h2-30-500);
    font-weight: 500;
    line-height: 1.175;
    letter-spacing: -0.027em;
    margin: 3rem 0 1rem;
    scroll-margin-top: 6rem;
  }
  .page-body :global(h3) {
    font-family: var(--font-display);
    font-size: var(--text-h3-24-500);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.027em;
    margin: 2.25rem 0 0.75rem;
    color: var(--color-gold-600);
    scroll-margin-top: 6rem;
  }
  .page-body :global(h4) {
    font-family: var(--font-display);
    font-size: var(--text-h5-20-500);
    font-weight: 500;
    line-height: 1.187;
    letter-spacing: -0.015em;
    margin: 1.75rem 0 0.5rem;
  }
  .page-body :global(p) { margin: 0 0 1.5rem; }
  .page-body :global(a) {
    color: var(--color-gold-600);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(199,154,8,0.4);
    transition: text-decoration-color 200ms, color 200ms;
  }
  .page-body :global(a:hover) {
    color: var(--color-gold-400);
    text-decoration-color: currentColor;
  }
  .page-body :global(strong) { color: var(--color-ink); font-weight: 700; }
  .page-body :global(ul), .page-body :global(ol) {
    margin: 0 0 1.5rem;
    padding-left: 1.5rem;
  }
  .page-body :global(li) { margin: 0.5rem 0; line-height: 1.7; }
  .page-body :global(blockquote) {
    margin: 2rem 0;
    padding: 1.5rem 1.75rem;
    background: var(--color-cream);
    border-left: 4px solid var(--color-gold-400);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    font-family: var(--font-display);
    font-size: var(--text-h3-21-500);
    font-style: italic;
    color: var(--color-ink);
    line-height: 1.5;
  }
  .page-body :global(blockquote p:last-child) { margin: 0; }
  .page-body :global(img) {
    width: 100%;
    border-radius: var(--radius-md);
    margin: 2rem 0;
    box-shadow: var(--shadow-md);
  }
  .page-body :global(hr) {
    border: 0;
    height: 1px;
    background: var(--color-line);
    margin: 3rem 0;
  }
  .page-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: var(--text-small-body-15-400);
  }
  .page-body :global(th), .page-body :global(td) {
    padding: 0.875rem 1rem;
    text-align: left;
    border-bottom: 1px solid var(--color-line);
  }
  .page-body :global(th) {
    font-family: var(--font-display);
    font-weight: 500;
    color: var(--color-gold-600);
    background: var(--color-cream);
  }

  /* ─── Gallery section ──────────────────────────────────── */
  .page-gallery {
    margin: 3rem 0 0;
  }

  /* ─── CTA wrapper ──────────────────────────────────────── */
  .page-cta-wrap { margin-top: 3rem; }
</style>
