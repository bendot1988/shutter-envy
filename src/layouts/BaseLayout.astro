---
import SEO from '../components/SEO.astro';
import Analytics from '../components/Analytics.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AnnouncementBar from '../components/home/AnnouncementBar.astro';
import { localBusiness, webSite, webPage } from '../lib/schema';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonLd?: object | object[];
  // Location pages provide their own area-scoped LocalBusiness; set this
  // false to suppress the global one so the page doesn't ship two.
  includeLocalBusiness?: boolean;
  // Homepage gets WebPage + CollectionPage compound type.
  isHome?: boolean;
  // Optional gold announcement strip above the header. Set to a string to render.
  announcement?: string;
  // Product/marketing pages manage their own width per section — skip main.container.
  fullWidthMain?: boolean;
  // Per-page opt-in to noindex (e.g. 404). Combined with the site-wide
  // PUBLIC_NOINDEX env switch — either being true disables indexing.
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage,
  ogType,
  jsonLd,
  includeLocalBusiness = true,
  isHome = false,
  announcement,
  fullWidthMain = false,
  noindex = false,
} = Astro.props;

// Single switch for staging: PUBLIC_NOINDEX=true blocks all indexing site-wide.
const siteNoindex = import.meta.env.PUBLIC_NOINDEX === 'true';
const robotsMeta = noindex || siteNoindex ? 'noindex,nofollow' : 'index,follow';

const site = Astro.site!.toString().replace(/\/$/, '');
const pathname = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : Astro.url.pathname + '/';
const canonical = `${site}${pathname}`;

// Site-wide schema, in source order: Organization-identity (LocalBusiness),
// site identity (WebSite), page identity (WebPage). Page-specific schema
// (BlogPosting, BreadcrumbList, FAQPage) is appended by the calling route.
const pageJsonLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const allJsonLd: object[] = [
  ...(includeLocalBusiness ? [localBusiness()] : []),
  webSite(),
  webPage({ url: canonical, name: title, description, isHome }),
  ...pageJsonLd,
];
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="YyF275U-UHTD4vi0fjv4FCH3snTIyBv2fGjqqTu_sA0" />
    <meta name="robots" content={robotsMeta} />
    {/* Favicons — new brand icon (mustard arched shutter on a circle)
        replacing the WordPress site-icon export. The WP /wp-content/
        uploads/2024/08/cropped-Group-216-1-*.png files remain in place
        and untouched (per CLAUDE.md §7) so any legacy references still
        resolve. */}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#C79A08" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@400;500;600;700&family=Spectral:wght@400;500;600;700&display=swap"
    />
    <SEO {title} {description} {ogImage} {ogType} jsonLd={allJsonLd} />
    <Analytics />
  </head>
  <body>
    {announcement && <AnnouncementBar message={announcement} />}
    <Header />
    <main class={isHome || fullWidthMain ? '' : 'container'}>
      <slot />
    </main>
    <Footer />

    {/* Global reveal-on-scroll. Activates any element with
        [data-reveal] or [data-reveal-children] as it enters the viewport.
        Respects prefers-reduced-motion. */}
    <script>
      (() => {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          // CSS already handles the reduced-motion case
          return;
        }
        if (!('IntersectionObserver' in window)) {
          document.querySelectorAll('[data-reveal], [data-reveal-children]')
            .forEach((el) => el.classList.add('is-revealed'));
          return;
        }
        const io = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
              io.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
        document.querySelectorAll('[data-reveal], [data-reveal-children]')
          .forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>
