---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeatureChecklist from '../../components/home/FeatureChecklist.astro';
import ProcessTimeline from '../../components/home/ProcessTimeline.astro';
import InlineCTA from '../../components/home/InlineCTA.astro';
import FAQ from '../../components/FAQ.astro';
import { business } from '../../data/site';
import { breadcrumbList, faqPage, service } from '../../lib/schema';
import { TRACK } from '../../data/tracking';

const entry = await getEntry('pages', 'cafe-style-shutters');
if (!entry) throw new Error('Missing pages/cafe-style-shutters content entry');

const faqs = entry.data.faqs ?? [];

const jsonLd: object[] = [
  breadcrumbList([
    { name: 'Home', url: '/' },
    { name: 'Our Shutters', url: '/our-shutters/' },
    { name: 'Café-Style Shutters', url: '/cafe-style-shutters/' },
  ]),
  service({
    url: 'https://shutter-envy.co.uk/cafe-style-shutters/',
    name: 'Café-style plantation shutters',
    description: 'Made-to-measure café-style shutters — privacy on the lower window, daylight from above — supplied and fitted across Leicester, Loughborough and Leicestershire.',
    serviceType: 'Café-style window shutters',
  }),
];
if (faqs.length) jsonLd.push(faqPage(faqs));

const scraft = {
  livingRoom: '/wp-content/uploads/2025/02/S-CRAFT-Aluminium-Shutters-Living-Room-2-Satin-White-1024x670.jpg',
  kitchen: '/wp-content/uploads/2025/02/S-CRAFT-Aluminium-Shutters-Kitchen-2-Satin-White-1024x683.jpg',
  bayPhoto: '/wp-content/uploads/2025/02/bay-window-shutters-for-your-home-1024x525.jpg',
  periodLiving: '/wp-content/uploads/2025/02/Tier-on-Tier-1024x715.jpg',
};

const heroImage = scraft.livingRoom;

const features = [
  { heading: 'Privacy at eye level without blocking top light', body: '' },
  { heading: 'Typically 25–35% less than full-height on the same window', body: '' },
  { heading: 'Ideal for street-facing bays and Victorian terraces', body: '' },
  { heading: 'Works on sash windows, casements and kitchen openings', body: '' },
  { heading: 'Faux wood, hardwood and waterproof ABS options', body: '' },
  { heading: 'Surveyed, manufactured and fitted by our own team', body: '' },
];

const rooms = [
  {
    name: 'Street-facing living rooms',
    body: 'The classic use case — privacy from the pavement at sofa height while the top half of the bay stays clear for daylight and views.',
    image: scraft.livingRoom,
    alt: 'S-Craft plantation shutters in a satin-white UK living room',
  },
  {
    name: 'Kitchens',
    body: 'Cover the lower panes above the worktop; keep the top clear for natural light. Waterproof ABS or faux wood handles steam and splashes.',
    image: scraft.kitchen,
    alt: 'S-Craft shutters in a satin-white UK kitchen',
  },
  {
    name: 'Bay windows',
    body: 'Each facet gets café-height panels that follow the bay angle. Popular on front bays in Clarendon Park, Stoneygate and Loughborough terraces.',
    image: scraft.bayPhoto,
    alt: 'S-Craft plantation shutters on a three-panel splay bay window',
  },
  {
    name: 'Sash & period windows',
    body: 'Shutters sit below decorative top panes or the meeting rail — privacy without hiding the character glass that makes the window special.',
    image: scraft.periodLiving,
    alt: 'S-Craft plantation shutters on tall windows in a period-style UK living room',
  },
];

const comparisons = [
  {
    style: 'Café-style',
    best: 'Maximum top light, fixed split height, lower cost',
    watch: 'Top half always exposed — less noise blocking than full cover',
  },
  {
    style: 'Tier-on-tier',
    best: 'Independent upper and lower panels on full window height',
    watch: 'Usually 5–15% more than full-height; more panels to adjust',
  },
  {
    style: 'Full-height',
    best: 'Maximum privacy, light control and noise dampening',
    watch: 'Blocks more daylight when louvres are closed',
  },
];

const processSteps = [
  { title: 'Home consultation', body: 'We visit at a time that suits you with physical samples and split-height examples.', image: '/wp-content/uploads/2024/10/106shots_so.jpeg' },
  { title: 'Survey & split-line advice', body: 'Mark measures every opening and recommends the right split height for privacy and proportions.', image: '/images/mark-shutter-envy-van.png' },
  { title: 'Manufacturing', body: 'Your café-style shutters are made to order — regular updates while they are in production.', image: '/wp-content/uploads/2025/02/S-CRAFT-Aluminium-Shutters-Kitchen-4-Satin-White-1024x681.jpg' },
  { title: 'Professional installation', body: 'Our fitting team installs, adjusts every panel, and leaves the room tidy.', image: '/wp-content/uploads/2024/10/dotwall-Web-Design2024-10-07-at-14.08.01.jpeg' },
];
---
<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogImage={entry.data.ogImage}
  jsonLd={jsonLd}
>
  <section class="css-hero" style={`background-image: url('${heroImage}')`}>
    <div class="css-hero__overlay"></div>
    <div class="css-hero__inner" data-reveal>
      <span class="css-hero__eyebrow">Café-Style Shutters</span>
      <h1>{entry.data.h1}</h1>
      <p>Privacy on the lower half. Daylight from above. Made to measure and professionally fitted across Leicester, Loughborough and Leicestershire.</p>
      <div class="css-hero__actions">
        <a href="/contact/" class="css-hero__btn" data-track={TRACK.productHeroCtas}>
          Arrange a Home Visit
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M3 7h8m0 0L7 3m4 4l-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href={`tel:${business.phoneTel}`} class="css-hero__btn css-hero__btn--ghost" data-track={TRACK.productHeroCtas}>Call {business.phoneDisplay}</a>
      </div>
    </div>
  </section>

  <section class="css-intro container" data-reveal>
    <h2>Privacy at the bottom. Light from the top.</h2>
    <p>
      Café-style shutters cover the lower portion of your window — usually from the sill to roughly halfway up — and leave the top half clear. You get street-level privacy without sacrificing the daylight that makes a room feel spacious.
    </p>
    <p>
      We fit café-style shutters across <a href="/locations/shutters-in-leicester/">Leicester</a>, <a href="/locations/shutters-in-loughborough/">Loughborough</a>, Melton Mowbray, Market Harborough and the surrounding villages. Every set is surveyed on site so the split line sits at the right height for how you use the room.
    </p>
    <p class="css-intro__links">
      <a href="/what-are-cafe-style-shutters-and-what-is-the-point-of-them/">Read the full café-style guide →</a>
      <a href="/choosing-the-perfect-style-full-height-vs-tier-on-tier-shutters/">Compare with tier-on-tier →</a>
    </p>
  </section>

  <FeatureChecklist
    heading="Why homeowners choose café-style"
    body="A practical compromise between full coverage and bare glass — especially on overlooked ground floors."
    items={features}
    cta={{ label: 'Arrange a Home Visit', href: '/contact/' }}
    backgroundImage={heroImage}
  />

  <section class="css-rooms" data-reveal>
    <div class="container">
      <header class="css-rooms__header">
        <span class="css-eyebrow">By room</span>
        <h2>Where café-style shutters work best</h2>
        <p>Not every room suits a half-height shutter. These are the configurations we recommend most often in Leicestershire homes.</p>
      </header>
      <ul class="css-rooms__grid" data-reveal-children>
        {rooms.map((room) => (
          <li>
            <article class="css-room-card">
              <img src={room.image} alt={room.alt} loading="lazy" />
              <div class="css-room-card__body">
                <h3>{room.name}</h3>
                <p>{room.body}</p>
              </div>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="css-compare">
    <div class="container" data-reveal>
      <header class="css-compare__header">
        <span class="css-eyebrow">Style comparison</span>
        <h2>Café-style vs tier-on-tier vs full-height</h2>
        <p>Not sure which split is right? This is the decision tree we walk through on every survey.</p>
      </header>
      <div class="css-compare__table-wrap">
        <table class="css-compare__table">
          <thead>
            <tr>
              <th scope="col">Style</th>
              <th scope="col">Best for</th>
              <th scope="col">Trade-off</th>
            </tr>
          </thead>
          <tbody>
            {comparisons.map((row) => (
              <tr>
                <th scope="row">{row.style}</th>
                <td>{row.best}</td>
                <td>{row.watch}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="css-compare__note">
        For typical UK fitted prices, see our <a href="/how-much-do-plantation-shutters-cost-a-complete-uk-price-guide/">plantation shutters cost guide</a> and <a href="/bay-window-shutters-cost-uk-2026-guide/">bay window cost guide</a>. Café-style is usually the most affordable louvred option on a standard window.
      </p>
    </div>
  </section>

  <ProcessTimeline
    heading="From survey to <em>fitted</em>"
    subheading="Four steps — measured in your home, made to order, installed by our team."
    steps={processSteps}
  />

  <FAQ
    items={faqs}
    heading="Café-style shutter questions answered"
    intro="Straight answers on cost, rooms, bay windows and how café-style compares to other shutter styles."
    closingCta={{ label: 'Arrange a home visit', href: '/contact/', prompt: 'Want the split line measured in your room?' }}
    backgroundImage={scraft.livingRoom}
  />

  <InlineCTA
    eyebrow="Free home survey"
    heading="See café-style shutters in your room"
    body="Mark brings samples, recommends the right split height, and gives you a no-obligation fitted price on the day — with a clear breakdown per window."
    cta={{ label: 'Arrange a Home Visit', href: '/contact/' }}
    secondaryCta={{ label: 'Browse all shutter styles', href: '/our-shutters/' }}
    tone="gold"
  />
</BaseLayout>

<style>
  .css-eyebrow {
    display: inline-block;
    background: rgba(199,154,8,0.12);
    color: var(--color-gold-600);
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-pill);
    font-size: var(--text-link-12-700);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 1.25rem;
  }

  .css-hero {
    position: relative;
    margin: 0 calc(50% - 50vw);
    padding: 5rem 1.25rem 5.5rem;
    background-color: var(--color-cream);
    background-size: cover;
    background-position: center;
    text-align: center;
    overflow: hidden;
  }
  .css-hero__overlay {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(249,248,244,0.88) 0%, rgba(249,248,244,0.95) 100%);
  }
  .css-hero__inner { position: relative; max-width: 48rem; margin: 0 auto; }
  .css-hero__eyebrow {
    display: inline-block;
    background: rgba(199,154,8,0.12);
    color: var(--color-gold-600);
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-pill);
    font-size: var(--text-link-12-700);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 1.25rem;
  }
  .css-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, var(--text-h2-60-500));
    font-weight: 500;
    line-height: 1.075;
    letter-spacing: -0.027em;
    margin: 0 0 1.5rem;
    text-wrap: balance;
  }
  .css-hero p {
    color: var(--color-ink-soft);
    font-size: var(--text-large-body-19-400);
    line-height: 1.6;
    margin: 0 0 2rem;
    max-width: 36rem;
    margin-left: auto;
    margin-right: auto;
  }
  .css-hero__actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .css-hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.875rem;
    background: linear-gradient(180deg, var(--color-gold-400), var(--color-gold-600));
    color: #fff;
    border-radius: var(--radius-pill);
    font-weight: 500;
    font-size: var(--text-button-14-500);
    text-decoration: none;
    box-shadow: 0 12px 32px -8px rgba(199,154,8,0.55);
    transition: transform 200ms, filter 200ms;
  }
  .css-hero__btn:hover { transform: translateY(-2px); filter: brightness(1.08); color: #fff; }
  .css-hero__btn--ghost {
    background: #fff;
    color: var(--color-ink);
    border: 1px solid var(--color-line);
    box-shadow: var(--shadow-sm);
  }
  .css-hero__btn--ghost:hover {
    border-color: var(--color-gold-400);
    color: var(--color-gold-600);
  }

  .css-intro {
    max-width: 44rem;
    padding: 4rem 1.25rem 1rem;
    text-align: center;
  }
  .css-intro h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, var(--text-h2-60-500));
    font-weight: 500;
    line-height: 1.075;
    margin: 0 0 1.5rem;
  }
  .css-intro p {
    color: var(--color-ink-soft);
    font-size: var(--text-large-body-19-400);
    line-height: 1.6;
    margin: 0 auto 1rem;
    max-width: 40rem;
  }
  .css-intro a { color: var(--color-gold-600); font-weight: 600; }
  .css-intro__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    justify-content: center;
    margin-top: 1.5rem !important;
  }

  .css-rooms {
    padding: 5rem 0;
    background: #fff;
  }
  .css-rooms__header {
    text-align: center;
    max-width: 44rem;
    margin: 0 auto 3rem;
  }
  .css-rooms__header h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, var(--text-h2-60-500));
    font-weight: 500;
    margin: 0 0 1rem;
  }
  .css-rooms__header p {
    color: var(--color-ink-soft);
    font-size: var(--text-large-body-19-400);
    line-height: 1.6;
    margin: 0;
  }
  .css-rooms__grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) { .css-rooms__grid { grid-template-columns: repeat(2, 1fr); } }
  .css-rooms__grid li { margin: 0; }
  .css-room-card {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    height: 100%;
    display: flex;
    flex-direction: column;
    background: #fff;
    transition: transform 220ms, box-shadow 220ms, border-color 220ms;
  }
  .css-room-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-gold-400);
  }
  .css-room-card img {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    display: block;
  }
  .css-room-card__body { padding: 1.5rem 1.75rem 1.75rem; }
  .css-room-card h3 {
    font-family: var(--font-display);
    color: var(--color-gold-600);
    font-size: var(--text-h3-24-500);
    margin: 0 0 0.625rem;
  }
  .css-room-card p {
    color: var(--color-ink-soft);
    font-size: var(--text-small-body-15-400);
    line-height: 1.65;
    margin: 0;
  }

  .css-compare {
    padding: 5rem 0;
    background: var(--color-cream);
    margin: 0 calc(50% - 50vw);
  }
  .css-compare__header {
    text-align: center;
    max-width: 44rem;
    margin: 0 auto 2.5rem;
  }
  .css-compare__header h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, var(--text-h2-60-500));
    font-weight: 500;
    margin: 0 0 1rem;
  }
  .css-compare__header p {
    color: var(--color-ink-soft);
    margin: 0;
    line-height: 1.6;
  }
  .css-compare__table-wrap {
    overflow-x: auto;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: #fff;
    box-shadow: var(--shadow-sm);
  }
  .css-compare__table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-small-body-15-400);
  }
  .css-compare__table th,
  .css-compare__table td {
    padding: 1rem 1.25rem;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--color-line);
  }
  .css-compare__table thead th {
    background: rgba(199,154,8,0.08);
    font-family: var(--font-display);
    font-weight: 500;
  }
  .css-compare__table tbody th {
    color: var(--color-gold-600);
    font-family: var(--font-display);
    font-weight: 500;
    white-space: nowrap;
  }
  .css-compare__table tr:last-child th,
  .css-compare__table tr:last-child td { border-bottom: none; }
  .css-compare__note {
    text-align: center;
    margin: 1.75rem 0 0;
    color: var(--color-ink-soft);
    font-size: var(--text-body-16-400);
  }
  .css-compare__note a { color: var(--color-gold-600); font-weight: 600; }
</style>
