---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeatureChecklist from '../../components/home/FeatureChecklist.astro';
import ProcessTimeline from '../../components/home/ProcessTimeline.astro';
import InlineCTA from '../../components/home/InlineCTA.astro';
import FAQ from '../../components/FAQ.astro';
import { business } from '../../data/site';
import { breadcrumbList, faqPage, service } from '../../lib/schema';
import { TRACK } from '../../data/tracking';

const entry = await getEntry('pages', 'faux-wood-shutters');
if (!entry) throw new Error('Missing pages/faux-wood-shutters content entry');

const faqs = entry.data.faqs ?? [];

const jsonLd: object[] = [
  breadcrumbList([
    { name: 'Home', url: '/' },
    { name: 'Our Shutters', url: '/our-shutters/' },
    { name: 'Faux Wood Shutters', url: '/faux-wood-shutters/' },
  ]),
  service({
    url: 'https://shutter-envy.co.uk/faux-wood-shutters/',
    name: 'Faux wood plantation shutters',
    description: 'Made-to-measure faux wood plantation shutters — moisture-resistant, hard-wearing and professionally fitted across Leicester, Loughborough and Leicestershire.',
    serviceType: 'Faux wood window shutters',
  }),
];
if (faqs.length) jsonLd.push(faqPage(faqs));

const imgs = {
  kitchen: '/wp-content/uploads/2026/04/faux-wood-shutters-kitchen-window-uk-1024x571.jpeg',
  louvre: '/wp-content/uploads/2026/04/faux-wood-shutter-louvre-close-up-1024x571.jpeg',
  compare: '/wp-content/uploads/2026/04/faux-wood-vs-real-wood-shutter-comparison-1024x571.jpeg',
  living: '/wp-content/uploads/2026/04/01-Shutter-Envy-shutters-in-Loughbray-and-Leicester--1024x571.jpeg',
  bay: '/wp-content/uploads/2026/04/Bay-window-shutters-in-Loughborough-1024x571.jpeg',
  bedroom: '/wp-content/uploads/2026/04/05-Shutter-Envy-shutters-in-Loughbray-and-Leicester--1024x571.jpeg',
};

const heroImage = imgs.kitchen;

const features = [
  { heading: 'Moisture-resistant — kitchens and bathrooms welcome', body: '' },
  { heading: 'Typically £150–£350 per standard window fitted', body: '' },
  { heading: 'Looks like painted timber once installed', body: '' },
  { heading: 'Wipe-clean finish — no polishing or oiling', body: '' },
  { heading: 'Holds colour better than many painted woods', body: '' },
  { heading: 'Surveyed, manufactured and fitted by our own team', body: '' },
];

const rooms = [
  {
    name: 'Kitchens',
    body: 'Steam, cooking moisture and wipe-downs are everyday life here. Faux wood handles humidity that would eventually swell MDF or stress poorly sealed timber.',
    image: imgs.kitchen,
    alt: 'Faux wood plantation shutters fitted on a UK kitchen window',
  },
  {
    name: 'Bathrooms & en-suites',
    body: 'Condensation is the main enemy of shutters. Faux wood is the usual recommendation for family bathrooms; waterproof ABS for wet shower rooms.',
    image: imgs.louvre,
    alt: 'Close-up of a faux wood plantation shutter louvre and stile',
  },
  {
    name: 'Living rooms & bays',
    body: 'Street-facing bays in Leicester and Loughborough get privacy and light control without the price of hardwood across every panel.',
    image: imgs.bay,
    alt: 'Bay window plantation shutters fitted in a Loughborough home',
  },
  {
    name: 'Bedrooms & family rooms',
    body: 'Hard-wearing enough for children and pets, with the classic plantation look. A practical whole-house material when you want one finish throughout.',
    image: imgs.bedroom,
    alt: 'Plantation shutters in a Leicestershire bedroom',
  },
];

const comparisons = [
  {
    style: 'Faux wood',
    best: 'Most UK rooms — moisture resistance, value, low maintenance',
    watch: 'Painted look only — not for stained timber grain',
  },
  {
    style: 'Hardwood',
    best: 'Dry living rooms and bedrooms wanting timber warmth',
    watch: 'Higher cost; avoid steamy kitchens and bathrooms',
  },
  {
    style: 'MDF',
    best: 'Dry, low-traffic rooms on a tighter budget',
    watch: 'Wrong in moisture; shorter lifespan than faux wood',
  },
  {
    style: 'Aluminium',
    best: 'Conservatories, south-facing heat, security openings',
    watch: 'Premium price — often mixed with faux wood elsewhere',
  },
];

const processSteps = [
  { title: 'Home consultation', body: 'We visit with physical samples so you can feel the weight and finish of faux wood beside hardwood and MDF.', image: '/wp-content/uploads/2024/10/106shots_so.jpeg' },
  { title: 'Survey & material advice', body: 'Mark measures every opening and recommends the right material per room — not one product forced into every window.', image: '/images/mark-shutter-envy-van.png' },
  { title: 'Manufacturing', body: 'Your shutters are made to order in the colour and louvre size you choose — with regular updates while they are in production.', image: imgs.living },
  { title: 'Professional installation', body: 'Our fitting team installs, adjusts every panel, and leaves the room tidy.', image: '/wp-content/uploads/2024/10/dotwall-Web-Design2024-10-07-at-14.08.01.jpeg' },
];
---
<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogImage={entry.data.ogImage}
  jsonLd={jsonLd}
>
  <section class="fws-hero" style={`background-image: url('${heroImage}')`}>
    <div class="fws-hero__overlay"></div>
    <div class="fws-hero__inner" data-reveal>
      <span class="fws-hero__eyebrow">Faux Wood Shutters</span>
      <h1>{entry.data.h1}</h1>
      <p>The plantation shutter look without the moisture headaches. Made to measure and professionally fitted across Leicester, Loughborough and Leicestershire.</p>
      <div class="fws-hero__actions">
        <a href="/contact/" class="fws-hero__btn" data-track={TRACK.productHeroCtas}>
          Arrange a Home Visit
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M3 7h8m0 0L7 3m4 4l-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href={`tel:${business.phoneTel}`} class="fws-hero__btn fws-hero__btn--ghost" data-track={TRACK.productHeroCtas}>Call {business.phoneDisplay}</a>
      </div>
    </div>
  </section>

  <section class="fws-intro container" data-reveal>
    <h2>The practical plantation shutter for UK homes</h2>
    <p>
      Faux wood shutters give you the classic louvred look of timber — without absorbing steam, warping in humidity or needing the upkeep of natural wood. For most kitchens, bathrooms and busy family rooms in Leicestershire, they are the material we recommend first.
    </p>
    <p>
      We fit faux wood plantation shutters across <a href="/locations/shutters-in-leicester/">Leicester</a>, <a href="/locations/shutters-in-loughborough/">Loughborough</a>, Melton Mowbray, Market Harborough and the surrounding villages. Every set is surveyed on site so the panels, louvre size and colour suit how you use each room.
    </p>
    <p class="fws-intro__links">
      <a href="/are-faux-wood-shutters-any-good-durability-cost-honest-verdict/">Read the honest faux wood verdict →</a>
      <a href="/the-difference-between-wooden-and-faux-wood-shutters/">Compare wood vs faux wood →</a>
    </p>
  </section>

  <FeatureChecklist
    heading="Why homeowners choose faux wood"
    body="A durable, wipe-clean plantation shutter that handles UK humidity without looking like a compromise."
    items={features}
    cta={{ label: 'Arrange a Home Visit', href: '/contact/' }}
    backgroundImage={heroImage}
  />

  <section class="fws-rooms" data-reveal>
    <div class="container">
      <header class="fws-rooms__header">
        <span class="fws-eyebrow">By room</span>
        <h2>Where faux wood shutters work best</h2>
        <p>Not every material suits every opening. These are the rooms where faux wood earns its place most often.</p>
      </header>
      <ul class="fws-rooms__grid" data-reveal-children>
        {rooms.map((room) => (
          <li>
            <article class="fws-room-card">
              <img src={room.image} alt={room.alt} loading="lazy" />
              <div class="fws-room-card__body">
                <h3>{room.name}</h3>
                <p>{room.body}</p>
              </div>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="fws-compare">
    <div class="container" data-reveal>
      <header class="fws-compare__header">
        <span class="fws-eyebrow">Material comparison</span>
        <h2>Faux wood vs hardwood vs MDF vs aluminium</h2>
        <p>This is the decision tree we walk through on every survey — room by room, not one blanket answer.</p>
      </header>
      <div class="fws-compare__table-wrap">
        <table class="fws-compare__table">
          <thead>
            <tr>
              <th scope="col">Material</th>
              <th scope="col">Best for</th>
              <th scope="col">Trade-off</th>
            </tr>
          </thead>
          <tbody>
            {comparisons.map((row) => (
              <tr>
                <th scope="row">{row.style}</th>
                <td>{row.best}</td>
                <td>{row.watch}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="fws-compare__note">
        For typical UK fitted prices, see our <a href="/how-much-do-plantation-shutters-cost-a-complete-uk-price-guide/">plantation shutters cost guide</a>.
        Considering MDF instead? Read <a href="/are-mdf-shutters-any-good-honest-uk-verdict/">our honest MDF verdict</a>.
        For aluminium, see <a href="/are-aluminium-shutters-worth-it-uk-buyers-guide/">aluminium shutters worth it?</a>
      </p>
    </div>
  </section>

  <ProcessTimeline
    heading="From survey to <em>fitted</em>"
    subheading="Four steps — measured in your home, made to order, installed by our team."
    steps={processSteps}
  />

  <FAQ
    items={faqs}
    heading="Faux wood shutter questions answered"
    intro="Straight answers on cost, lifespan, moisture resistance and how faux wood compares to timber and MDF."
    closingCta={{ label: 'Arrange a home visit', href: '/contact/', prompt: 'Want samples in your own rooms?' }}
    backgroundImage={imgs.compare}
  />

  <InlineCTA
    eyebrow="Free home survey"
    heading="See faux wood shutters in your room"
    body="Mark brings samples, recommends the right material per window, and gives you a no-obligation fitted price on the day — with a clear breakdown."
    cta={{ label: 'Arrange a Home Visit', href: '/contact/' }}
    secondaryCta={{ label: 'Browse all shutter styles', href: '/our-shutters/' }}
    tone="gold"
  />
</BaseLayout>

<style>
  .fws-eyebrow {
    display: inline-block;
    background: rgba(199,154,8,0.12);
    color: var(--color-gold-600);
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-pill);
    font-size: var(--text-link-12-700);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 1.25rem;
  }

  .fws-hero {
    position: relative;
    margin: 0 calc(50% - 50vw);
    padding: 5rem 1.25rem 5.5rem;
    background-color: var(--color-cream);
    background-size: cover;
    background-position: center;
    text-align: center;
    overflow: hidden;
  }
  .fws-hero__overlay {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(249,248,244,0.88) 0%, rgba(249,248,244,0.95) 100%);
  }
  .fws-hero__inner { position: relative; max-width: 48rem; margin: 0 auto; }
  .fws-hero__eyebrow {
    display: inline-block;
    background: rgba(199,154,8,0.12);
    color: var(--color-gold-600);
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-pill);
    font-size: var(--text-link-12-700);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 1.25rem;
  }
  .fws-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, var(--text-h2-60-500));
    font-weight: 500;
    line-height: 1.075;
    letter-spacing: -0.027em;
    margin: 0 0 1.5rem;
    text-wrap: balance;
  }
  .fws-hero p {
    color: var(--color-ink-soft);
    font-size: var(--text-large-body-19-400);
    line-height: 1.6;
    margin: 0 0 2rem;
    max-width: 36rem;
    margin-left: auto;
    margin-right: auto;
  }
  .fws-hero__actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .fws-hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.875rem;
    background: linear-gradient(180deg, var(--color-gold-400), var(--color-gold-600));
    color: #fff;
    border-radius: var(--radius-pill);
    font-weight: 500;
    font-size: var(--text-button-14-500);
    text-decoration: none;
    box-shadow: 0 12px 32px -8px rgba(199,154,8,0.55);
    transition: transform 200ms, filter 200ms;
  }
  .fws-hero__btn:hover { transform: translateY(-2px); filter: brightness(1.08); color: #fff; }
  .fws-hero__btn--ghost {
    background: #fff;
    color: var(--color-ink);
    border: 1px solid var(--color-line);
    box-shadow: var(--shadow-sm);
  }
  .fws-hero__btn--ghost:hover {
    border-color: var(--color-gold-400);
    color: var(--color-gold-600);
  }

  .fws-intro {
    max-width: 44rem;
    padding: 4rem 1.25rem 1rem;
    text-align: center;
  }
  .fws-intro h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, var(--text-h2-60-500));
    font-weight: 500;
    line-height: 1.075;
    margin: 0 0 1.5rem;
  }
  .fws-intro p {
    color: var(--color-ink-soft);
    font-size: var(--text-large-body-19-400);
    line-height: 1.6;
    margin: 0 auto 1rem;
    max-width: 40rem;
  }
  .fws-intro a { color: var(--color-gold-600); font-weight: 600; }
  .fws-intro__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    justify-content: center;
    margin-top: 1.5rem !important;
  }

  .fws-rooms {
    padding: 5rem 0;
    background: #fff;
  }
  .fws-rooms__header {
    text-align: center;
    max-width: 44rem;
    margin: 0 auto 3rem;
  }
  .fws-rooms__header h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, var(--text-h2-60-500));
    font-weight: 500;
    margin: 0 0 1rem;
  }
  .fws-rooms__header p {
    color: var(--color-ink-soft);
    font-size: var(--text-large-body-19-400);
    line-height: 1.6;
    margin: 0;
  }
  .fws-rooms__grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) { .fws-rooms__grid { grid-template-columns: repeat(2, 1fr); } }
  .fws-rooms__grid li { margin: 0; }
  .fws-room-card {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    height: 100%;
    display: flex;
    flex-direction: column;
    background: #fff;
    transition: transform 220ms, box-shadow 220ms, border-color 220ms;
  }
  .fws-room-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-gold-400);
  }
  .fws-room-card img {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    display: block;
  }
  .fws-room-card__body { padding: 1.5rem 1.75rem 1.75rem; }
  .fws-room-card h3 {
    font-family: var(--font-display);
    color: var(--color-gold-600);
    font-size: var(--text-h3-24-500);
    margin: 0 0 0.625rem;
  }
  .fws-room-card p {
    color: var(--color-ink-soft);
    font-size: var(--text-small-body-15-400);
    line-height: 1.65;
    margin: 0;
  }

  .fws-compare {
    padding: 5rem 0;
    background: var(--color-cream);
    margin: 0 calc(50% - 50vw);
  }
  .fws-compare__header {
    text-align: center;
    max-width: 44rem;
    margin: 0 auto 2.5rem;
  }
  .fws-compare__header h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, var(--text-h2-60-500));
    font-weight: 500;
    margin: 0 0 1rem;
  }
  .fws-compare__header p {
    color: var(--color-ink-soft);
    margin: 0;
    line-height: 1.6;
  }
  .fws-compare__table-wrap {
    overflow-x: auto;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: #fff;
    box-shadow: var(--shadow-sm);
  }
  .fws-compare__table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-small-body-15-400);
  }
  .fws-compare__table th,
  .fws-compare__table td {
    padding: 1rem 1.25rem;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--color-line);
  }
  .fws-compare__table thead th {
    background: rgba(199,154,8,0.08);
    font-family: var(--font-display);
    font-weight: 500;
  }
  .fws-compare__table tbody th {
    color: var(--color-gold-600);
    font-family: var(--font-display);
    font-weight: 500;
    white-space: nowrap;
  }
  .fws-compare__table tr:last-child th,
  .fws-compare__table tr:last-child td { border-bottom: none; }
  .fws-compare__note {
    text-align: center;
    margin: 1.75rem 0 0;
    color: var(--color-ink-soft);
    font-size: var(--text-body-16-400);
  }
  .fws-compare__note a { color: var(--color-gold-600); font-weight: 600; }
</style>
