---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeatureChecklist from '../../components/home/FeatureChecklist.astro';
import ProcessTimeline from '../../components/home/ProcessTimeline.astro';
import InlineCTA from '../../components/home/InlineCTA.astro';
import FAQ from '../../components/FAQ.astro';
import { business } from '../../data/site';
import { breadcrumbList, faqPage, service } from '../../lib/schema';
import { TRACK } from '../../data/tracking';

const entry = await getEntry('pages', 'arched-window-shutters');
if (!entry) throw new Error('Missing pages/arched-window-shutters content entry');

const faqs = entry.data.faqs ?? [];

const jsonLd: object[] = [
  breadcrumbList([
    { name: 'Home', url: '/' },
    { name: 'Our Shutters', url: '/our-shutters/' },
    { name: 'Arched Window Shutters', url: '/arched-window-shutters/' },
  ]),
  service({
    url: 'https://shutter-envy.co.uk/arched-window-shutters/',
    name: 'Arched window shutters',
    description: 'Made-to-measure arched and shaped plantation shutters — templated on site and professionally fitted across Leicester, Loughborough and Leicestershire.',
    serviceType: 'Arched window shutters',
  }),
];
if (faqs.length) jsonLd.push(faqPage(faqs));

const imgs = {
  hero: '/wp-content/uploads/2025/10/791727650-492010221_1034800252045580_6588738170356077864_n-Large-819x1024.jpeg',
  a: '/wp-content/uploads/2025/10/791727643-492994671_1034799932045612_924744254860245336_n-Large-819x1024.jpeg',
  b: '/wp-content/uploads/2025/10/791727630-492001443_1034799728712299_4398194868688013789_n-Large-819x1024.jpeg',
  c: '/wp-content/uploads/2025/10/791727622-492205289_1034800048712267_5309738397671176552_n-Large-819x1024.jpeg',
  living: '/wp-content/uploads/2026/04/01-Shutter-Envy-shutters-in-Loughbray-and-Leicester--1024x571.jpeg',
};

const heroImage = imgs.hero;

const features = [
  { heading: 'Follows the curve of the glass — not a rectangular compromise', body: '' },
  { heading: 'On-site templating for every shaped opening', body: '' },
  { heading: 'Works on Victorian arches, stairwells and feature windows', body: '' },
  { heading: 'Operable louvres where the layout allows', body: '' },
  { heading: 'Hardwood, faux wood and ABS options by room', body: '' },
  { heading: 'Surveyed, manufactured and fitted by our own team', body: '' },
];

const rooms = [
  {
    name: 'Feature living-room arches',
    body: 'Keep the architectural curve on show while adding privacy and light control — the classic use case for shaped shutters in Leicestershire period homes.',
    image: imgs.hero,
    alt: 'Made-to-measure arched window shutters fitted in a Leicestershire home',
  },
  {
    name: 'Stairwells & landings',
    body: 'Tall arched lights on stairs are awkward for curtains. Shaped shutters dress the opening without blocking the view or looking like an afterthought.',
    image: imgs.a,
    alt: 'Arched plantation shutters following a shaped window opening',
  },
  {
    name: 'Bedrooms with shaped tops',
    body: 'Segmental and arched bedroom windows need a template so louvres sit true. Softens early light without hiding the feature glass.',
    image: imgs.b,
    alt: 'Bespoke arched shutters on a shaped bedroom window',
  },
  {
    name: 'Lofts & conversions',
    body: 'Modern feature arches and apex hybrids still need millimetre accuracy. We template first, then manufacture to the surveyed shape.',
    image: imgs.c,
    alt: 'Close detail of arched shutter panels on a shaped window',
  },
];

const comparisons = [
  {
    style: 'Arched / shaped shutters',
    best: 'Windows with a curved or irregular top that you want to keep as a feature',
    watch: 'Higher cost and longer lead time than a flat casement',
  },
  {
    style: 'Full-height rectangular',
    best: 'Standard casements and square openings',
    watch: 'Wrong choice if it chops an arch into a box',
  },
  {
    style: 'Café-style',
    best: 'Street-facing lower privacy with top light left clear',
    watch: 'Does not solve a shaped top on its own',
  },
  {
    style: 'Blinds / curtains',
    best: 'Temporary or budget covers on awkward shapes',
    watch: 'Often leave light gaps or hide the architecture',
  },
];

const processSteps = [
  { title: 'Home consultation', body: 'We visit with samples and look at how the arch is used — privacy, light and whether the top section should operate.', image: '/wp-content/uploads/2024/10/106shots_so.jpeg' },
  { title: 'Template & survey', body: 'Mark templates the shaped opening on site. Photos alone are not enough for a curved window.', image: '/images/mark-shutter-envy-van.png' },
  { title: 'Manufacturing', body: 'Your shutters are made to the template — shaped rails and panels, not a rectangular set forced into a curve.', image: imgs.living },
  { title: 'Professional installation', body: 'Our fitting team installs, adjusts every panel, and leaves the room tidy.', image: '/wp-content/uploads/2024/10/dotwall-Web-Design2024-10-07-at-14.08.01.jpeg' },
];
---
<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogImage={entry.data.ogImage}
  jsonLd={jsonLd}
>
  <section class="aws-hero" style={`background-image: url('${heroImage}')`}>
    <div class="aws-hero__overlay"></div>
    <div class="aws-hero__inner" data-reveal>
      <span class="aws-hero__eyebrow">Arched Window Shutters</span>
      <h1>{entry.data.h1}</h1>
      <p>Follow the curve of the glass. Made to measure, templated on site and professionally fitted across Leicester, Loughborough and Leicestershire.</p>
      <div class="aws-hero__actions">
        <a href="/contact/" class="aws-hero__btn" data-track={TRACK.productHeroCtas}>
          Arrange a Home Visit
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M3 7h8m0 0L7 3m4 4l-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href={`tel:${business.phoneTel}`} class="aws-hero__btn aws-hero__btn--ghost" data-track={TRACK.productHeroCtas}>Call {business.phoneDisplay}</a>
      </div>
    </div>
  </section>

  <section class="aws-intro container" data-reveal>
    <h2>Keep the arch. Dress it properly.</h2>
    <p>
      Arched windows are a feature — until someone hangs a rectangular blind that chops the curve or leaves light leaking around the edges. Made-to-measure arched shutters follow the glass so the architecture stays visible and the room still gets privacy and light control.
    </p>
    <p>
      We template and fit arched shutters across <a href="/locations/shutters-in-leicester/">Leicester</a>, <a href="/locations/shutters-in-loughborough/">Loughborough</a>, Melton Mowbray, Market Harborough and the surrounding villages. Every shaped opening is surveyed on site — never guessed from a photo alone.
    </p>
    <p class="aws-intro__links">
      <a href="/bespoke-arched-window-shutters-shutter-envy-leicestershire/">See a recent arched install →</a>
      <a href="/my-windows-arent-standard-size-can-i-still-get-shutters/">Unusual window shapes guide →</a>
    </p>
  </section>

  <FeatureChecklist
    heading="Why homeowners choose arched shutters"
    body="A shaped opening deserves a shaped solution — not a rectangular compromise."
    items={features}
    cta={{ label: 'Arrange a Home Visit', href: '/contact/' }}
    backgroundImage={heroImage}
  />

  <section class="aws-rooms" data-reveal>
    <div class="container">
      <header class="aws-rooms__header">
        <span class="aws-eyebrow">By opening</span>
        <h2>Where arched shutters work best</h2>
        <p>Any window with a curve or irregular top that you want to keep as a design feature.</p>
      </header>
      <ul class="aws-rooms__grid" data-reveal-children>
        {rooms.map((room) => (
          <li>
            <article class="aws-room-card">
              <img src={room.image} alt={room.alt} loading="lazy" />
              <div class="aws-room-card__body">
                <h3>{room.name}</h3>
                <p>{room.body}</p>
              </div>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="aws-compare">
    <div class="container" data-reveal>
      <header class="aws-compare__header">
        <span class="aws-eyebrow">Style comparison</span>
        <h2>Arched shutters vs rectangular vs café-style</h2>
        <p>This is the decision tree we walk through when the window is not a simple square.</p>
      </header>
      <div class="aws-compare__table-wrap">
        <table class="aws-compare__table">
          <thead>
            <tr>
              <th scope="col">Option</th>
              <th scope="col">Best for</th>
              <th scope="col">Trade-off</th>
            </tr>
          </thead>
          <tbody>
            {comparisons.map((row) => (
              <tr>
                <th scope="row">{row.style}</th>
                <td>{row.best}</td>
                <td>{row.watch}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="aws-compare__note">
        For typical UK fitted prices, see our <a href="/how-much-do-plantation-shutters-cost-a-complete-uk-price-guide/">plantation shutters cost guide</a>.
        For half-height street privacy on rectangular openings, see <a href="/cafe-style-shutters/">café-style shutters</a>.
        For material choices, start with <a href="/faux-wood-shutters/">faux wood</a>.
      </p>
    </div>
  </section>

  <ProcessTimeline
    heading="From template to <em>fitted</em>"
    subheading="Four steps — templated in your home, made to the curve, installed by our team."
    steps={processSteps}
  />

  <FAQ
    items={faqs}
    heading="Arched shutter questions answered"
    intro="Straight answers on templating, cost, lead times and how shaped shutters compare to rectangular sets."
    closingCta={{ label: 'Arrange a home visit', href: '/contact/', prompt: 'Got an arched window to template?' }}
    backgroundImage={imgs.hero}
  />

  <InlineCTA
    eyebrow="Free home survey"
    heading="See arched shutters templated in your home"
    body="Mark templates the opening, recommends the operating layout, and gives you a no-obligation fitted price — with a clear breakdown."
    cta={{ label: 'Arrange a Home Visit', href: '/contact/' }}
    secondaryCta={{ label: 'Browse all shutter styles', href: '/our-shutters/' }}
    tone="gold"
  />
</BaseLayout>

<style>
  .aws-eyebrow {
    display: inline-block;
    background: rgba(199,154,8,0.12);
    color: var(--color-gold-600);
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-pill);
    font-size: var(--text-link-12-700);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 1.25rem;
  }

  .aws-hero {
    position: relative;
    margin: 0 calc(50% - 50vw);
    padding: 5rem 1.25rem 5.5rem;
    background-color: var(--color-cream);
    background-size: cover;
    background-position: center;
    text-align: center;
    overflow: hidden;
  }
  .aws-hero__overlay {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(249,248,244,0.88) 0%, rgba(249,248,244,0.95) 100%);
  }
  .aws-hero__inner { position: relative; max-width: 48rem; margin: 0 auto; }
  .aws-hero__eyebrow {
    display: inline-block;
    background: rgba(199,154,8,0.12);
    color: var(--color-gold-600);
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-pill);
    font-size: var(--text-link-12-700);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 1.25rem;
  }
  .aws-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, var(--text-h2-60-500));
    font-weight: 500;
    line-height: 1.075;
    letter-spacing: -0.027em;
    margin: 0 0 1.5rem;
    text-wrap: balance;
  }
  .aws-hero p {
    color: var(--color-ink-soft);
    font-size: var(--text-large-body-19-400);
    line-height: 1.6;
    margin: 0 0 2rem;
    max-width: 36rem;
    margin-left: auto;
    margin-right: auto;
  }
  .aws-hero__actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .aws-hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.875rem;
    background: linear-gradient(180deg, var(--color-gold-400), var(--color-gold-600));
    color: #fff;
    border-radius: var(--radius-pill);
    font-weight: 500;
    font-size: var(--text-button-14-500);
    text-decoration: none;
    box-shadow: 0 12px 32px -8px rgba(199,154,8,0.55);
    transition: transform 200ms, filter 200ms;
  }
  .aws-hero__btn:hover { transform: translateY(-2px); filter: brightness(1.08); color: #fff; }
  .aws-hero__btn--ghost {
    background: #fff;
    color: var(--color-ink);
    border: 1px solid var(--color-line);
    box-shadow: var(--shadow-sm);
  }
  .aws-hero__btn--ghost:hover {
    border-color: var(--color-gold-400);
    color: var(--color-gold-600);
  }

  .aws-intro {
    max-width: 44rem;
    padding: 4rem 1.25rem 1rem;
    text-align: center;
  }
  .aws-intro h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, var(--text-h2-60-500));
    font-weight: 500;
    line-height: 1.075;
    margin: 0 0 1.5rem;
  }
  .aws-intro p {
    color: var(--color-ink-soft);
    font-size: var(--text-large-body-19-400);
    line-height: 1.6;
    margin: 0 auto 1rem;
    max-width: 40rem;
  }
  .aws-intro a { color: var(--color-gold-600); font-weight: 600; }
  .aws-intro__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    justify-content: center;
    margin-top: 1.5rem !important;
  }

  .aws-rooms {
    padding: 5rem 0;
    background: #fff;
  }
  .aws-rooms__header {
    text-align: center;
    max-width: 44rem;
    margin: 0 auto 3rem;
  }
  .aws-rooms__header h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, var(--text-h2-60-500));
    font-weight: 500;
    margin: 0 0 1rem;
  }
  .aws-rooms__header p {
    color: var(--color-ink-soft);
    font-size: var(--text-large-body-19-400);
    line-height: 1.6;
    margin: 0;
  }
  .aws-rooms__grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) { .aws-rooms__grid { grid-template-columns: repeat(2, 1fr); } }
  .aws-rooms__grid li { margin: 0; }
  .aws-room-card {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    height: 100%;
    display: flex;
    flex-direction: column;
    background: #fff;
    transition: transform 220ms, box-shadow 220ms, border-color 220ms;
  }
  .aws-room-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-gold-400);
  }
  .aws-room-card img {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    display: block;
  }
  .aws-room-card__body { padding: 1.5rem 1.75rem 1.75rem; }
  .aws-room-card h3 {
    font-family: var(--font-display);
    color: var(--color-gold-600);
    font-size: var(--text-h3-24-500);
    margin: 0 0 0.625rem;
  }
  .aws-room-card p {
    color: var(--color-ink-soft);
    font-size: var(--text-small-body-15-400);
    line-height: 1.65;
    margin: 0;
  }

  .aws-compare {
    padding: 5rem 0;
    background: var(--color-cream);
    margin: 0 calc(50% - 50vw);
  }
  .aws-compare__header {
    text-align: center;
    max-width: 44rem;
    margin: 0 auto 2.5rem;
  }
  .aws-compare__header h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, var(--text-h2-60-500));
    font-weight: 500;
    margin: 0 0 1rem;
  }
  .aws-compare__header p {
    color: var(--color-ink-soft);
    margin: 0;
    line-height: 1.6;
  }
  .aws-compare__table-wrap {
    overflow-x: auto;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: #fff;
    box-shadow: var(--shadow-sm);
  }
  .aws-compare__table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-small-body-15-400);
  }
  .aws-compare__table th,
  .aws-compare__table td {
    padding: 1rem 1.25rem;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--color-line);
  }
  .aws-compare__table thead th {
    background: rgba(199,154,8,0.08);
    font-family: var(--font-display);
    font-weight: 500;
  }
  .aws-compare__table tbody th {
    color: var(--color-gold-600);
    font-family: var(--font-display);
    font-weight: 500;
    white-space: nowrap;
  }
  .aws-compare__table tr:last-child th,
  .aws-compare__table tr:last-child td { border-bottom: none; }
  .aws-compare__note {
    text-align: center;
    margin: 1.75rem 0 0;
    color: var(--color-ink-soft);
    font-size: var(--text-body-16-400);
  }
  .aws-compare__note a { color: var(--color-gold-600); font-weight: 600; }
</style>
