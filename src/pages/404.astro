---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business } from '../data/site';
---
<BaseLayout
  title="Page Not Found | Shutter Envy"
  description="Sorry, the page you were looking for can't be found."
  noindex
>
  <section class="error-hero">
    <div class="error-hero__overlay"></div>
    <div class="error-hero__inner" data-reveal>
      <p class="error-hero__code">404</p>
      <h1>This Window's Shuttered</h1>
      <p class="error-hero__sub">We can't find the page you were looking for — it might have moved, or the link you followed might be wrong. Try one of these instead, or get in touch and we'll point you in the right direction.</p>

      <div class="error-hero__actions">
        <a href="/" class="error-hero__btn">
          Back to Home
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M3 7h8m0 0L7 3m4 4l-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href={`tel:${business.phoneTel}`} class="error-hero__phone">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M20 15.5c-1.25 0-2.45-.2-3.57-.57a1 1 0 0 0-1.02.24l-2.2 2.2a15.05 15.05 0 0 1-6.59-6.59l2.2-2.2a1 1 0 0 0 .25-1.01A11.36 11.36 0 0 1 8.5 4a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1c0 9.39 7.61 17 17 17a1 1 0 0 0 1-1v-3.5a1 1 0 0 0-1-1z"/></svg>
          Call {business.phoneDisplay}
        </a>
      </div>
    </div>
  </section>

  <section class="error-suggestions container" data-reveal>
    <h2>Or try one of these</h2>
    <ul data-reveal-children>
      <li>
        <a href="/our-shutters/">
          <h3>Our Shutters</h3>
          <p>Made-to-measure plantation shutters in hardwood, faux wood, ABS and aluminium.</p>
          <span>Explore shutters →</span>
        </a>
      </li>
      <li>
        <a href="/locations/">
          <h3>Where We Work</h3>
          <p>12 areas across Leicester &amp; Leicestershire — Loughborough, Melton Mowbray, Market Harborough and more.</p>
          <span>See locations →</span>
        </a>
      </li>
      <li>
        <a href="/news/">
          <h3>News &amp; Advice</h3>
          <p>Real projects, practical advice, and answers to the most-asked shutter questions.</p>
          <span>Read articles →</span>
        </a>
      </li>
      <li>
        <a href="/contact/">
          <h3>Get a Quote</h3>
          <p>Book a free home survey — Mark visits with samples and gives you a quote on the day.</p>
          <span>Arrange a visit →</span>
        </a>
      </li>
    </ul>
  </section>
</BaseLayout>

<style>
  .error-hero {
    position: relative;
    margin: 0 calc(50% - 50vw);
    padding: 6rem 1.25rem 5rem;
    background:
      url('/wp-content/uploads/2026/04/ChatGPT-Image-Apr-23-2026-04_37_13-PM.jpeg') center/cover no-repeat;
    overflow: hidden;
  }
  .error-hero__overlay {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(249,248,244,0.88), rgba(249,248,244,0.95));
  }
  .error-hero__inner {
    position: relative;
    max-width: 36rem;
    margin: 0 auto;
    text-align: center;
  }
  .error-hero__code {
    font-family: var(--font-display);
    font-size: clamp(5rem, 18vw, 12rem);
    line-height: 1;
    font-weight: 500;
    color: var(--color-gold-400);
    margin: 0 0 0.5rem;
    letter-spacing: -0.05em;
    text-shadow: 0 8px 24px rgba(199,154,8,0.25);
    background: linear-gradient(180deg, var(--color-gold-400), var(--color-gold-600));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .error-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, var(--text-h2-60-500));
    font-weight: 500;
    line-height: 1.075;
    letter-spacing: -0.027em;
    margin: 0 0 1rem;
  }
  .error-hero__sub {
    color: var(--color-ink-soft);
    font-size: var(--text-large-body-19-400);
    line-height: 1.6;
    margin: 0 0 2rem;
  }
  .error-hero__actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .error-hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.75rem;
    background: linear-gradient(180deg, var(--color-gold-400), var(--color-gold-600));
    color: #fff;
    border-radius: var(--radius-pill);
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: var(--text-button-14-500);
    letter-spacing: 0.02em;
    text-decoration: none;
    box-shadow: 0 12px 32px -8px rgba(199,154,8,0.55), inset 0 1px 0 rgba(255,255,255,0.2);
    transition: transform 200ms, filter 200ms;
  }
  .error-hero__btn:hover { transform: translateY(-2px); filter: brightness(1.08); color: #fff; }
  .error-hero__btn svg { transition: transform 200ms; }
  .error-hero__btn:hover svg { transform: translateX(3px); }
  .error-hero__phone {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.875rem 1.75rem;
    background: #fff;
    color: var(--color-ink);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: var(--text-button-14-500);
    letter-spacing: 0.02em;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition: all 200ms;
  }
  .error-hero__phone:hover {
    background: var(--color-cream);
    color: var(--color-gold-600);
    border-color: var(--color-gold-400);
  }
  .error-hero__phone svg { color: var(--color-gold-600); }

  /* ─── Suggestions ──────────────────────────────────────── */
  .error-suggestions {
    padding: 5rem 1.25rem;
    text-align: center;
    max-width: 64rem;
    margin: 0 auto;
  }
  .error-suggestions h2 {
    font-family: var(--font-display);
    font-size: var(--text-h2-30-500);
    font-weight: 500;
    letter-spacing: -0.027em;
    margin: 0 0 2.5rem;
  }
  .error-suggestions ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 768px) {
    .error-suggestions ul { grid-template-columns: repeat(2, 1fr); }
  }
  .error-suggestions li { margin: 0; }
  .error-suggestions a {
    display: block;
    padding: 1.5rem 1.75rem;
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    text-align: left;
    box-shadow: var(--shadow-sm);
    transition: transform 220ms, box-shadow 220ms, border-color 220ms;
  }
  .error-suggestions a:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-gold-400);
  }
  .error-suggestions h3 {
    font-family: var(--font-display);
    font-size: var(--text-h3-21-500);
    font-weight: 500;
    color: var(--color-gold-600);
    margin: 0 0 0.5rem;
  }
  .error-suggestions p {
    color: var(--color-ink-soft);
    font-size: var(--text-small-body-15-400);
    line-height: 1.6;
    margin: 0 0 0.875rem;
  }
  .error-suggestions span {
    color: var(--color-gold-600);
    font-size: var(--text-link-12-700);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: transform 200ms;
    display: inline-block;
  }
  .error-suggestions a:hover span { transform: translateX(3px); }
</style>
