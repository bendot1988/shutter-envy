---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeatureChecklist from '../../components/home/FeatureChecklist.astro';
import ProcessTimeline from '../../components/home/ProcessTimeline.astro';
import ReviewsRow from '../../components/home/ReviewsRow.astro';
import InlineCTA from '../../components/home/InlineCTA.astro';
import { faqPage, breadcrumbList, service } from '../../lib/schema';
import { TRACK } from '../../data/tracking';

const entry = await getEntry('pages', 'awnings');
if (!entry) throw new Error('Missing pages/awnings content entry');

const jsonLd: object[] = [
  breadcrumbList([
    { name: 'Home', url: '/' },
    { name: 'Awnings', url: '/awnings/' },
  ]),
  service({
    url: 'https://shutter-envy.co.uk/awnings/',
    name: 'Made-to-measure awnings',
    description: 'Puma, Tiger and Bobcat awnings supplied and installed by Shutter Envy across Leicester, Loughborough and Leicestershire.',
    serviceType: 'Retractable awnings',
  }),
];
if (entry.data.faqs?.length) jsonLd.push(faqPage(entry.data.faqs));

// ─── Locations — pulled from the locations collection ──
const locationEntries = await getCollection('locations');
const towns = locationEntries
  .map((l) => {
    const slug = l.id.replace(/\.md$/, '');
    const town = slug
      .replace(/^shutters-(in-)?/, '')
      .split('-')
      .map((w) => w === 'upon' ? 'upon' : w.charAt(0).toUpperCase() + w.slice(1))
      .join(' ');
    return { town, href: `/locations/${slug}/` };
  })
  .filter((t) => !/charnwood/i.test(t.town))
  .sort((a, b) => a.town.localeCompare(b.town));

// ─── Page-specific content ─────────────────────────────
const heroImage = '/images/awnings/puma.png';

const features = [
  { heading: 'Custom sizes and fabrics for a perfect fit',     body: '' },
  { heading: 'Motorised options for effortless operation',     body: '' },
  { heading: 'Sun and wind sensors for automatic adjustment',  body: '' },
  { heading: 'UV protection for you and your furniture',       body: '' },
  { heading: 'Energy efficiency through temperature regulation', body: '' },
  { heading: 'Expert installation with 5-star service',        body: '' },
];

const intro = {
  heading: 'Bespoke Awnings for Every Home',
  paragraphs: [
    'Shutter Envy supplies and fits made-to-measure awnings for homes across Leicester, Loughborough, Melton Mowbray and surrounding Leicestershire areas. Our awnings help create shade, improve outdoor comfort and make patios, garden seating areas and bifold doors more practical throughout the year.',
  ],
};

const models = [
  {
    name: 'Bobcat',
    tagline: 'Compact, classic, dependable',
    summary: 'A neat, robust folding-arm awning ideal for smaller patios and garden seating areas where you want shade on demand without dominating the façade.',
    image: '/images/awnings/bobcat.png',
    specs: [
      'Standard RAL colour: White (RAL 9010)',
      'Corrosion-resistant, powder-coated, extruded aluminium hardware, with stainless steel components',
      'Fully adjustable pitch settings from 15° to 66°',
      'Incorporating the ART 250 invisible arm tensioning system, providing greater strength and durability',
      'TUV quality marked, CE safety marked, complying with CEN standards',
      'Face-fix or top-fix installation options',
      'Mechanical gearbox or RTS Somfy Motor operation options',
      'Wind Class 2',
    ],
  },
  {
    name: 'Puma',
    tagline: 'Larger spans, premium engineering',
    summary: 'Our most-specified folding-arm awning. Engineered with reinforced cables for thousands of operations and built to cover wider openings, bifolds and bigger patios.',
    image: '/images/awnings/puma.png',
    specs: [
      'Standard RAL colour: White (RAL 9010)',
      'Corrosion-resistant, powder-coated, extruded aluminium hardware, with stainless steel components',
      'Fully adjustable pitch settings from 15° to 75°',
      '2 x 4mm tear resistant steel cables, guaranteeing at least 25,000 movements',
      'TUV quality marked, CE safety marked, complying with CEN standards',
      'Face-fix or top-fix installation options',
      'Mechanical gearbox or RTS Somfy Motor operation options',
      'Up to projection 2000mm, wind class 3; above 2000mm, wind class 2',
    ],
  },
  {
    name: 'Tiger',
    tagline: 'Architectural, contemporary, motorised',
    summary: 'A sleek, anthracite-finished awning designed for modern extensions and contemporary garden rooms. Motorised as standard, with optional integrated arm lighting.',
    image: '/images/awnings/tiger.png',
    specs: [
      'Standard RAL colour: Textured Anthracite (DB 703)',
      'Corrosion-resistant, powder-coated, extruded aluminium hardware, with stainless steel components',
      'Fully adjustable pitch settings from 6° to 60°',
      'Incorporating the SPLENDOR invisible arm tensioning system, providing greater strength and durability',
      'TUV quality marked, CE safety marked, complying with CEN standards',
      'Face-fix or top-fix installation options',
      'RTS Somfy Motor operation',
      'Wind Class 2',
      'Optional light can be installed in the arms, creating a lighter atmosphere beneath the awning',
    ],
  },
];

const reviews = [
  { name: 'Liz Twitchell',  rating: 5, date: '1 year ago',  body: "Top notch job by Mark and team yet again. From initial consultation to fitting — a totally professional, efficient and friendly experience." },
  { name: 'Wendy Harrison', rating: 5, date: '2 years ago', body: "I would like to thank Mark & Co at Shutter Envy. Their service is excellent. From the minute I contacted them they were helpful and professional." },
  { name: 'Sandra Mould',   rating: 5, date: '2 years ago', body: "Fantastic service from Mark. First class product. Excellent results. Fast, efficient and perfect. So pleased." },
];

const processSteps = [
  { title: 'Schedule a Home Visit',   body: "Book a time that suits you. We'll come to your home with brochures and fabric samples.", image: '/wp-content/uploads/2024/10/106shots_so.jpeg' },
  { title: 'On-Site Survey',          body: 'Mark assesses your wall, projection and shade pattern, then gives you a no-obligation quote on the day.', image: '/images/mark-shutter-envy-van.png' },
  { title: 'Manufacturing With Care', body: 'Your awning is made to order — cassette colour, fabric, motor and sensors all specced to your home.', image: '/wp-content/uploads/2024/09/5bc529c6-242f-4aab-8112-67d895fc7c43-1024x768.jpg' },
  { title: 'Professional Installation', body: 'Tidy install by our own team — secure wall fixing, motor commissioning and remote pairing.', image: '/wp-content/uploads/2024/10/dotwall-Web-Design2024-10-07-at-14.08.01.jpeg' },
  { title: 'Enjoy Your Outdoor Space', body: 'Full handover, user-guide and aftercare on installation day.', image: '/wp-content/uploads/2024/09/431555826_2629833587193609_4928996973115882659_n-300x169.jpg' },
];
---
<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogImage={entry.data.ogImage}
  jsonLd={jsonLd}
>
  {/* ─── HERO ────────────────────────────────────────────── */}
  <section class="awn-hero" style={`background-image: url('${heroImage}')`}>
    <div class="awn-hero__overlay"></div>
    <div class="awn-hero__inner" data-reveal>
      <span class="awn-hero__eyebrow">Outdoor Living</span>
      <h1>{entry.data.h1}</h1>
      <p>Made-to-measure patio and terrace awnings — designed, supplied and fitted by our family-run team across Leicestershire.</p>
      <div class="awn-hero__actions">
        <a href="/contact/" class="awn-hero__btn" data-track={TRACK.productHeroCtas}>
          Arrange a Home Visit
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M3 7h8m0 0L7 3m4 4l-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="tel:+447729572277" class="awn-hero__btn awn-hero__btn--ghost" data-track={TRACK.productHeroCtas}>Call 07729 572277</a>
      </div>
    </div>
  </section>

  {/* ─── INTRO — preserves original ranking copy ─────────── */}
  <section class="awn-intro container" data-reveal>
    <h2>{intro.heading}</h2>
    {intro.paragraphs.map((p) => <p>{p}</p>)}
  </section>

  {/* ─── FEATURE CHECKLIST ──────────────────────────────── */}
  <FeatureChecklist
    heading="Engineered for British Weather"
    body="Every awning we fit is bespoke to the opening, the wall and the way you use the space. Here's what's standard."
    items={features}
    cta={{ label: 'Arrange a Home Visit', href: '/contact/' }}
    backgroundImage={heroImage}
  />

  {/* ─── AWNING MODELS — alternating long-form rows ─────── */}
  <section class="awn-models" data-reveal>
    <div class="awn-models__inner container">
      <header>
        <span class="awn-eyebrow">Our Awning Range</span>
        <h2>Three Awning Models for Every Home</h2>
        <p>From compact patio shades to wide-span motorised systems, our three flagship awnings cover every garden, terrace and bifold setup.</p>
      </header>

      <ol class="awn-models__list" data-reveal-children>
        {models.map((m, i) => (
          <li class="awn-model" data-flip={i % 2 === 1 ? 'true' : 'false'}>
            <div class="awn-model__media">
              {m.image
                ? <img src={m.image} alt={`${m.name} awning by Shutter Envy`} loading="lazy" />
                : <div class="awn-placeholder" role="img" aria-label={`${m.name} awning — photo coming soon`}>
                    <svg viewBox="0 0 80 60" fill="none" aria-hidden="true">
                      <rect x="6" y="10" width="68" height="6" rx="1" stroke="currentColor" stroke-width="1.4"/>
                      <path d="M6 16 L18 40 L62 40 L74 16" stroke="currentColor" stroke-width="1.4" fill="none"/>
                      <line x1="14" y1="32" x2="66" y2="32" stroke="currentColor" stroke-width="0.7"/>
                      <line x1="22" y1="24" x2="58" y2="24" stroke="currentColor" stroke-width="0.7"/>
                    </svg>
                    <span>{m.name} photo coming soon</span>
                  </div>
              }
            </div>
            <div class="awn-model__body">
              <span class="awn-model__index">{String(i + 1).padStart(2, '0')}</span>
              <h3>{m.name}</h3>
              <p class="awn-model__tag">{m.tagline}</p>
              <p class="awn-model__summary">{m.summary}</p>
              <ul class="awn-model__specs">
                {m.specs.map((s) => <li>{s}</li>)}
              </ul>
              <a href="/contact/" class="awn-model__cta">
                Enquire about the {m.name}
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M3 7h8m0 0L7 3m4 4l-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ─── PROCESS TIMELINE ───────────────────────────────── */}
  <ProcessTimeline steps={processSteps} />

  {/* ─── WHERE WE INSTALL AWNINGS ───────────────────────── */}
  <section class="awn-locations" data-reveal>
    <div class="awn-locations__overlay"></div>
    <div class="awn-locations__inner container">
      <header>
        <span class="awn-locations__eyebrow">Coverage</span>
        <h2>Where We Install Awnings</h2>
        <p>We supply and fit made-to-measure awnings across Leicestershire — from Leicester city to the surrounding market towns and villages. Click your town for local details.</p>
      </header>
      <ul class="awn-locations__grid" data-reveal-children>
        {towns.map((t) => (
          <li>
            <a href={t.href} class="awn-location-card">
              <span class="awn-location-card__label">Awnings in</span>
              <span class="awn-location-card__town">{t.town}</span>
              <span class="awn-location-card__cta">
                View area
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M3 7h8m0 0L7 3m4 4l-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
      <p class="awn-locations__foot">
        Don't see your town? <a href="/contact/">Get in touch</a> — we cover most of Leicestershire.
      </p>
    </div>
  </section>

  {/* ─── REVIEWS ────────────────────────────────────────── */}
  <ReviewsRow
    heading="What Our Customers Say"
    rating="5.0"
    totalReviews="25"
    source="Google"
    link="https://www.google.com/maps/place/Shutter+Envy+Ltd/@52.7208272,-1.1413311,15z"
    reviews={reviews}
  />

  {/* ─── END CTA ────────────────────────────────────────── */}
  <InlineCTA
    eyebrow="Ready to Enjoy Your Garden?"
    heading="Book Your Free Awning Survey"
    body="Mark visits your home with fabric and frame samples, takes measurements, and gives you a no-obligation quote on the day."
    cta={{ label: 'Arrange a Home Visit', href: '/contact/' }}
    secondaryCta={{ label: 'Call 07729 572277', href: 'tel:+447729572277' }}
    tone="gold"
  />
</BaseLayout>

<style>
  .awn-eyebrow {
    display: inline-block;
    background: rgba(199,154,8,0.12);
    color: var(--color-gold-600);
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-pill);
    font-size: var(--text-link-12-700);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 1.25rem;
  }

  /* ─── HERO ────────────────────────────────────────────── */
  .awn-hero {
    position: relative;
    margin: 0 calc(50% - 50vw);
    padding: 5rem 1.25rem 5.5rem;
    background-color: var(--color-cream);
    background-size: cover;
    background-position: center;
    text-align: center;
    overflow: hidden;
  }
  .awn-hero__overlay {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(249,248,244,0.86) 0%, rgba(249,248,244,0.94) 100%);
  }
  .awn-hero__inner { position: relative; max-width: 48rem; margin: 0 auto; }
  .awn-hero__eyebrow {
    display: inline-block;
    background: rgba(199,154,8,0.12);
    color: var(--color-gold-600);
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-pill);
    font-size: var(--text-link-12-700);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 1.25rem;
  }
  .awn-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, var(--text-h2-60-500));
    font-weight: 500;
    line-height: 1.075;
    letter-spacing: -0.027em;
    margin: 0 0 1.5rem;
    text-wrap: balance;
  }
  .awn-hero p {
    color: var(--color-ink-soft);
    font-size: var(--text-large-body-19-400);
    line-height: 1.6;
    margin: 0 auto 2rem;
    max-width: 36rem;
  }
  .awn-hero__actions {
    display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap;
  }
  .awn-hero__btn {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.875rem 1.875rem;
    background: linear-gradient(180deg, var(--color-gold-400), var(--color-gold-600));
    color: #fff;
    border-radius: var(--radius-pill);
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: var(--text-button-14-500);
    letter-spacing: 0.02em;
    text-decoration: none;
    box-shadow: 0 12px 32px -8px rgba(199,154,8,0.55), inset 0 1px 0 rgba(255,255,255,0.2);
    transition: transform 200ms, filter 200ms;
  }
  .awn-hero__btn:hover { transform: translateY(-2px); filter: brightness(1.08); color: #fff; }
  .awn-hero__btn svg { transition: transform 200ms; }
  .awn-hero__btn:hover svg { transform: translateX(3px); }
  .awn-hero__btn--ghost {
    background: #fff;
    color: var(--color-ink);
    border: 1px solid var(--color-line);
    box-shadow: var(--shadow-sm);
  }
  .awn-hero__btn--ghost:hover {
    background: var(--color-cream);
    border-color: var(--color-gold-400);
    color: var(--color-gold-600);
  }

  /* ─── INTRO ──────────────────────────────────────────── */
  .awn-intro {
    max-width: 48rem;
    padding: 4rem 1.25rem 1rem;
    text-align: center;
  }
  .awn-intro h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, var(--text-h2-60-500));
    font-weight: 500;
    line-height: 1.075;
    letter-spacing: -0.027em;
    margin: 0 0 1.5rem;
    text-wrap: balance;
  }
  .awn-intro p {
    color: var(--color-ink-soft);
    font-size: var(--text-large-body-19-400);
    line-height: 1.6;
    margin: 0 auto 1rem;
    max-width: 40rem;
  }

  /* ─── MODELS ─────────────────────────────────────────── */
  .awn-models { padding: 6rem 0 5rem; background: #fff; }
  .awn-models__inner { padding: 0 1.25rem; }
  .awn-models header { text-align: center; max-width: 44rem; margin: 0 auto 4rem; }
  .awn-models h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, var(--text-h2-60-500));
    font-weight: 500;
    line-height: 1.075;
    letter-spacing: -0.027em;
    margin: 0 0 1rem;
  }
  .awn-models header p {
    color: var(--color-ink-soft);
    font-size: var(--text-large-body-19-400);
    line-height: 1.6;
    margin: 0;
  }
  .awn-models__list {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-direction: column;
    gap: 4rem;
  }
  .awn-model {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .awn-model { grid-template-columns: 5fr 7fr; gap: 3.5rem; }
    .awn-model[data-flip="true"] .awn-model__media { order: 2; }
    .awn-model[data-flip="true"] .awn-model__body  { order: 1; }
  }
  .awn-model__media {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    background: var(--color-cream);
    transition: transform 320ms cubic-bezier(0.16,1,0.3,1), box-shadow 320ms;
  }
  .awn-model__media:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
  .awn-model__media img,
  .awn-model__media > div {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    display: block;
  }
  .awn-model__body { position: relative; }
  .awn-model__index {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.875rem;
    color: var(--color-gold-600);
    background: rgba(199,154,8,0.1);
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-pill);
    margin: 0 0 0.875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
  }
  .awn-model__body h3 {
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 3.5vw, 2.5rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.027em;
    margin: 0 0 0.375rem;
    color: var(--color-ink);
  }
  .awn-model__tag {
    color: var(--color-gold-600);
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-h3-21-500);
    font-weight: 400;
    margin: 0 0 1.25rem;
  }
  .awn-model__summary {
    color: var(--color-ink-soft);
    font-size: var(--text-body-16-400);
    line-height: 1.7;
    margin: 0 0 1.5rem;
  }
  .awn-model__specs {
    list-style: none;
    padding: 1.25rem 1.5rem;
    margin: 0 0 1.75rem;
    background: var(--color-cream);
    border-radius: var(--radius-md);
    border-left: 3px solid var(--color-gold-400);
  }
  .awn-model__specs li {
    color: var(--color-ink-soft);
    font-size: 0.875rem;
    line-height: 1.6;
    padding-left: 1.5rem;
    margin: 0.5rem 0;
    position: relative;
  }
  .awn-model__specs li::before {
    content: "✓";
    position: absolute;
    left: 0;
    top: 0;
    color: var(--color-gold-600);
    font-weight: 700;
  }
  .awn-model__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: transparent;
    color: var(--color-gold-600);
    border: 1px solid var(--color-gold-400);
    border-radius: var(--radius-pill);
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: var(--text-button-14-500);
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: background 200ms, color 200ms, transform 200ms;
  }
  .awn-model__cta:hover {
    background: linear-gradient(180deg, var(--color-gold-400), var(--color-gold-600));
    color: #fff;
    transform: translateY(-2px);
  }
  .awn-model__cta svg { transition: transform 200ms; }
  .awn-model__cta:hover svg { transform: translateX(3px); }

  /* ─── Placeholder ─────────────────────────────────────── */
  .awn-placeholder {
    display: flex !important;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    color: var(--color-gold-600);
    background:
      repeating-linear-gradient(
        135deg,
        var(--color-cream) 0,
        var(--color-cream) 14px,
        rgba(199,154,8,0.05) 14px,
        rgba(199,154,8,0.05) 28px
      );
    text-align: center;
  }
  .awn-placeholder svg { width: 40%; height: auto; max-width: 80px; opacity: 0.55; }
  .awn-placeholder span {
    font-size: var(--text-link-12-700);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gold-600);
    opacity: 0.7;
  }

  /* ─── WHERE WE INSTALL AWNINGS ───────────────────────── */
  .awn-locations {
    position: relative;
    margin: 0 calc(50% - 50vw);
    padding: 6rem 1.25rem 5.5rem;
    background-color: #0c0c0c;
    background-image: url('/images/awnings/puma.png');
    background-size: cover;
    background-position: center;
    color: #fff;
    overflow: hidden;
  }
  .awn-locations__overlay {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(7,7,7,0.86) 0%, rgba(7,7,7,0.94) 100%);
  }
  .awn-locations__inner { position: relative; max-width: 72rem; margin: 0 auto; }
  .awn-locations header { text-align: center; max-width: 44rem; margin: 0 auto 3rem; }
  .awn-locations__eyebrow {
    display: inline-block;
    background: rgba(199,154,8,0.18);
    color: var(--color-gold-400);
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-pill);
    font-size: var(--text-link-12-700);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 1.25rem;
  }
  .awn-locations h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, var(--text-h2-60-500));
    font-weight: 500;
    line-height: 1.075;
    letter-spacing: -0.027em;
    margin: 0 0 1rem;
