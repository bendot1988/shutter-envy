---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeatureChecklist from '../../components/home/FeatureChecklist.astro';
import ProcessTimeline from '../../components/home/ProcessTimeline.astro';
import InlineCTA from '../../components/home/InlineCTA.astro';
import FAQ from '../../components/FAQ.astro';
import { business } from '../../data/site';
import { breadcrumbList, faqPage, service } from '../../lib/schema';
import { TRACK } from '../../data/tracking';

const entry = await getEntry('pages', 'aluminium-plantation-shutters');
if (!entry) throw new Error('Missing pages/aluminium-plantation-shutters content entry');

const faqs = entry.data.faqs ?? [];

const jsonLd: object[] = [
  breadcrumbList([
    { name: 'Home', url: '/' },
    { name: 'Our Shutters', url: '/our-shutters/' },
    { name: 'Aluminium Plantation Shutters', url: '/aluminium-plantation-shutters/' },
  ]),
  service({
    url: 'https://shutter-envy.co.uk/aluminium-plantation-shutters/',
    name: 'Aluminium plantation shutters',
    description: 'Made-to-measure aluminium plantation shutters — security-grade, heat and moisture resistant, professionally fitted across Leicester, Loughborough and Leicestershire.',
    serviceType: 'Aluminium plantation shutters',
  }),
];
if (faqs.length) jsonLd.push(faqPage(faqs));

const imgs = {
  living: '/wp-content/uploads/2025/02/S-CRAFT-Aluminium-Shutters-Living-Room-2-Satin-White-1024x670.jpg',
  kitchen: '/wp-content/uploads/2025/02/S-CRAFT-Aluminium-Shutters-Kitchen-2-Satin-White-1024x683.jpg',
  french: '/wp-content/uploads/2025/02/S-CRAFT-Aluminium-Shutters-Kitchen-4-Satin-White-1024x681.jpg',
  bedroom: '/wp-content/uploads/2025/02/Portchester-Bedroom-Security-Shutters-1024x961-1.jpg',
  colours: '/wp-content/uploads/2025/02/customisation-options-for-aluminium-shutters-1024x585.jpg',
  mh: '/wp-content/uploads/2026/01/d268a86f-90e6-43f0-8ab4-6155adc194ee-1024x768.jpg',
};

const heroImage = imgs.living;

const features = [
  { heading: 'Construction-grade extruded aluminium — not lightweight sheet', body: '' },
  { heading: 'Key-locking security on the Portchester range we fit', body: '' },
  { heading: 'Indifferent to heat, condensation and intense sun', body: '' },
  { heading: 'Typically £600–£1,400 per window fitted in 2026', body: '' },
  { heading: 'Looks like plantation shutters from across the room', body: '' },
  { heading: 'Surveyed, manufactured and fitted by our own team', body: '' },
];

const rooms = [
  {
    name: 'Conservatories & orangeries',
    body: 'Temperature swings and condensation destroy timber and stress faux wood. Aluminium does not warp, bow or fade — the strongest case for metal shutters in Leicestershire homes.',
    image: imgs.kitchen,
    alt: 'Satin-white aluminium plantation shutters in a UK kitchen-conservatory style setting',
  },
  {
    name: 'Patio & French doors',
    body: 'Ground-floor glass is a security weak point. Aluminium panels with key locks give privacy and light control without looking like bars or roller shutters.',
    image: imgs.french,
    alt: 'Aluminium plantation shutters on a wide kitchen opening with French-door style glazing',
  },
  {
    name: 'Ground-floor bedrooms & side returns',
    body: 'Accessible windows on the side of the house often justify aluminium even when the rest of the house is faux wood — security without an industrial look.',
    image: imgs.bedroom,
    alt: 'Portchester aluminium security shutters fitted in a bedroom',
  },
  {
    name: 'South-facing & statement rooms',
    body: 'Intense summer sun cups some faux wood over years. Aluminium holds shape, and deeper colours like anthracite read as a deliberate contemporary finish.',
    image: imgs.mh,
    alt: 'Portchester aluminium shutters fitted in a Market Harborough home',
  },
];

const comparisons = [
  {
    style: 'Aluminium plantation',
    best: 'Conservatories, security openings, intense sun, worst condensation',
    watch: 'About 2× faux wood — wrong as a whole-house default',
  },
  {
    style: 'Faux wood',
    best: 'Most UK rooms — value, moisture resistance, low maintenance',
    watch: 'Not a security product; can struggle in extreme heat',
  },
  {
    style: 'Hardwood',
    best: 'Dry living rooms wanting timber warmth',
    watch: 'Avoid steamy rooms and high-sun conservatories',
  },
  {
    style: 'Roller shutters',
    best: 'External lock-down on shops or rear extensions',
    watch: 'Different product — not the indoor plantation look',
  },
];

const processSteps = [
  { title: 'Home consultation', body: 'We visit with aluminium and faux wood samples so you can feel the difference in your own light — and only quote metal where it earns its place.', image: '/wp-content/uploads/2024/10/106shots_so.jpeg' },
  { title: 'Survey & material advice', body: 'Mark measures every opening and recommends aluminium room by room — not one premium forced across the whole house.', image: '/images/mark-shutter-envy-van.png' },
  { title: 'Manufacturing', body: 'Your shutters are extruded and powder-coated to order in the colour and lock layout you choose.', image: imgs.colours },
  { title: 'Professional installation', body: 'Our fitting team installs, adjusts every panel, and leaves the room tidy.', image: '/wp-content/uploads/2024/10/dotwall-Web-Design2024-10-07-at-14.08.01.jpeg' },
];
---
<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogImage={entry.data.ogImage}
  jsonLd={jsonLd}
>
  <section class="aps-hero" style={`background-image: url('${heroImage}')`}>
    <div class="aps-hero__overlay"></div>
    <div class="aps-hero__inner" data-reveal>
      <span class="aps-hero__eyebrow">Aluminium Plantation Shutters</span>
      <h1>{entry.data.h1}</h1>
      <p>Security, heat and moisture resistance dressed as plantation shutters. Made to measure and professionally fitted across Leicester, Loughborough and Leicestershire.</p>
      <div class="aps-hero__actions">
        <a href="/contact/" class="aps-hero__btn" data-track={TRACK.productHeroCtas}>
          Arrange a Home Visit
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M3 7h8m0 0L7 3m4 4l-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href={`tel:${business.phoneTel}`} class="aps-hero__btn aps-hero__btn--ghost" data-track={TRACK.productHeroCtas}>Call {business.phoneDisplay}</a>
      </div>
    </div>
  </section>

  <section class="aps-intro container" data-reveal>
    <h2>The plantation look. Built for the hard rooms.</h2>
    <p>
      Aluminium plantation shutters look like ordinary shutters from across the room. Up close they are a different product — construction-grade extruded aluminium with a powder-coat finish, key locks, and no centre tilt rod. They cost about twice as much as [faux wood](/faux-wood-shutters/), and they only earn that premium in the openings that punish everything else.
    </p>
    <p>
      We fit aluminium plantation shutters across <a href="/locations/shutters-in-leicester/">Leicester</a>, <a href="/locations/shutters-in-loughborough/">Loughborough</a>, Melton Mowbray, Market Harborough and the surrounding villages. Most projects mix aluminium on two or three openings with faux wood everywhere else.
    </p>
    <p class="aps-intro__links">
      <a href="/are-aluminium-shutters-worth-it-uk-buyers-guide/">Read the honest aluminium guide →</a>
      <a href="/portchester-aluminium-shutters-leicester/">See the Portchester® range →</a>
    </p>
  </section>

  <FeatureChecklist
    heading="Why homeowners choose aluminium"
    body="A premium plantation shutter for the rooms where wood and faux wood eventually fail."
    items={features}
    cta={{ label: 'Arrange a Home Visit', href: '/contact/' }}
    backgroundImage={heroImage}
  />

  <section class="aps-rooms" data-reveal>
    <div class="container">
      <header class="aps-rooms__header">
        <span class="aps-eyebrow">By opening</span>
        <h2>Where aluminium shutters earn their premium</h2>
        <p>Not every window needs aluminium. These are the openings where we recommend it most often.</p>
      </header>
      <ul class="aps-rooms__grid" data-reveal-children>
        {rooms.map((room) => (
          <li>
            <article class="aps-room-card">
              <img src={room.image} alt={room.alt} loading="lazy" />
              <div class="aps-room-card__body">
                <h3>{room.name}</h3>
                <p>{room.body}</p>
              </div>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="aps-compare">
    <div class="container" data-reveal>
      <header class="aps-compare__header">
        <span class="aps-eyebrow">Material comparison</span>
        <h2>Aluminium vs faux wood vs hardwood vs roller</h2>
        <p>This is the decision tree we walk through on every survey — room by room, not one blanket answer.</p>
      </header>
      <div class="aps-compare__table-wrap">
        <table class="aps-compare__table">
          <thead>
            <tr>
              <th scope="col">Option</th>
              <th scope="col">Best for</th>
              <th scope="col">Trade-off</th>
            </tr>
          </thead>
          <tbody>
            {comparisons.map((row) => (
              <tr>
                <th scope="row">{row.style}</th>
                <td>{row.best}</td>
                <td>{row.watch}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="aps-compare__note">
        For typical UK fitted prices, see our <a href="/how-much-do-plantation-shutters-cost-a-complete-uk-price-guide/">plantation shutters cost guide</a>.
        For the everyday material, start with <a href="/faux-wood-shutters/">faux wood shutters</a>.
        For French-door layouts, see <a href="/plantation-shutters-for-french-doors-uk-buyers-guide/">shutters for French doors</a>.
      </p>
    </div>
  </section>

  <ProcessTimeline
    heading="From survey to <em>fitted</em>"
    subheading="Four steps — measured in your home, made to order, installed by our team."
    steps={processSteps}
  />

  <FAQ
    items={faqs}
    heading="Aluminium shutter questions answered"
    intro="Straight answers on cost, security, roller-shutter confusion and when aluminium is actually worth it."
    closingCta={{ label: 'Arrange a home visit', href: '/contact/', prompt: 'Want aluminium and faux wood samples side by side?' }}
    backgroundImage={imgs.living}
  />

  <InlineCTA
    eyebrow="Free home survey"
    heading="See aluminium shutters in your room"
    body="Mark brings samples, recommends aluminium only where it earns the premium, and gives you a no-obligation fitted price — with a clear breakdown against faux wood."
    cta={{ label: 'Arrange a Home Visit', href: '/contact/' }}
    secondaryCta={{ label: 'Browse all shutter styles', href: '/our-shutters/' }}
    tone="gold"
  />
</BaseLayout>

<style>
  .aps-eyebrow {
    display: inline-block;
    background: rgba(199,154,8,0.12);
    color: var(--color-gold-600);
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-pill);
    font-size: var(--text-link-12-700);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 1.25rem;
  }

  .aps-hero {
    position: relative;
    margin: 0 calc(50% - 50vw);
    padding: 5rem 1.25rem 5.5rem;
    background-color: var(--color-cream);
    background-size: cover;
    background-position: center;
    text-align: center;
    overflow: hidden;
  }
  .aps-hero__overlay {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(249,248,244,0.88) 0%, rgba(249,248,244,0.95) 100%);
  }
  .aps-hero__inner { position: relative; max-width: 48rem; margin: 0 auto; }
  .aps-hero__eyebrow {
    display: inline-block;
    background: rgba(199,154,8,0.12);
    color: var(--color-gold-600);
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-pill);
    font-size: var(--text-link-12-700);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 1.25rem;
  }
  .aps-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, var(--text-h2-60-500));
    font-weight: 500;
    line-height: 1.075;
    letter-spacing: -0.027em;
    margin: 0 0 1.5rem;
    text-wrap: balance;
  }
  .aps-hero p {
    color: var(--color-ink-soft);
    font-size: var(--text-large-body-19-400);
    line-height: 1.6;
    margin: 0 0 2rem;
    max-width: 36rem;
    margin-left: auto;
    margin-right: auto;
  }
  .aps-hero__actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .aps-hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.875rem;
    background: linear-gradient(180deg, var(--color-gold-400), var(--color-gold-600));
    color: #fff;
    border-radius: var(--radius-pill);
    font-weight: 500;
    font-size: var(--text-button-14-500);
    text-decoration: none;
    box-shadow: 0 12px 32px -8px rgba(199,154,8,0.55);
    transition: transform 200ms, filter 200ms;
  }
  .aps-hero__btn:hover { transform: translateY(-2px); filter: brightness(1.08); color: #fff; }
  .aps-hero__btn--ghost {
    background: #fff;
    color: var(--color-ink);
    border: 1px solid var(--color-line);
    box-shadow: var(--shadow-sm);
  }
  .aps-hero__btn--ghost:hover {
    border-color: var(--color-gold-400);
    color: var(--color-gold-600);
  }

  .aps-intro {
    max-width: 44rem;
    padding: 4rem 1.25rem 1rem;
    text-align: center;
  }
  .aps-intro h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, var(--text-h2-60-500));
    font-weight: 500;
    line-height: 1.075;
    margin: 0 0 1.5rem;
  }
  .aps-intro p {
    color: var(--color-ink-soft);
    font-size: var(--text-large-body-19-400);
    line-height: 1.6;
    margin: 0 auto 1rem;
    max-width: 40rem;
  }
  .aps-intro a { color: var(--color-gold-600); font-weight: 600; }
  .aps-intro__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    justify-content: center;
    margin-top: 1.5rem !important;
  }

  .aps-rooms {
    padding: 5rem 0;
    background: #fff;
  }
  .aps-rooms__header {
    text-align: center;
    max-width: 44rem;
    margin: 0 auto 3rem;
  }
  .aps-rooms__header h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, var(--text-h2-60-500));
    font-weight: 500;
    margin: 0 0 1rem;
  }
  .aps-rooms__header p {
    color: var(--color-ink-soft);
    font-size: var(--text-large-body-19-400);
    line-height: 1.6;
    margin: 0;
  }
  .aps-rooms__grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) { .aps-rooms__grid { grid-template-columns: repeat(2, 1fr); } }
  .aps-rooms__grid li { margin: 0; }
  .aps-room-card {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    height: 100%;
    display: flex;
    flex-direction: column;
    background: #fff;
    transition: transform 220ms, box-shadow 220ms, border-color 220ms;
  }
  .aps-room-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-gold-400);
  }
  .aps-room-card img {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    display: block;
  }
  .aps-room-card__body { padding: 1.5rem 1.75rem 1.75rem; }
  .aps-room-card h3 {
    font-family: var(--font-display);
    color: var(--color-gold-600);
    font-size: var(--text-h3-24-500);
    margin: 0 0 0.625rem;
  }
  .aps-room-card p {
    color: var(--color-ink-soft);
    font-size: var(--text-small-body-15-400);
    line-height: 1.65;
    margin: 0;
  }

  .aps-compare {
    padding: 5rem 0;
    background: var(--color-cream);
    margin: 0 calc(50% - 50vw);
  }
  .aps-compare__header {
    text-align: center;
    max-width: 44rem;
    margin: 0 auto 2.5rem;
  }
  .aps-compare__header h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, var(--text-h2-60-500));
    font-weight: 500;
    margin: 0 0 1rem;
  }
  .aps-compare__header p {
    color: var(--color-ink-soft);
    margin: 0;
    line-height: 1.6;
  }
  .aps-compare__table-wrap {
    overflow-x: auto;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: #fff;
    box-shadow: var(--shadow-sm);
  }
  .aps-compare__table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-small-body-15-400);
  }
  .aps-compare__table th,
  .aps-compare__table td {
    padding: 1rem 1.25rem;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--color-line);
  }
  .aps-compare__table thead th {
    background: rgba(199,154,8,0.08);
    font-family: var(--font-display);
    font-weight: 500;
  }
  .aps-compare__table tbody th {
    color: var(--color-gold-600);
    font-family: var(--font-display);
    font-weight: 500;
    white-space: nowrap;
  }
  .aps-compare__table tr:last-child th,
  .aps-compare__table tr:last-child td { border-bottom: none; }
  .aps-compare__note {
    text-align: center;
    margin: 1.75rem 0 0;
    color: var(--color-ink-soft);
    font-size: var(--text-body-16-400);
  }
  .aps-compare__note a { color: var(--color-gold-600); font-weight: 600; }
</style>
