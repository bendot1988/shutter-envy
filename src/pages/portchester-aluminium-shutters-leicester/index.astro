---
import { getEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ClearLineForm from '../../components/ClearLineForm.astro';
import MarqueeGallery from '../../components/MarqueeGallery.astro';
import AwardsCTABox from '../../components/home/AwardsCTABox.astro';
import InlineCTA from '../../components/home/InlineCTA.astro';
import { business } from '../../data/site';
import { breadcrumbList } from '../../lib/schema';

const entry = await getEntry('pages', 'portchester-aluminium-shutters-leicester');
if (!entry) throw new Error('Missing pages/portchester-aluminium-shutters-leicester content entry');

const jsonLd = [
  breadcrumbList([
    { name: 'Home', url: '/' },
    { name: 'Portchester® Aluminium Shutters', url: '/portchester-aluminium-shutters-leicester/' },
  ]),
];

// Risk-framing — verbatim questions + supporting context + stat hooks
const risks = [
  {
    stat: '21%',
    statLabel: 'up',
    question: 'Burglaries are up 21% in the UK',
    support: 'Aluminium shutters add a patented Italian locking system to every window — engineered to resist forced entry.',
    icon: 'shield' as const,
  },
  {
    stat: '12m',
    statLabel: 'avg empty',
    question: 'Do you spend long periods away?',
    support: 'Empty homes are targeted twice as often. Shutters look closed and secure even when you\'re not in.',
    icon: 'clock' as const,
  },
  {
    stat: '8/10',
    statLabel: 'entry points',
    question: 'How many vulnerable windows do you have?',
    support: 'Most burglars enter through a ground-floor window. Audit each one — aluminium shutters protect them all.',
    icon: 'home' as const,
  },
];

// Related blog posts — anything Portchester or Aluminium themed
const allBlog = await getCollection('blog');
const relatedPosts = allBlog
  .filter((p) => {
    const slug = p.id.toLowerCase();
    const title = (p.data.h1 ?? p.data.title).toLowerCase();
    return slug.includes('portchester') || slug.includes('aluminium')
        || title.includes('portchester') || title.includes('aluminium');
  })
  .sort((a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate));

// 8 feature cards (verbatim copy)
const features = [
  { icon: 'lock',    heading: 'Enhanced Security',         body: 'Intruder-resistant with a patented lock system for peace of mind.' },
  { icon: 'design',  heading: 'Elegant Design',            body: 'Blends seamlessly with any interior, maintaining the classic plantation shutter look.' },
  { icon: 'weather', heading: 'Durable & Weatherproof',    body: 'Made from architectural-grade aluminium, perfect for both indoor and outdoor use.' },
  { icon: 'eye',     heading: 'Privacy & Light Control',   body: 'Adjustable louvres allow natural light while keeping your space private.' },
  { icon: 'spark',   heading: 'Low Maintenance',           body: 'Rust and corrosion-resistant, designed for long-lasting performance.' },
  { icon: 'fit',     heading: 'Versatile Fit',             body: 'Available in full height, tier-on-tier, and track options to suit any window or door.' },
  { icon: 'wind',    heading: 'Improved Airflow',          body: 'Keep windows open while staying secure, ideal for warm nights.' },
  { icon: 'palette', heading: 'Custom Colours',            body: 'Choose from a range of finishes to match your style.' },
];

// Aluminium technical specs — now with proper headings + supporting copy.
// Original short labels preserved as the heading for SEO continuity.
const specs = [
  {
    heading: 'Architectural Grade Aluminium',
    body: 'The same alloy used in commercial buildings and security doors — lightweight, exceptionally strong, and built to outlast any timber alternative without warping or cracking.',
    icon: 'shield' as const,
  },
  {
    heading: 'Indoor & Outdoor Solution',
    body: 'Engineered for British weather. Fit them in bathrooms, conservatories, even external openings — Portchester® won\'t warp, rust, fade or rot. One range, every room.',
    icon: 'weather' as const,
  },
  {
    heading: '4 Colour Choices + Custom',
    body: 'Choose from four standard powder-coated finishes — or specify any RAL colour to match your existing decor exactly. A flawless, factory-baked surface every time.',
    icon: 'palette' as const,
  },
  {
    heading: 'CE Certified',
    body: 'Independently tested and certified to European standards for structural performance and safety. Compliant for residential, commercial and listed properties.',
    icon: 'check' as const,
  },
  {
    heading: 'Silent Tilt — No Visible Tilt Bar',
    body: 'Louvres adjust on a smooth, invisible internal mechanism — no clunky front-facing rod cluttering the design. Pure plantation-shutter elegance, modernised.',
    icon: 'spark' as const,
  },
  {
    heading: 'Patented Italian Locking System',
    body: 'Integrated multi-point lock engineered in Italy and patented by Portchester®. Resists forced entry from outside while remaining fully usable from inside.',
    icon: 'lock' as const,
  },
];

// Shutter styles — vertical alternating cards (verbatim copy + images)
const styles = [
  {
    name: 'Bay Window Shutters',
    paragraphs: [
      'Perfect bay window shutters make the most of the natural light and privacy. Window shutters maximise the space inside your room while adding a layer of insulation.',
      'The size of a bay window allows for various shutter designs, from café-style shutters to full-height shutters.',
    ],
    bullets: ['Add value to your home', 'Reduce energy bills', 'Privacy control', 'Add insulation'],
    image: '/wp-content/uploads/2025/02/bay-window-shutters-for-your-home-1024x525.jpg',
  },
  {
    name: 'Full Height Shutters',
    paragraphs: [
      'Made-to-measure full height shutters are one of the most popular shutter styles we supply and install.',
      'Full height shutters cover the entire window — but a well-placed mid-rail can be added to create a feature that will match your window style. As well as stunning good looks, hardwood shutters bring many advantages to your home.',
    ],
    bullets: ['Reduce energy bills', 'Outstanding light and privacy', 'Easy to maintain and clean', 'Added kerb appeal'],
    image: '/wp-content/uploads/2025/02/Full-Height-scaled-1-1024x677.jpg',
  },
  {
    name: 'Tier-on-Tier Shutters',
    paragraphs: [
      'Tier on tier plantation shutters offer flexible control over privacy and light — with separate top and bottom sections these hardwood shutters can be adjusted or closed independently.',
      'If you want maximum light through the day and absolute privacy at night, a tier on tier shutter style could be perfect for your property.',
    ],
    bullets: ['Maximise the light', 'Privacy at eye level', 'Added kerb appeal', 'Great for Victorian window types'],
    image: '/wp-content/uploads/2025/02/Tier-on-Tier-1024x715.jpg',
  },
  {
    name: 'Cafe Style Shutters',
    paragraphs: [
      'Café style shutters fit the lower half of your window, allowing maximum light while completely controlling privacy.',
    ],
    bullets: ['Perfect solution for light control', 'Complete privacy for bay windows', 'More space for window features', 'Look great in kitchens and bathrooms'],
    image: '/wp-content/uploads/2025/02/Cafe-Style-Shutters-scaled-1-1024x768.jpg',
  },
  {
    name: 'Solid Panel Shutters',
    paragraphs: [
      'Solid shutters offer a simple, traditional look — swapping the louvres for solid premium wood.',
      'Since there are no slats, this style needs to be opened fully to let the light flood in — but offers absolute privacy and creates a snug atmosphere when closed.',
    ],
    bullets: ['Ideal for period properties', 'Premium hardwood panels', 'Adds insulation', 'Offers complete privacy'],
    image: '/wp-content/uploads/2025/02/solid-shutters-1024x768.jpg',
  },
];

// Marquee — recent Portchester / aluminium / shutter installs
const marqueeImages = [
  { src: '/wp-content/uploads/2025/02/S-CRAFT-Aluminium-Shutters-Kitchen-2-Satin-White-1024x683.jpg', alt: 'S-Craft aluminium shutters in a satin-white kitchen' },
  { src: '/wp-content/uploads/2025/02/Images-from-American-Shutters-low-res-43-1024x799-1.jpg',     alt: 'Portchester aluminium shutters fitted to a home interior' },
  { src: '/wp-content/uploads/2025/02/Images-from-American-Shutters-low-res-43-1024x799-2.jpg',     alt: 'Portchester aluminium shutters — close-up detail' },
  { src: '/wp-content/uploads/2025/02/bay-window-shutters-for-your-home-1024x525.jpg',              alt: 'Bay window shutters in a Leicestershire home' },
  { src: '/wp-content/uploads/2025/02/Full-Height-scaled-1-1024x677.jpg',                            alt: 'Full-height shutters in a living room' },
  { src: '/wp-content/uploads/2025/02/Tier-on-Tier-1024x715.jpg',                                    alt: 'Tier-on-tier shutters in a period home' },
  { src: '/wp-content/uploads/2025/02/Cafe-Style-Shutters-scaled-1-1024x768.jpg',                    alt: 'Café-style shutters in a kitchen' },
  { src: '/wp-content/uploads/2025/02/solid-shutters-1024x768.jpg',                                  alt: 'Solid panel shutters in a kitchen' },
];

// Locations to surface at the bottom (Portchester serves all areas)
const allLocations = (await getCollection('locations'))
  .sort((a, b) => a.data.area.localeCompare(b.data.area))
  .slice(0, 6);

// Icon registry (inlined SVGs)
const icon = {
  shield:  '<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>',
  clock:   '<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>',
  home:    '<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M12 3 2 12h3v8h6v-6h2v6h6v-8h3z"/></svg>',
  lock:    '<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M18 8h-1V6a5 5 0 1 0-10 0v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zM9 6a3 3 0 1 1 6 0v2H9V6zm9 14H6V10h12v10zm-6-3a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"/></svg>',
  design:  '<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg>',
  weather: '<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M19.35 10.04A7.49 7.49 0 0 0 12 4C9.11 4 6.6 5.64 5.35 8.04A5.994 5.994 0 0 0 0 14a6 6 0 0 0 6 6h13a5 5 0 0 0 .35-9.96z"/></svg>',
  eye:     '<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zm0 12.5a5 5 0 1 1 0-10 5 5 0 0 1 0 10zm0-8a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"/></svg>',
  spark:   '<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M9 11H7v9a2 2 0 0 0 2 2h9v-2H9V11zm12 0V9h-2V7h2V5h-2V3h-2v2h-2v2h2v2h2v2h2zM4 7h2V5H4V3H2v2H0v2h2v2h2V7z"/></svg>',
  fit:     '<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M19 3h-4.18C14.4 1.84 13.3 1 12 1c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2zm5 16H7v-2h10v2zm0-4H7v-2h10v2zm0-4H7V9h10v2z"/></svg>',
  wind:    '<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M14.5 17c0 1.65-1.35 3-3 3s-3-1.35-3-3h2c0 .55.45 1 1 1s1-.45 1-1-.45-1-1-1H2v-2h9.5c1.65 0 3 1.35 3 3zM19 6.5C19 4.57 17.43 3 15.5 3S12 4.57 12 6.5h2C14 5.67 14.67 5 15.5 5S17 5.67 17 6.5 16.33 8 15.5 8H2v2h13.5C17.43 10 19 8.43 19 6.5zm-.5 4.5H2v2h16.5c1.38 0 2.5 1.12 2.5 2.5S19.88 18 18.5 18v2c2.48 0 4.5-2.02 4.5-4.5S20.98 11 18.5 11z"/></svg>',
  palette: '<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M12 2C6.49 2 2 6.49 2 12s4.49 10 10 10c1.38 0 2.5-1.12 2.5-2.5 0-.61-.23-1.2-.64-1.67-.08-.1-.13-.21-.13-.33 0-.28.22-.5.5-.5H16c3.31 0 6-2.69 6-6 0-4.96-4.49-9-10-9zm5.5 11c-.83 0-1.5-.67-1.5-1.5S16.67 10 17.5 10s1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm-3-4C13.67 9 13 8.33 13 7.5S13.67 6 14.5 6s1.5.67 1.5 1.5S15.33 9 14.5 9zM5 11.5C5 10.67 5.67 10 6.5 10s1.5.67 1.5 1.5S7.33 13 6.5 13 5 12.33 5 11.5zm6-4C11 6.67 10.33 6 9.5 6S8 6.67 8 7.5 8.67 9 9.5 9s1.5-.67 1.5-1.5z"/></svg>',
};
---
<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogImage={entry.data.ogImage}
  jsonLd={jsonLd}
>
  {/* ─── HERO ────────────────────────────────────────────── */}
  <section
    class="pa-hero"
    style="background-image: url('/wp-content/uploads/2025/02/Images-from-American-Shutters-low-res-43-1024x799-1.jpg')"
  >
    <div class="pa-hero__overlay"></div>
    <div class="pa-hero__grid container">
      <div class="pa-hero__copy" data-reveal="left">
        <span class="pa-hero__eyebrow">★ Premium Range</span>
        <h1>Portchester<sup>®</sup> <em>Aluminium</em> Shutters</h1>
        <p>The premium aluminium shutter range with the strength to match the style. Maximum security and weather protection — without losing the plantation look — for homes across <strong>Leicester</strong>, <strong>Loughborough</strong> and <strong>Leicestershire</strong>.</p>
        <div class="pa-hero__actions">
          <a href="/contact/" class="pa-hero__btn">
            Arrange a Home Visit
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M3 7h8m0 0L7 3m4 4l-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <a href={`tel:${business.phoneTel}`} class="pa-hero__phone">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M20 15.5c-1.25 0-2.45-.2-3.57-.57a1 1 0 0 0-1.02.24l-2.2 2.2a15.05 15.05 0 0 1-6.59-6.59l2.2-2.2a1 1 0 0 0 .25-1.01A11.36 11.36 0 0 1 8.5 4a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1c0 9.39 7.61 17 17 17a1 1 0 0 0 1-1v-3.5a1 1 0 0 0-1-1z"/></svg>
            Call {business.phoneDisplay}
          </a>
        </div>
      </div>
      <div class="pa-hero__badge" data-reveal="right">
        <img src="/wp-content/uploads/2024/08/Portchester-Certified-Partner-768x769.png" alt="Portchester Certified Partner" loading="eager" />
      </div>
    </div>
  </section>

  {/* ─── RISK FRAMING (dynamic) ──────────────────────────── */}
  <section class="pa-risk" data-reveal>
    <div class="container">
      <header>
        <span class="pa-eyebrow">Why Aluminium?</span>
        <h2>Is Your Home As Secure <em>As It Could Be?</em></h2>
        <p>Three questions every Leicestershire homeowner should ask before the next dark night.</p>
      </header>
      <ul class="pa-risk__grid" data-reveal-children>
        {risks.map((r, i) => (
          <li class="pa-risk-card" style={`--i: ${i};`}>
            <div class="pa-risk-card__top">
              <span class="pa-risk-card__num">{(i + 1).toString().padStart(2, '0')}</span>
              <span class="pa-risk-card__icon" aria-hidden="true" set:html={icon[r.icon]} />
            </div>
            <div class="pa-risk-card__stat">
              <span class="pa-risk-card__stat-value">{r.stat}</span>
              <span class="pa-risk-card__stat-label">{r.statLabel}</span>
            </div>
            <p class="pa-risk-card__q">{r.question}</p>
            <p class="pa-risk-card__support">{r.support}</p>
          </li>
        ))}
      </ul>
      <div class="pa-risk__cta">
        <a href="/contact/" class="pa-risk__btn">
          Book a Free On-Site Visit
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M3 7h8m0 0L7 3m4 4l-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

      {/* Related blog posts on Aluminium / Portchester */}
      {relatedPosts.length > 0 && (
        <div class="pa-risk__reads" data-reveal>
          <header class="pa-risk__reads-head">
            <span class="pa-eyebrow">Further reading</span>
            <h3>More on Aluminium Shutters &amp; Home Security</h3>
          </header>
          <ul class="pa-risk__reads-grid" data-reveal-children>
            {relatedPosts.map((post) => (
              <li>
                <a href={`/${post.id}/`} class="pa-risk-read">
                  {post.data.heroImage && (
                    <span class="pa-risk-read__image">
                      <img src={post.data.heroImage} alt={post.data.h1 ?? post.data.title} loading="lazy" />
                    </span>
                  )}
                  <span class="pa-risk-read__body">
                    <span class="pa-risk-read__meta">
                      <time datetime={post.data.pubDate.toISOString()}>
                        {post.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
                      </time>
                      <span aria-hidden="true">·</span>
                      <span>{post.data.author}</span>
                    </span>
                    <span class="pa-risk-read__title">{post.data.h1 ?? post.data.title}</span>
                    {post.data.excerpt && <span class="pa-risk-read__excerpt">{post.data.excerpt}</span>}
                    <span class="pa-risk-read__cta">Read article →</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>

  {/* ─── MARQUEE ────────────────────────────────────────── */}
  <MarqueeGallery images={marqueeImages} speed={55} tileWidth={340} />

  {/* ─── SPECS BAND ─────────────────────────────────────── */}
  <section class="pa-specs">
    <div class="container" data-reveal>
      <header>
        <span class="pa-eyebrow">Aluminium Specifications</span>
        <h2><span class="pa-specs__brand">Portchester<sup>®</sup></span> Aluminium Shutters for Leicester Homes</h2>
        <p>Engineered to the spec sheet below. The numbers and certifications behind every Portchester® install we fit across Leicestershire.</p>
      </header>
      <ul class="pa-specs__grid" data-reveal-children>
        {specs.map((s, i) => (
          <li class="pa-spec-card">
            <div class="pa-spec-card__head">
              <span class="pa-spec-card__num">{(i + 1).toString().padStart(2, '0')}</span>
              <span class="pa-spec-card__icon" aria-hidden="true" set:html={icon[s.icon]} />
            </div>
            <h3>{s.heading}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ─── 8 FEATURE CARDS ────────────────────────────────── */}
  <section class="pa-features">
    <div class="container" data-reveal>
      <header>
        <span class="pa-eyebrow">What Makes Portchester® Different</span>
        <h2>Built For Security. Designed For Style.</h2>
      </header>
      <ul class="pa-features__grid" data-reveal-children>
        {features.map((f) => (
          <li class="pa-feature">
            <div class="pa-feature__icon" aria-hidden="true" set:html={icon[f.icon]} />
            <h3>{f.heading}</h3>
            <p>{f.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ─── AWARDS CTA ────────────────────────────────────── */}
  <AwardsCTABox
    backgroundImage="/wp-content/uploads/2026/05/01-shutter-envy.jpeg"
    eyebrow="Ready for your 5-star service?"
    heading="Why Choose Shutter Envy?"
    body="Award-winning craftsmanship and personalised service. We don't just supply products — we design and fit elegant, functional spaces that elevate your home."
    awardImages={[
      '/wp-content/uploads/2025/11/Shutter-Envy-Shutter-and-Blind-Company-of-the-Year-Award-winner-Leicestershire.-Shutters.-Blinds-300x78.png',
      '/wp-content/uploads/2025/11/Shutter-Envy-Shutter-and-Blind-Company-of-the-Year-Award-winner-Leicestershire.-Shutters.-Blinds-1-300x78.png',
      '/wp-content/uploads/2025/11/Shutter-Envy-Shutter-and-Blind-Company-of-the-Year-Award-winner-Leicestershire.-Shutters.-Blinds-3-300x78.png',
    ]}
    awardsCaption="Blind & Shutter Specialists of the Year"
    ctaNote="Get started today with a no-obligation, personalised consultation."
    cta={{ label: 'Arrange a Home Visit', href: '/contact/' }}
  />

  {/* ─── SHUTTER STYLES ─────────────────────────────────── */}
  <section class="pa-styles">
    <div class="container" data-reveal>
      <header>
        <span class="pa-eyebrow">Style Options</span>
        <h2>Shutter Styles to Suit Every Home &amp; Business</h2>
        <p>Five proven shutter styles — built to your window's exact dimensions, in your choice of finish.</p>
      </header>
    </div>

    <div class="pa-styles__list container">
      {styles.map((s, i) => (
        <article class:list={['pa-style', i % 2 === 1 ? 'pa-style--reverse' : '']} data-reveal>
          <div class="pa-style__image">
            <img src={s.image} alt={s.name} loading="lazy" />
          </div>
          <div class="pa-style__body">
            <h3>{s.name}</h3>
            {s.paragraphs.map((p) => <p>{p}</p>)}
            <ul>
              {s.bullets.map((b) => <li>{b}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  {/* ─── QUOTE FORM ─────────────────────────────────────── */}
  <section class="pa-form">
    <div class="pa-form__grid container">
      <div class="pa-form__copy" data-reveal="left">
        <span class="pa-eyebrow">Get a Free Quote</span>
        <h2>Ready for Beautiful <em>Shutters and Blinds</em>?</h2>
        <p>Fill in the form and we'll arrange a free home survey. Mark visits with samples and you get a no-obligation quote on the day.</p>
        <ul class="pa-form__points">
          <li>★ Free home survey, no obligation</li>
          <li>★ Samples brought to you</li>
          <li>★ Quote provided on the day</li>
          <li>★ Most surveys booked within a few days</li>
        </ul>
      </div>
      <div class="pa-form__panel" data-reveal="right">
        <div class="pa-form__head">
          <p class="pa-form__eyebrow">★ Free home survey</p>
