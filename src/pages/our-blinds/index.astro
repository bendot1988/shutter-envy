---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeatureChecklist from '../../components/home/FeatureChecklist.astro';
import MarqueeGallery from '../../components/MarqueeGallery.astro';
import ProcessTimeline from '../../components/home/ProcessTimeline.astro';
import ReviewsRow from '../../components/home/ReviewsRow.astro';
import InlineCTA from '../../components/home/InlineCTA.astro';
import { faqPage, breadcrumbList } from '../../lib/schema';

const entry = await getEntry('pages', 'our-blinds');
if (!entry) throw new Error('Missing pages/our-blinds content entry');

const jsonLd: object[] = [
  breadcrumbList([
    { name: 'Home', url: '/' },
    { name: 'Our Blinds', url: '/our-blinds/' },
  ]),
];
if (entry.data.faqs?.length) jsonLd.push(faqPage(entry.data.faqs));

// ─── Locations — pulled from the locations collection ──
// Town name is parsed from each slug (e.g. "shutters-in-leicester" → "Leicester").
const locationEntries = await getCollection('locations');
const towns = locationEntries
  .map((l) => {
    const slug = l.id.replace(/\.md$/, '');
    const town = slug
      .replace(/^shutters-(in-)?/, '')
      .split('-')
      .map((w) => w === 'upon' ? 'upon' : w.charAt(0).toUpperCase() + w.slice(1))
      .join(' ');
    return { town, href: `/locations/${slug}/` };
  })
  .filter((t) => !/charnwood/i.test(t.town)) // skip the catch-all area page
  .sort((a, b) => a.town.localeCompare(b.town));

// ─── Page-specific content ─────────────────────────────
const heroImage = '/wp-content/uploads/2026/02/Black-Art-Vines-Blinds-Bedroom-Shutter-MV-shutters-blinds-Loughborough-Leicester.jpeg';

// Marquee — blind installation imagery (placeholders where required).
const marqueeImages = [
  { src: '/wp-content/uploads/2026/02/Black-Art-Vines-Blinds-Bedroom-Shutter-MV-shutters-blinds-Loughborough-Leicester.jpeg', alt: 'Bedroom blinds in Loughborough' },
  { src: '/wp-content/uploads/2026/04/Automotive-Blinds-in-Loughborough-ShutterEnvy.jpeg',                                      alt: 'Automotive-style blinds in Loughborough' },
  { src: '/wp-content/uploads/2025/04/automised-blinds-ben-in-loughboough.jpeg',                                                 alt: 'Automated blinds fitted by Ben in Loughborough' },
  { src: '/wp-content/uploads/2025/04/Galaxy-Honey-Comb-Blind-2.webp',                                                           alt: 'Galaxy honeycomb blind' },
  { src: '/wp-content/uploads/2025/07/motor-blinds.webp',                                                                        alt: 'Motorised blinds' },
  { src: '/wp-content/uploads/2025/10/01-new-build-home-shutters-and-blinds-shutter-envy.jpeg',                                  alt: 'New-build home shutters and blinds' },
  { src: '/wp-content/uploads/2025/10/03-new-build-home-shutters-and-blinds-shutter-envy.jpeg',                                  alt: 'New-build home shutters and blinds' },
  { src: '/wp-content/uploads/2025/10/05-new-build-home-shutters-and-blinds-shutter-envy.jpeg',                                  alt: 'New-build home shutters and blinds' },
  { src: '/wp-content/uploads/2025/11/Shutters-and-Blinds-in-Leicester-Shutter-Envy-Shutters-Bonfire-Night-et-cetera-Shutter-Envy.jpeg', alt: 'Shutters and blinds in Leicester' },
];

// Feature bullets — VERBATIM from the original ranking copy.
const features = [
  { heading: 'Wide range of fabrics and colours to suit every style', body: '' },
  { heading: 'Motorisation options for effortless control', body: '' },
  { heading: 'Enhanced light and privacy control with layered fabrics', body: '' },
  { heading: 'Energy-efficient blinds to help regulate temperature', body: '' },
  { heading: 'Custom fit for windows of all sizes', body: '' },
  { heading: 'Expert installation for a flawless finish', body: '' },
];

// Intro — VERBATIM "Bespoke Blinds for Every Home" copy.
const intro = {
  heading: 'Bespoke Blinds for Every Home',
  paragraphs: [
    'Shutter Envy supplies and fits made-to-measure blinds for homes across Leicester, Loughborough, Melton Mowbray and surrounding Leicestershire areas. From roller and Venetian blinds to vertical and motorised options, our team helps you choose practical, stylish window coverings for every room.',
  ],
};

// Blind types — VERBATIM body copy from the live ranking page.
const types = [
  {
    name: 'Roller Blinds',
    body: 'Our premium range of roller blinds helps to give your home a crisp and fresh finish. We have a wide range of beautiful fabric designs and colour pathways available. Add some sophistication to your roller by upgrading to one of our matching or contrasting fabric cassettes, which finish the blind beautifully. We have motorisation options available, from integral rechargeable, battery motors or hard-wired Somfy motors. All have the option to be voice activated and added to a home automation system.',
    image: '/wp-content/uploads/2025/10/01-new-build-home-shutters-and-blinds-shutter-envy.jpeg',
  },
  {
    name: 'Venetian Blinds',
    body: 'Venetian Blinds are a stylish, simple way to customise your windows, with the natural stains and painted finishes available in our Real Wood ranges to the clean cut and finish of our Faux Wood alternatives. Venetian blinds are a great way to control both light and privacy, by simply tilting the slats to the desired angle. We have the option of a Privacy slat to close out the outside world when you wish, or the ability to add your own style, with either a matching or contrasting tape finish. Motorisation is available to venetian products, which can work with remote, phone app, or even voice activation for ultimate convenience and control.',
    image: '/wp-content/uploads/2026/02/Black-Art-Vines-Blinds-Bedroom-Shutter-MV-shutters-blinds-Loughborough-Leicester.jpeg',
  },
  {
    name: 'Honeycomb Blinds',
    body: 'Honeycomb blinds are available in a wide range of fabrics and colours. The unique design of our honeycomb blinds help to control light and privacy, and even the temperature of your room. Added benefits of honeycomb blinds are the availability of blackout options, with our SmartFrame option offering you near-perfect light-blocking characteristics. Honeycomb blinds allow you so many options in terms of operation, from a standard bottom-down to the versatile top-down, bottom-up for total control. Honeycomb blinds can be operated via motorisation including Remote, Hub and Voice activation.',
    image: '/wp-content/uploads/2025/04/Galaxy-Honey-Comb-Blind-2.webp',
  },
  {
    name: 'Duo Roller Blinds',
    body: 'Duo Rollers are a horizontally-striped, stylish fabric, which allows you to control light and privacy. As the double-layered fabrics move relative to each other, you can move from opaque to translucent to full visibility with ease. With a range of fabric colours and types, all available with matching cassettes and an easy wipe clean fabric, Duo Rollers add a contemporary finish to any room. These can be motorised with either remote functionality or connected via a home hub for app and voice control.',
    image: null,
  },
  {
    name: 'Vertical Blinds',
    body: 'Vertical blinds are an elegant way to control light and privacy in your home. All of our vertical headrails are built using the Vogue headrail system, which is available in different colours, to match with your fabric or internal decor.',
    image: null,
  },
  {
    name: 'Motorised Blinds',
    body: "Add convenience and a touch of luxury with motorised blinds — operated via remote, phone app, voice assistant or as part of your home automation system. Available across most of our blind ranges, including roller, Venetian, honeycomb and duo roller. Perfect for hard-to-reach windows, large openings and that effortless 'wake-up to natural light' moment.",
    image: '/wp-content/uploads/2025/07/motor-blinds.webp',
  },
];

const reviews = [
  { name: 'Liz Twitchell',  rating: 5, date: '1 year ago',  body: "Top notch job by Mark and team yet again. From initial consultation to fitting — a totally professional, efficient and friendly experience." },
  { name: 'Wendy Harrison', rating: 5, date: '2 years ago', body: "I would like to thank Mark & Co at Shutter Envy. Their service is excellent. From the minute I contacted them they were helpful and professional." },
  { name: 'Sandra Mould',   rating: 5, date: '2 years ago', body: "Fantastic service from Mark. First class product. Excellent results. Fast, efficient and perfect. So pleased." },
];

const processSteps = [
  { title: 'Schedule a Home Visit', body: "Book a time that suits you. We'll come to your home with samples.", image: '/wp-content/uploads/2024/10/106shots_so.jpeg' },
  { title: 'Personalised Home Visit', body: 'Mark brings fabric samples and gives you a no-obligation quote on the day.', image: '/wp-content/uploads/2024/09/dotwall-Web-Design2024-09-02-at-20.46.30-1024x775.jpg' },
  { title: 'Manufacturing With Care', body: 'Your custom blinds are made to order with regular updates.', image: '/wp-content/uploads/2024/09/5bc529c6-242f-4aab-8112-67d895fc7c43-1024x768.jpg' },
  { title: 'Professional Installation', body: 'Tidy installation by our own team — no mess, perfect finish.', image: '/wp-content/uploads/2024/10/dotwall-Web-Design2024-10-07-at-14.08.01.jpeg' },
  { title: 'Enjoy Your New Blinds', body: 'Care guidance and aftercare on installation day.', image: '/wp-content/uploads/2024/09/431555826_2629833587193609_4928996973115882659_n-300x169.jpg' },
];
---
<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogImage={entry.data.ogImage}
  jsonLd={jsonLd}
>
  {/* ─── HERO ────────────────────────────────────────────── */}
  <section class="obl-hero" style={`background-image: url('${heroImage}')`}>
    <div class="obl-hero__overlay"></div>
    <div class="obl-hero__inner" data-reveal>
      <span class="obl-hero__eyebrow">Our Blinds</span>
      <h1>{entry.data.h1}</h1>
      <p>Roller, Venetian, honeycomb, duo roller, vertical and motorised blinds — designed, supplied and fitted by our family-run team across Leicestershire.</p>
      <div class="obl-hero__actions">
        <a href="/contact/" class="obl-hero__btn">
          Arrange a Home Visit
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M3 7h8m0 0L7 3m4 4l-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="tel:+447729572277" class="obl-hero__btn obl-hero__btn--ghost">Call 07729 572277</a>
      </div>
    </div>
  </section>

  {/* ─── MARQUEE — auto-scrolling install gallery ──────── */}
  <MarqueeGallery images={marqueeImages} speed={55} tileWidth={340} />

  {/* ─── INTRO — preserves original ranking copy ─────────── */}
  <section class="obl-intro container" data-reveal>
    <h2>{intro.heading}</h2>
    {intro.paragraphs.map((p) => <p>{p}</p>)}
  </section>

  {/* ─── FEATURE CHECKLIST ──────────────────────────────── */}
  <FeatureChecklist
    heading="Made to Measure, Made to Last"
    body="Every set of blinds we fit is bespoke to the window. Here's what's standard."
    items={features}
    cta={{ label: 'Arrange a Home Visit', href: '/contact/' }}
    backgroundImage={heroImage}
  />

  {/* ─── BLIND TYPES — alternating image / copy ─────────── */}
  <section class="obl-types" data-reveal>
    <div class="obl-types__inner container">
      <header>
        <span class="obl-eyebrow">Blind Types</span>
        <h2>Our Range of Made-to-Measure Blinds</h2>
        <p>From crisp rollers to elegant verticals — we'll recommend the right blind for every room, with motorisation options across the range.</p>
      </header>
      <ul class="obl-types__grid" data-reveal-children>
        {types.map((t) => (
          <li>
            <article class="obl-type-card">
              <div class="obl-type-card__image">
                {t.image
                  ? <img src={t.image} alt={t.name} loading="lazy" />
                  : <div class="obl-placeholder" role="img" aria-label={`${t.name} — image coming soon`}>
                      <svg viewBox="0 0 60 60" fill="none" aria-hidden="true">
                        <rect x="10" y="10" width="40" height="42" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
                        <line x1="14" y1="16" x2="46" y2="16" stroke="currentColor" stroke-width="0.8"/>
                        <line x1="14" y1="22" x2="46" y2="22" stroke="currentColor" stroke-width="0.8"/>
                        <line x1="14" y1="28" x2="46" y2="28" stroke="currentColor" stroke-width="0.8"/>
                        <line x1="14" y1="34" x2="46" y2="34" stroke="currentColor" stroke-width="0.8"/>
                        <line x1="14" y1="40" x2="46" y2="40" stroke="currentColor" stroke-width="0.8"/>
                        <line x1="14" y1="46" x2="46" y2="46" stroke="currentColor" stroke-width="0.8"/>
                      </svg>
                      <span>Photo coming soon</span>
                    </div>
                }
              </div>
              <div class="obl-type-card__body">
                <h3>{t.name}</h3>
                <p>{t.body}</p>
              </div>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ─── PROCESS TIMELINE ───────────────────────────────── */}
  <ProcessTimeline steps={processSteps} />

  {/* ─── WHERE WE INSTALL BLINDS ────────────────────────── */}
  <section class="obl-locations" data-reveal>
    <div class="obl-locations__overlay"></div>
    <div class="obl-locations__inner container">
      <header>
        <span class="obl-locations__eyebrow">Coverage</span>
        <h2>Where We Install Blinds</h2>
        <p>We fit made-to-measure blinds across Leicestershire — from Leicester city to the surrounding market towns and villages. Click your town for local installation details.</p>
      </header>
      <ul class="obl-locations__grid" data-reveal-children>
        {towns.map((t) => (
          <li>
            <a href={t.href} class="obl-location-card">
              <span class="obl-location-card__label">Blinds in</span>
              <span class="obl-location-card__town">{t.town}</span>
              <span class="obl-location-card__cta">
                View area
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M3 7h8m0 0L7 3m4 4l-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
      <p class="obl-locations__foot">
        Don't see your town? <a href="/contact/">Get in touch</a> — we cover most of Leicestershire.
      </p>
    </div>
  </section>

  {/* ─── REVIEWS ────────────────────────────────────────── */}
  <ReviewsRow
    heading="What Our Customers Say"
    rating="5.0"
    totalReviews="25"
    source="Google"
    link="https://www.google.com/maps/place/Shutter+Envy+Ltd/@52.7208272,-1.1413311,15z"
    reviews={reviews}
  />

  {/* ─── END CTA ────────────────────────────────────────── */}
  <InlineCTA
    eyebrow="Ready to Get Started?"
    heading="Book Your Free Home Survey"
    body="Mark visits your home with fabric samples, takes measurements, and gives you a no-obligation quote on the day. Most surveys are booked within a few days."
    cta={{ label: 'Arrange a Home Visit', href: '/contact/' }}
    secondaryCta={{ label: 'Call 07729 572277', href: 'tel:+447729572277' }}
    tone="gold"
  />
</BaseLayout>

<style>
  /* ─── Shared utility eyebrow ──────────────────────────── */
  .obl-eyebrow {
    display: inline-block;
    background: rgba(199,154,8,0.12);
    color: var(--color-gold-600);
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-pill);
    font-size: var(--text-link-12-700);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 1.25rem;
  }

  /* ─── HERO ────────────────────────────────────────────── */
  .obl-hero {
    position: relative;
    margin: 0 calc(50% - 50vw);
    padding: 5rem 1.25rem 5.5rem;
    background-color: var(--color-cream);
    background-size: cover;
    background-position: center;
    text-align: center;
    overflow: hidden;
  }
  .obl-hero__overlay {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(249,248,244,0.86) 0%, rgba(249,248,244,0.94) 100%);
  }
  .obl-hero__inner { position: relative; max-width: 48rem; margin: 0 auto; }
  .obl-hero__eyebrow {
    display: inline-block;
    background: rgba(199,154,8,0.12);
    color: var(--color-gold-600);
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-pill);
    font-size: var(--text-link-12-700);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 1.25rem;
  }
  .obl-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, var(--text-h2-60-500));
    font-weight: 500;
    line-height: 1.075;
    letter-spacing: -0.027em;
    margin: 0 0 1.5rem;
    text-wrap: balance;
  }
  .obl-hero p {
    color: var(--color-ink-soft);
    font-size: var(--text-large-body-19-400);
    line-height: 1.6;
    margin: 0 auto 2rem;
    max-width: 36rem;
  }
  .obl-hero__actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .obl-hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.875rem;
    background: linear-gradient(180deg, var(--color-gold-400), var(--color-gold-600));
    color: #fff;
    border-radius: var(--radius-pill);
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: var(--text-button-14-500);
    letter-spacing: 0.02em;
    text-decoration: none;
    box-shadow: 0 12px 32px -8px rgba(199,154,8,0.55), inset 0 1px 0 rgba(255,255,255,0.2);
    transition: transform 200ms, filter 200ms;
  }
  .obl-hero__btn:hover { transform: translateY(-2px); filter: brightness(1.08); color: #fff; }
  .obl-hero__btn svg { transition: transform 200ms; }
  .obl-hero__btn:hover svg { transform: translateX(3px); }
  .obl-hero__btn--ghost {
    background: #fff;
    color: var(--color-ink);
    border: 1px solid var(--color-line);
    box-shadow: var(--shadow-sm);
  }
  .obl-hero__btn--ghost:hover {
    background: var(--color-cream);
    border-color: var(--color-gold-400);
    color: var(--color-gold-600);
  }

  /* ─── INTRO (verbatim ranking copy) ──────────────────── */
  .obl-intro {
    max-width: 48rem;
    padding: 4rem 1.25rem 1rem;
    text-align: center;
  }
  .obl-intro h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, var(--text-h2-60-500));
    font-weight: 500;
    line-height: 1.075;
    letter-spacing: -0.027em;
    margin: 0 0 1.5rem;
    text-wrap: balance;
  }
  .obl-intro p {
    color: var(--color-ink-soft);
    font-size: var(--text-large-body-19-400);
    line-height: 1.6;
    margin: 0 auto 1rem;
    max-width: 40rem;
  }

  /* ─── BLIND TYPES SECTION ────────────────────────────── */
  .obl-types { padding: 6rem 0 5rem; background: #fff; }
  .obl-types__inner { padding: 0 1.25rem; }
  .obl-types header { text-align: center; max-width: 44rem; margin: 0 auto 3rem; }
  .obl-types h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, var(--text-h2-60-500));
    font-weight: 500;
    line-height: 1.075;
    letter-spacing: -0.027em;
    margin: 0 0 1rem;
  }
  .obl-types header p {
    color: var(--color-ink-soft);
    font-size: var(--text-large-body-19-400);
    line-height: 1.6;
    margin: 0;
  }
  .obl-types__grid {
    list-style: none; padding: 0; margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 640px)  { .obl-types__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .obl-types__grid { grid-template-columns: repeat(3, 1fr); } }
  .obl-types__grid li { margin: 0; }

  .obl-type-card {
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform 280ms cubic-bezier(0.16,1,0.3,1), box-shadow 280ms, border-color 280ms;
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  .obl-type-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-gold-400);
  }
  .obl-type-card__image { overflow: hidden; background: var(--color-cream); }
  .obl-type-card__image img,
  .obl-type-card__image > div {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    display: block;
    transition: transform 600ms cubic-bezier(0.16,1,0.3,1);
  }
  .obl-type-card:hover .obl-type-card__image img { transform: scale(1.05); }
  .obl-type-card__body { padding: 1.5rem 1.75rem 1.75rem; flex: 1; }
  .obl-type-card h3 {
    font-family: var(--font-display);
    color: var(--color-gold-600);
    font-size: var(--text-h3-24-500);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.027em;
    margin: 0 0 0.625rem;
  }
  .obl-type-card p {
    color: var(--color-ink-soft);
    font-size: var(--text-small-body-15-400);
    line-height: 1.65;
    margin: 0;
  }

  /* ─── WHERE WE INSTALL BLINDS ────────────────────────── */
  .obl-locations {
    position: relative;
    margin: 0 calc(50% - 50vw);
    padding: 6rem 1.25rem 5.5rem;
    background-color: #0c0c0c;
    background-image: url('/wp-content/uploads/2026/02/Black-Art-Vines-Blinds-Bedroom-Shutter-MV-shutters-blinds-Loughborough-Leicester.jpeg');
    background-size: cover;
    background-position: center;
    color: #fff;
    overflow: hidden;
  }
  .obl-locations__overlay {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(7,7,7,0.86) 0%, rgba(7,7,7,0.94) 100%);
  }
  .obl-locations__inner { position: relative; max-width: 72rem; margin: 0 auto; }
  .obl-locations header { text-align: center; max-width: 44rem; margin: 0 auto 3rem; }
  .obl-locations__eyebrow {
    display: inline-block;
    background: rgba(199,154,8,0.18);
    color: var(--color-gold-400);
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-pill);
    font-size: var(--text-link-12-700);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 1.25rem;
  }
  .obl-locations h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, var(--text-h2-60-500));
    font-weight: 500;
    line-height: 1.075;
    letter-spacing: -0.027em;
    margin: 0 0 1rem;
    color: #fff;
  }
  .obl-locations header p {
    color: rgba(255,255,255,0.78);
    font-size: var(--text-large-body-19-400);
    line-height: 1.6;
    margin: 0;
  }
  .obl-locations__grid {
    list-style: none; padding: 0; margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.875rem;
  }
  @media (min-width: 520px)  { .obl-locations__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 768px)  { .obl-locations__grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1024px) { .obl-locations__grid { grid-template-columns: repeat(4, 1fr); } }
  .obl-locations__grid li { margin: 0; }

  .obl-location-card {
