---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ReviewsRow from '../../../components/home/ReviewsRow.astro';
import InlineCTA from '../../../components/home/InlineCTA.astro';
import ClearLineForm from '../../../components/ClearLineForm.astro';
import { localBusiness, faqPage, breadcrumbList } from '../../../lib/schema';
import { business } from '../../../data/site';

export async function getStaticPaths() {
  const locations = await getCollection('locations');
  return locations.map((loc) => ({
    params: { slug: loc.id },
    props: { loc },
  }));
}

const { loc } = Astro.props;
const { Content } = await render(loc);

const url = `https://shutter-envy.co.uk/locations/${loc.id}/`;
const jsonLd: object[] = [
  localBusiness({
    url,
    areaServed: loc.data.area,
    name: `Shutter Envy — ${loc.data.area}`,
  }),
  breadcrumbList([
    { name: 'Home', url: '/' },
    { name: 'Locations', url: '/locations/' },
    { name: loc.data.area, url: `/locations/${loc.id}/` },
  ]),
];
if (loc.data.faqs?.length) jsonLd.push(faqPage(loc.data.faqs));

// ─── Per-location hero imagery ────────────────────────
// Mirrors the picks in src/data/site.ts so the header thumbnails match the
// hero on the destination page. Falls back to a flagship install shot.
const HERO_BY_SLUG: Record<string, string> = {
  'shutters-in-leicester':           '/wp-content/uploads/2026/02/Castile-shutters-in-Leicester.jpg',
  'shutters-in-loughborough':        '/wp-content/uploads/2026/04/Bay-window-shutters-in-Loughborough.jpeg',
  'shutters-market-harborough':      '/wp-content/uploads/2026/04/01-Shutter-Envy-shutters-in-Loughbray-and-Leicester-.jpeg',
  'shutters-melton-mowbray':         '/wp-content/uploads/2026/04/02-Shutter-Envy-shutters-in-Loughbray-and-Leicester-.jpeg',
  'shutters-in-charnwood':           '/wp-content/uploads/2026/04/03-Shutter-Envy-shutters-in-Loughbray-and-Leicester-.jpeg',
  'shutters-in-quorn':               '/wp-content/uploads/2026/04/04-Shutter-Envy-shutters-in-Loughbray-and-Leicester-.jpeg',
  'shutters-in-rothley':             '/wp-content/uploads/2026/04/05-Shutter-Envy-shutters-in-Loughbray-and-Leicester-.jpeg',
  'shutters-in-syston':              '/wp-content/uploads/2026/05/01-shutter-envy.jpeg',
  'shutters-birstall':               '/wp-content/uploads/2026/05/02-shutter-envy.jpeg',
  'shutters-groby':                  '/wp-content/uploads/2026/05/03-shutter-envy.jpeg',
  'shutters-sileby':                 '/wp-content/uploads/2026/04/faux-wood-shutters-kitchen-window-uk.jpeg',
  'shutters-in-barrow-upon-soar':    '/wp-content/uploads/2026/02/cafe-Style-Shutters-Shutter-Envy-in-Loughborough.jpg',
};
const heroImage = HERO_BY_SLUG[loc.id] ?? '/wp-content/uploads/2026/04/Bay-window-shutters-in-Loughborough.jpeg';

// ─── Trust block — same Google copy as other product pages ──
const reviews = [
  { name: 'Liz Twitchell',  rating: 5, date: '1 year ago',  body: "Top notch job by Mark and team yet again. From initial consultation to fitting — a totally professional, efficient and friendly experience." },
  { name: 'Wendy Harrison', rating: 5, date: '2 years ago', body: "I would like to thank Mark & Co at Shutter Envy. Their service is excellent. From the minute I contacted them they were helpful and professional." },
  { name: 'Sandra Mould',   rating: 5, date: '2 years ago', body: "Fantastic service from Mark. First class product. Excellent results. Fast, efficient and perfect. So pleased." },
];

const stats = [
  { value: '5.0★', label: 'Google rated' },
  { value: '3×',   label: 'Specialists of the Year' },
  { value: '5yr',  label: 'Warranty' },
];

const area = loc.data.area;
---
<BaseLayout
  title={loc.data.title}
  description={loc.data.description}
  ogImage={loc.data.ogImage ?? heroImage}
  jsonLd={jsonLd}
  includeLocalBusiness={false}
>
  {/* ─── HERO ────────────────────────────────────────────── */}
  <section class="loc-hero" style={`background-image: url('${heroImage}')`}>
    <div class="loc-hero__overlay"></div>
    <div class="loc-hero__inner" data-reveal>
      <nav class="loc-hero__crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">›</span>
        <a href="/locations/">Locations</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">{area}</span>
      </nav>
      <span class="loc-hero__eyebrow">Local service · {area}</span>
      <h1>{loc.data.h1}</h1>
      <p>Designed, supplied and fitted by our family-run team — serving {area} and the surrounding villages.</p>
      <div class="loc-hero__actions">
        <a href="#enquire" class="loc-hero__btn">
          Arrange a Home Visit
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M3 7h8m0 0L7 3m4 4l-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href={`tel:${business.phoneTel}`} class="loc-hero__btn loc-hero__btn--ghost">Call {business.phoneDisplay}</a>
      </div>
      <ul class="loc-hero__stats" aria-label="Trust signals">
        {stats.map((s) => (
          <li>
            <strong>{s.value}</strong>
            <span>{s.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ─── BODY: 2-col with sticky sidebar ─────────────────── */}
  <section class="loc-body container" data-reveal>
    <div class="loc-body__grid">
      {/* Markdown content */}
      <article class="loc-prose">
        <Content />

        {/* Team callout — JS lifts this and slots it before the 2nd H2 so it
            sits naturally mid-flow. If there's only one H2, it stays at the
            end of the prose (still a nice visual full-stop). */}
        <aside class="loc-team" data-team-callout>
          <div class="loc-team__media">
            <img
              src="/images/mark-shutter-envy-van.png"
              alt={`Mark from Shutter Envy with the company van — covering ${area}`}
              loading="lazy"
            />
          </div>
          <div class="loc-team__body">
            <span class="loc-team__eyebrow">★ Meet Mark</span>
            <p class="loc-team__quote">
              "I personally visit every {area} home before quoting — samples in hand, no pressure, just honest advice."
            </p>
            <a href="#enquire" class="loc-team__link">
              Book a visit in {area}
              <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M3 7h8m0 0L7 3m4 4l-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        </aside>
      </article>

      {/* Sticky sidebar */}
      <aside class="loc-side">
        <div class="loc-side__inner">
          {/* Dark CTA card */}
          <div class="loc-side__cta">
            <p class="loc-side__cta-eyebrow">★ Free survey in {area}</p>
            <h3>Speak to Mark today</h3>
            <p>Samples in hand, no-pressure quote on the day.</p>
            <a href="#enquire" class="loc-side__cta-btn">
              Get a quote
              <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M3 7h8m0 0L7 3m4 4l-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
            <a href={`tel:${business.phoneTel}`} class="loc-side__cta-phone">
              <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor" aria-hidden="true"><path d="M20 15.5c-1.25 0-2.45-.2-3.57-.57a1 1 0 0 0-1.02.24l-2.2 2.2a15.05 15.05 0 0 1-6.59-6.59l2.2-2.2a1 1 0 0 0 .25-1.01A11.36 11.36 0 0 1 8.5 4a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1c0 9.39 7.61 17 17 17a1 1 0 0 0 1-1v-3.5a1 1 0 0 0-1-1z"/></svg>
              or call {business.phoneDisplay}
            </a>
          </div>

          {/* Coverage card */}
          <div class="loc-side__coverage">
            <p class="loc-side__title">Where we go</p>
            <p>We visit {area} and the surrounding Leicestershire villages, including Mountsorrel, Quorn, Rothley, Sileby, Syston, Birstall, Anstey, Groby and Woodhouse Eaves.</p>
            <a href="/locations/" class="loc-side__link">See all locations →</a>
          </div>

          {/* Services in this area — reinforces topical relevance to the
              service hubs (F7 in SEO-ROADMAP). Plain anchors, no images. */}
          <div class="loc-side__services">
            <p class="loc-side__title">Services in {area}</p>
            <ul>
              <li><a href="/our-shutters/">Plantation shutters in {area}</a></li>
              <li><a href="/our-blinds/">Made-to-measure blinds in {area}</a></li>
              <li><a href="/awnings/">Awnings &amp; outdoor shade</a></li>
              <li><a href="/blind-motorisation/">Motorised blinds</a></li>
              <li><a href="/portchester-aluminium-shutters-leicester/">Portchester aluminium shutters</a></li>
              <li><a href="/british-made-shutters/">British-made shutters</a></li>
            </ul>
          </div>

          {/* Map */}
          {loc.data.mapEmbedUrl && (
            <div class="loc-side__map">
              <p class="loc-side__title">{area} map</p>
              <div class="loc-side__map-frame">
                <iframe
                  src={loc.data.mapEmbedUrl}
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  title={`Map of ${area}`}
                ></iframe>
              </div>
            </div>
          )}
        </div>
      </aside>
    </div>
  </section>

  {/* ─── REVIEWS ────────────────────────────────────────── */}
  <ReviewsRow
    heading={`Trusted by homeowners across ${area}`}
    rating="5.0"
    totalReviews="25"
    source="Google"
    link="https://www.google.com/search?q=shutter+envy#lrd=0x4879dfa0c6f26fb7:0xc6da05bdf5856b2c,1"
    reviews={reviews}
  />

  {/* ─── FAQs (if present) ──────────────────────────────── */}
  {loc.data.faqs?.length > 0 && (
    <section class="loc-faqs" data-reveal>
      <div class="loc-faqs__inner container">
        <header>
          <span class="loc-eyebrow">Common Questions</span>
          <h2>Shutter FAQs for {area}</h2>
        </header>
        <ul class="loc-faqs__list">
          {loc.data.faqs.map((f) => (
            <li>
              <details class="loc-faq">
                <summary>
                  <span>{f.question}</span>
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M3 5l4 4 4-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </summary>
                <div class="loc-faq__body"><p>{f.answer}</p></div>
              </details>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {/* ─── ENQUIRY FORM ───────────────────────────────────── */}
  <section id="enquire" class="loc-enquire" data-reveal>
    <div class="loc-enquire__inner container">
      <header>
        <span class="loc-eyebrow">Get In Touch</span>
        <h2>Book your free home survey in {area}</h2>
        <p>Tell us a bit about your windows and we'll be in touch to arrange a no-obligation visit.</p>
      </header>
      <div class="loc-enquire__form">
        <ClearLineForm />
      </div>
    </div>
  </section>

  {/* ─── END CTA ────────────────────────────────────────── */}
  <InlineCTA
    eyebrow="Ready to Get Started?"
    heading={`Bespoke shutters & blinds in ${area}`}
    body="Mark visits your home with samples, takes measurements, and gives you a no-obligation quote on the day."
    cta={{ label: 'Arrange a Home Visit', href: '#enquire' }}
    secondaryCta={{ label: `Call ${business.phoneDisplay}`, href: `tel:${business.phoneTel}` }}
    tone="gold"
  />
</BaseLayout>

<script>
  // Lift the team callout out of its position and drop it before the 2nd H2,
  // so it breaks up the wall of body copy. If only one H2 exists, leave it
  // where it is (end of prose).
  (() => {
    const prose = document.querySelector('.loc-prose');
    const team = document.querySelector<HTMLElement>('[data-team-callout]');
    if (!prose || !team) return;
    const h2s = prose.querySelectorAll(':scope > h2');
    if (h2s.length >= 2) prose.insertBefore(team, h2s[1]);
  })();
</script>

<style>
  /* ─── Shared utility eyebrow ──────────────────────────── */
  .loc-eyebrow {
    display: inline-block;
    background: rgba(199,154,8,0.12);
    color: var(--color-gold-600);
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-pill);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0 0 1.25rem;
  }

  /* ─── HERO ────────────────────────────────────────────── */
  .loc-hero {
    position: relative;
    margin: 0 calc(50% - 50vw);
    padding: 4rem 1.25rem 4.5rem;
    background-color: var(--color-cream);
    background-size: cover;
    background-position: center;
    text-align: center;
    overflow: hidden;
  }
  .loc-hero__overlay {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(249,248,244,0.85) 0%, rgba(249,248,244,0.94) 100%);
  }
  .loc-hero__inner {
    position: relative;
    max-width: 50rem;
    margin: 0 auto;
  }
  .loc-hero__crumbs {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--color-ink-mute);
    margin: 0 0 1.25rem;
  }
  .loc-hero__crumbs a {
    color: var(--color-ink-mute);
    text-decoration: none;
    transition: color 150ms;
  }
  .loc-hero__crumbs a:hover { color: var(--color-gold-600); }
  .loc-hero__crumbs [aria-current] { color: var(--color-ink); font-weight: 500; }
  .loc-hero__eyebrow {
    display: inline-block;
    background: rgba(199,154,8,0.12);
    color: var(--color-gold-600);
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-pill);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0 0 1.25rem;
  }
  .loc-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, var(--text-h2-60-500));
    font-weight: 500;
    line-height: 1.075;
    letter-spacing: -0.027em;
    margin: 0 0 1.25rem;
    text-wrap: balance;
  }
  .loc-hero p {
    color: var(--color-ink-soft);
    font-size: var(--text-large-body-19-400);
    line-height: 1.6;
    margin: 0 auto 1.75rem;
    max-width: 38rem;
  }
  .loc-hero__actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
    margin: 0 0 2rem;
  }
  .loc-hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.75rem;
    background: linear-gradient(180deg, var(--color-gold-400), var(--color-gold-600));
    color: #fff;
    border-radius: var(--radius-pill);
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: var(--text-button-14-500);
    letter-spacing: 0.02em;
    text-decoration: none;
    box-shadow: 0 12px 32px -8px rgba(199,154,8,0.55), inset 0 1px 0 rgba(255,255,255,0.2);
    transition: transform 200ms, filter 200ms;
  }
  .loc-hero__btn:hover { transform: translateY(-2px); filter: brightness(1.08); color: #fff; }
  .loc-hero__btn svg { transition: transform 200ms; }
  .loc-hero__btn:hover svg { transform: translateX(3px); }
  .loc-hero__btn--ghost {
    background: #fff;
    color: var(--color-ink);
    border: 1px solid var(--color-line);
    box-shadow: var(--shadow-sm);
  }
  .loc-hero__btn--ghost:hover {
    background: var(--color-cream);
    border-color: var(--color-gold-400);
    color: var(--color-gold-600);
  }
  .loc-hero__stats {
    list-style: none;
    padding: 0;
    margin: 0;
    display: inline-flex;
    gap: 0;
    background: rgba(255,255,255,0.7);
    border: 1px solid rgba(199,154,8,0.18);
    border-radius: 999px;
    backdrop-filter: blur(6px);
    overflow: hidden;
  }
  .loc-hero__stats li {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    padding: 0.625rem 1.125rem;
    border-right: 1px solid rgba(199,154,8,0.18);
  }
  .loc-hero__stats li:last-child { border-right: 0; }
  .loc-hero__stats strong {
    font-family: var(--font-display);
    color: var(--color-gold-600);
    font-weight: 500;
    font-size: 1.0625rem;
    line-height: 1;
  }
  .loc-hero__stats span {
    color: var(--color-ink-mute);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
    margin-top: 0.25rem;
  }

  /* ─── BODY 2-col ──────────────────────────────────────── */
  .loc-body { padding: 4.5rem 1.25rem; }
  .loc-body__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    max-width: 72rem;
    margin: 0 auto;
  }
  @media (min-width: 960px) {
    .loc-body__grid { grid-template-columns: minmax(0, 1fr) 22rem; gap: 4rem; }
  }

  /* ─── Prose (markdown body) ───────────────────────────── */
  .loc-prose :global(h2) {
    font-family: var(--font-display);
    font-size: clamp(1.625rem, 3vw, 2rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.027em;
    color: var(--color-ink);
    margin: 2.5rem 0 1rem;
    padding-bottom: 0.625rem;
    border-bottom: 1px solid var(--color-line);
    position: relative;
    text-wrap: balance;
  }
  .loc-prose :global(h2)::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 3rem;
    height: 3px;
    background: linear-gradient(90deg, var(--color-gold-400), var(--color-gold-600));
    border-radius: 999px;
  }
  .loc-prose :global(h2:first-child) { margin-top: 0; }
  .loc-prose :global(h3) {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-gold-600);
    margin: 2rem 0 0.75rem;
  }
  .loc-prose :global(p) {
    color: var(--color-ink-soft);
    font-size: 1.0625rem;
    line-height: 1.75;
    margin: 0 0 1.25rem;
  }
  .loc-prose :global(a) {
    color: var(--color-gold-600);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(199,154,8,0.4);
    transition: text-decoration-color 150ms, color 150ms;
  }
  .loc-prose :global(a:hover) {
    color: var(--color-gold-400);
    text-decoration-color: currentColor;
  }
  .loc-prose :global(ul), .loc-prose :global(ol) {
    padding-left: 0;
    margin: 0 0 1.5rem;
    list-style: none;
  }
  .loc-prose :global(ul li), .loc-prose :global(ol li) {
    position: relative;
    padding-left: 1.5rem;
    color: var(--color-ink-soft);
    line-height: 1.7;
    margin: 0.5rem 0;
  }
  .loc-prose :global(ul li::before) {
    content: "✓";
    position: absolute;
    left: 0;
    top: 0;
    color: var(--color-gold-600);
    font-weight: 700;
  }
  .loc-prose :global(ol) { counter-reset: olc; }
  .loc-prose :global(ol li) { counter-increment: olc; }
  .loc-prose :global(ol li::before) {
    content: counter(olc);
    position: absolute;
    left: 0;
    top: 0.125rem;
    color: var(--color-gold-600);
    font-weight: 700;
    font-size: 0.8125rem;
    background: rgba(199,154,8,0.1);
    width: 1.125rem;
    height: 1.125rem;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .loc-prose :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    margin: 1.5rem 0;
    display: block;
  }
  .loc-prose :global(blockquote) {
    border-left: 3px solid var(--color-gold-400);
    padding: 0.75rem 1.25rem;
    margin: 1.5rem 0;
    background: var(--color-cream);
    border-radius: 0 8px 8px 0;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.0625rem;
  }

  /* ─── Team callout (inside prose) ─────────────────────── */
  .loc-team {
    display: block;
    background: linear-gradient(180deg, var(--color-cream) 0%, #fff 100%);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    margin: 2.5rem 0 2.5rem;
    transition: transform 280ms cubic-bezier(0.16,1,0.3,1), box-shadow 280ms;
  }
  .loc-team:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  .loc-team__media {
    background: var(--color-cream);
    overflow: hidden;
  }
  .loc-team__media img {
    width: 100%;
    height: auto;
    aspect-ratio: 16/9;
    object-fit: cover;
    display: block;
    transition: transform 600ms cubic-bezier(0.16,1,0.3,1);
  }
  .loc-team:hover .loc-team__media img { transform: scale(1.03); }
  .loc-team__body {
    padding: 1.5rem 1.75rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    text-align: center;
    align-items: center;
  }
  .loc-team__eyebrow {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-gold-600);
  }
  .loc-team__quote {
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 2vw, 1.375rem);
