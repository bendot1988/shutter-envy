---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ClearLineForm from '../../components/ClearLineForm.astro';
import FAQ from '../../components/FAQ.astro';
import { business } from '../../data/site';
import { faqPage, breadcrumbList } from '../../lib/schema';

const entry = await getEntry('pages', 'contact');
if (!entry) throw new Error('Missing pages/contact content entry');
const { Content } = await render(entry);

const jsonLd: object[] = [
  breadcrumbList([
    { name: 'Home', url: '/' },
    { name: 'Contact', url: '/contact/' },
  ]),
];
if (entry.data.faqs.length) jsonLd.push(faqPage(entry.data.faqs));
---
<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogImage={entry.data.ogImage}
  jsonLd={jsonLd}
>
  {/* ─── Hero with form ─────────────────────────────────── */}
  <section class="contact-hero">
    <div class="contact-hero__grid">
      <div class="contact-hero__copy" data-reveal="left">
        <span class="contact-hero__eyebrow">Get in Touch</span>
        <h1>{entry.data.h1}</h1>
        <div class="contact-hero__body">
          <Content />
        </div>

        <div class="contact-channels" data-reveal-children>
          <a href={`tel:${business.phoneTel}`} class="contact-channel">
            <span class="contact-channel__icon">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M20 15.5c-1.25 0-2.45-.2-3.57-.57a1 1 0 0 0-1.02.24l-2.2 2.2a15.05 15.05 0 0 1-6.59-6.59l2.2-2.2a1 1 0 0 0 .25-1.01A11.36 11.36 0 0 1 8.5 4a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1c0 9.39 7.61 17 17 17a1 1 0 0 0 1-1v-3.5a1 1 0 0 0-1-1z"/></svg>
            </span>
            <div>
              <p class="contact-channel__label">Call us</p>
              <p class="contact-channel__value">{business.phoneDisplay}</p>
            </div>
          </a>
          <a href={`mailto:${business.email}`} class="contact-channel">
            <span class="contact-channel__icon">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
            </span>
            <div>
              <p class="contact-channel__label">Email us</p>
              <p class="contact-channel__value">{business.email}</p>
            </div>
          </a>
          <div class="contact-channel contact-channel--static">
            <span class="contact-channel__icon">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5z"/></svg>
            </span>
            <div>
              <p class="contact-channel__label">Visit us</p>
              <p class="contact-channel__value">{business.address.streetAddress}, {business.address.addressLocality}, {business.address.postalCode}</p>
            </div>
          </div>
          <div class="contact-channel contact-channel--static">
            <span class="contact-channel__icon">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>
            </span>
            <div>
              <p class="contact-channel__label">Opening hours</p>
              <p class="contact-channel__value">Mon–Thu 08:30 – 17:00 · Fri 08:30 – 16:00</p>
            </div>
          </div>
        </div>
      </div>

      <div class="contact-hero__form" data-reveal="right">
        <div class="contact-hero__form-head">
          <p class="contact-hero__form-eyebrow">★ Free home survey</p>
          <h2>Get Your Free Quote in 60 Seconds</h2>
          <p class="contact-hero__form-sub">No obligation. We'll call you back to book a convenient time.</p>
        </div>
        <ClearLineForm showIntro={false} />
      </div>
    </div>
  </section>

  {/* ─── FAQs ───────────────────────────────────────────── */}
  {entry.data.faqs.length > 0 && (
    <FAQ
      items={entry.data.faqs}
      heading="Your Questions Answered"
      closingCta={{
        label: 'Talk to Mark Directly',
        href: `tel:${business.phoneTel}`,
        prompt: 'Prefer to chat?',
      }}
    />
  )}
</BaseLayout>

<style>
  .contact-hero {
    background:
      linear-gradient(180deg, rgba(249,248,244,0.85), rgba(249,248,244,0.95)),
      url('/wp-content/uploads/2026/04/ChatGPT-Image-Apr-23-2026-04_37_13-PM.jpeg') center/cover no-repeat;
    margin: 0 calc(50% - 50vw);
    padding: 4rem 1.25rem 5rem;
  }
  .contact-hero__grid {
    max-width: var(--container-wide);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: start;
  }
  @media (min-width: 1024px) {
    .contact-hero__grid { grid-template-columns: 0.95fr 1.05fr; gap: 4rem; }
  }

  .contact-hero__eyebrow {
    display: inline-block;
    background: rgba(199,154,8,0.12);
    color: var(--color-gold-600);
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-pill);
    font-size: var(--text-link-12-700);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 1.25rem;
  }
  .contact-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, var(--text-h2-60-500));
    font-weight: 500;
    line-height: 1.075;
    letter-spacing: -0.027em;
    margin: 0 0 1.25rem;
  }
  .contact-hero__body {
    color: var(--color-ink-soft);
    font-size: var(--text-large-body-19-400);
    line-height: 1.6;
    margin: 0 0 2rem;
  }
  .contact-hero__body :global(p) { margin: 0 0 1rem; }
  .contact-hero__body :global(p:last-child) { margin-bottom: 0; }

  /* Contact channels */
  .contact-channels {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }
  @media (min-width: 640px) {
    .contact-channels { grid-template-columns: repeat(2, 1fr); }
  }
  .contact-channel {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 1rem 1.125rem;
    background: rgba(255,255,255,0.92);
    border: 1px solid rgba(199,154,8,0.15);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    color: var(--color-ink);
    transition: transform 220ms, box-shadow 220ms, border-color 220ms;
  }
  a.contact-channel:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-gold-400);
  }
  .contact-channel--static { cursor: default; }
  .contact-channel__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    background: rgba(199,154,8,0.12);
    color: var(--color-gold-600);
    border-radius: 50%;
    transition: background 220ms, color 220ms;
  }
  a.contact-channel:hover .contact-channel__icon {
    background: var(--color-gold-400);
    color: #fff;
  }
  .contact-channel__label {
    font-size: var(--text-link-12-700);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-mute);
    margin: 0;
  }
  .contact-channel__value {
    font-size: var(--text-small-body-15-400);
    font-weight: 500;
    color: var(--color-ink);
    margin: 0.125rem 0 0;
    line-height: 1.35;
  }

  /* Form card */
  .contact-hero__form {
    background: #fff;
    border-radius: var(--radius-lg);
    padding: 1.75rem 1.5rem 1.5rem;
    box-shadow: var(--shadow-xl);
    border: 1px solid rgba(199,154,8,0.12);
  }
  .contact-hero__form-head { text-align: center; margin-bottom: 1.25rem; }
  .contact-hero__form-eyebrow {
    display: inline-block;
    background: rgba(199,154,8,0.12);
    color: var(--color-gold-600);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-pill);
    font-size: var(--text-link-12-700);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0 0 0.625rem;
  }
  .contact-hero__form-head h2 {
    font-family: var(--font-display);
    font-size: var(--text-h3-24-500);
    font-weight: 500;
    letter-spacing: -0.027em;
    margin: 0 0 0.375rem;
    line-height: 1.15;
  }
  .contact-hero__form-sub {
    color: var(--color-ink-mute);
    font-size: var(--text-small-body-15-400);
    line-height: 1.5;
    margin: 0;
  }
  .contact-hero__form :global(.clearline-embed) {
    background: transparent;
    padding: 0;
    border-radius: 0;
    box-shadow: none;
  }
  .contact-hero__form :global(.clearline-embed iframe) {
    min-height: 480px;
    width: 100%;
  }
</style>
