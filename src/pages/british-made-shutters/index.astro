---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AwardsCTABox from '../../components/home/AwardsCTABox.astro';
import TransformCTA from '../../components/home/TransformCTA.astro';
import InlineCTA from '../../components/home/InlineCTA.astro';
import { business } from '../../data/site';
import { breadcrumbList, service } from '../../lib/schema';

const entry = await getEntry('pages', 'british-made-shutters');
if (!entry) throw new Error('Missing pages/british-made-shutters content entry');

const jsonLd = [
  breadcrumbList([
    { name: 'Home', url: '/' },
    { name: 'British Made Shutters', url: '/british-made-shutters/' },
  ]),
  service({
    url: 'https://shutter-envy.co.uk/british-made-shutters/',
    name: 'British-made plantation shutters',
    description: 'UK-manufactured hardwood and faux-wood plantation shutters with 3–4 week lead times, surveyed and installed across Leicestershire.',
    serviceType: 'British-made window shutters',
  }),
];

// ─── Content (verbatim from original ranking page) ──────
const heroImage = '/wp-content/uploads/2025/10/TrulyBespoke-2880w-1024x768.webp';

// "At a Glance" 6 feature cards
const features = [
  { icon: 'clock',  heading: 'Lead Time',      body: '3–4 weeks from order to delivery.' },
  { icon: 'leaf',   heading: 'Material',       body: 'Sustainably sourced and recycled components; non-toxic and safe.' },
  { icon: 'thermo', heading: 'Insulation',     body: 'Retains room temperature, keeps cold air out; up to 33% reduction in heat loss.' },
  { icon: 'spark',  heading: 'Maintenance',    body: 'Easy to clean, requires only occasional wiping.' },
  { icon: 'design', heading: 'Design Options', body: 'Wide range of sizes, styles, and custom shapes, including bay and arched windows.' },
  { icon: 'shield', heading: 'Warranty',       body: '10-year guarantee on all British Made Shutters.' },
];

// Right-side checklist points
const reasons = [
  'Manufactured in the UK for fast turnaround and trusted quality',
  'Completely waterproof and highly resistant to mould, making them ideal for kitchens and bathrooms',
  'Eco-friendly: made using recycled materials and non-toxic components',
  'Superior insulation, proven to reduce heat loss through windows by up to 33%, helping you save on energy bills',
];

// 4 manufacturing photos
const factoryPhotos = [
  { src: '/wp-content/uploads/2025/10/IMG_6341.jpg', alt: 'Inside the British Made Shutters workshop in Worcestershire' },
  { src: '/wp-content/uploads/2025/10/IMG_6342.jpg', alt: 'Frame production at the British manufacturing facility' },
  { src: '/wp-content/uploads/2025/10/IMG_6344-1.jpg', alt: 'Shutter panel finishing at the BMS workshop' },
  { src: '/wp-content/uploads/2025/10/IMG_6345.jpg', alt: 'Quality control at the British Made Shutters factory' },
];

// Technical specs
const specs = [
  {
    heading: 'Multiple frame types available',
    body: 'L-Frame, Big L-Frame, Z-Frame, F-Frame, and 60mm T-Post.',
  },
  {
    heading: 'Louvre sizes',
    body: '63mm, 76mm, and 89mm.',
  },
  {
    heading: 'Tilt rod options',
    body: 'Centre, Hidden, Offset.',
  },
  {
    heading: 'Panel size limits',
    body: 'Up to 3000mm high and 850mm wide (single panel); minimums also specified.',
  },
  {
    heading: 'All measurements performed to strict tolerances',
    body: 'For a perfect fit, every panel is measured to the millimetre.',
  },
];

// Icon registry
const icon = {
  clock:  '<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>',
  leaf:   '<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M17 8C8 10 5.9 16.17 3.82 21.34l1.89.66.95-2.3c.48.17.98.3 1.34.3C19 20 22 3 22 3c-1 2-8 2.25-13 3.25S2 11.5 2 13.5s1.75 3.75 1.75 3.75C7 8 17 8 17 8z"/></svg>',
  thermo: '<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M15 13V5a3 3 0 0 0-6 0v8a5 5 0 1 0 6 0zm-3-9a1 1 0 0 1 1 1v3h-2V5a1 1 0 0 1 1-1z"/></svg>',
  spark:  '<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M9 11H7v9a2 2 0 0 0 2 2h9v-2H9V11zm12 0V9h-2V7h2V5h-2V3h-2v2h-2v2h2v2h2v2h2zM4 7h2V5H4V3H2v2H0v2h2v2h2V7z"/></svg>',
  design: '<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg>',
  shield: '<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>',
};
---
<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogImage={entry.data.ogImage}
  jsonLd={jsonLd}
>
  {/* ─── HERO ────────────────────────────────────────────── */}
  <section class="bms-hero" style={`background-image: url('${heroImage}')`}>
    <div class="bms-hero__overlay"></div>
    <div class="bms-hero__inner" data-reveal>
      <span class="bms-hero__eyebrow">★ Crafted for Quality &amp; Style</span>
      <h1>British Made Shutters</h1>
      <p>{entry.data.description}</p>
      <div class="bms-hero__lead">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>
        Quick <strong>3–4 week</strong> lead time
      </div>
      <div class="bms-hero__actions">
        <a href="/contact/" class="bms-hero__btn">
          Arrange a Home Visit
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M3 7h8m0 0L7 3m4 4l-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href={`tel:${business.phoneTel}`} class="bms-hero__phone">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M20 15.5c-1.25 0-2.45-.2-3.57-.57a1 1 0 0 0-1.02.24l-2.2 2.2a15.05 15.05 0 0 1-6.59-6.59l2.2-2.2a1 1 0 0 0 .25-1.01A11.36 11.36 0 0 1 8.5 4a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1c0 9.39 7.61 17 17 17a1 1 0 0 0 1-1v-3.5a1 1 0 0 0-1-1z"/></svg>
          Call {business.phoneDisplay}
        </a>
      </div>
    </div>
  </section>

  {/* ─── WHY CHOOSE — top: logo + reasons; bottom: feature grid ── */}
  <section class="bms-why">
    <div class="container">
      {/* Top row: logo (left) + reasons (right) */}
      <div class="bms-why__top">
        <div class="bms-why__logo" data-reveal="left">
          <div class="bms-why__logo-card">
            <img src="/wp-content/uploads/2025/10/bms-logo-5c5d9790-1920w.webp" alt="British Made Shutters" loading="lazy" />
          </div>
          <div class="bms-why__flag" aria-hidden="true">
            <span class="bms-why__flag-stripe bms-why__flag-stripe--red"></span>
            <span class="bms-why__flag-stripe bms-why__flag-stripe--white"></span>
            <span class="bms-why__flag-stripe bms-why__flag-stripe--blue"></span>
          </div>
        </div>

        <div class="bms-why__reasons" data-reveal="right">
          <span class="bms-eyebrow">Why Choose</span>
          <h2>Why Choose <em>British Made Shutters?</em></h2>
          <ul class="bms-why__list">
            {reasons.map((r) => (
              <li>
                <span class="bms-why__check" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                    <path d="M4 10.5l4 4 8-9" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span>{r}</span>
              </li>
            ))}
          </ul>
          <a href="/contact/" class="bms-why__btn">
            Arrange a Home Visit
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M3 7h8m0 0L7 3m4 4l-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>

      {/* Bottom: 6 feature cards in a clean full-width 3-col grid */}
      <ul class="bms-why__feature-grid" data-reveal-children>
        {features.map((f) => (
          <li>
            <div class="bms-why__icon" aria-hidden="true" set:html={icon[f.icon]} />
            <h3>{f.heading}</h3>
            <p>{f.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ─── BEHIND-THE-SCENES ──────────────────────────────── */}
  <section class="bms-bts" data-reveal>
    <div class="container">
      <header>
        <span class="bms-eyebrow">A Look Inside</span>
        <h2><em>Behind-the-Scenes</em> of British Manufacturing</h2>
        <p>Our British Made Shutters are crafted by skilled hands in Worcestershire, with every panel measured and finished to order.</p>
      </header>
      <ul class="bms-bts__grid" data-reveal-children>
        {factoryPhotos.map((p) => (
          <li>
            <figure>
              <img src={p.src} alt={p.alt} loading="lazy" />
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ─── TECHNICAL SPECS ────────────────────────────────── */}
  <section class="bms-specs">
    <div class="container bms-specs__grid">
      <div class="bms-specs__copy" data-reveal="left">
        <span class="bms-eyebrow">Technical Specifications</span>
        <h2>Built to a <em>Precise</em> Spec</h2>
        <p>Every frame type, louvre size, tilt mechanism and panel limit you might need — manufactured to the millimetre, measured on site.</p>
        <ul class="bms-specs__list" data-reveal-children>
          {specs.map((s) => (
            <li>
              <span class="bms-specs__check" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                  <path d="M4 10.5l4 4 8-9" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <div>
                <h3>{s.heading}</h3>
                <p>{s.body}</p>
              </div>
            </li>
          ))}
        </ul>
        <a href="/contact/" class="bms-why__btn">
          Arrange a Home Visit
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M3 7h8m0 0L7 3m4 4l-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
      <div class="bms-specs__image" data-reveal="right">
        <img src="/wp-content/uploads/2025/10/LongLasting-1920w-1024x768.webp" alt="British Made Shutters fitted to a Leicestershire window" loading="lazy" />
      </div>
    </div>
  </section>

  {/* ─── ABOUT + ECO (2-up info cards) ──────────────────── */}
  <section class="bms-info container" data-reveal>
    <ul class="bms-info__grid" data-reveal-children>
      <li>
        <span class="bms-info__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M11 7h2v2h-2zm0 4h2v6h-2zm1-9C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/></svg>
        </span>
        <h3><em>About</em> Our Manufacturing</h3>
        <p>Experience the exceptional quality of true British craftsmanship with our British Made Shutters. Manufactured in Worcestershire, UK, our shutters are eco-friendly, waterproof, and provide outstanding insulation.</p>
      </li>
      <li>
        <span class="bms-info__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M17 8C8 10 5.9 16.17 3.82 21.34l1.89.66.95-2.3c.48.17.98.3 1.34.3C19 20 22 3 22 3c-1 2-8 2.25-13 3.25S2 11.5 2 13.5s1.75 3.75 1.75 3.75C7 8 17 8 17 8z"/></svg>
        </span>
        <h3><em>Eco-Friendly</em> Commitment</h3>
        <p>We use recycled materials wherever possible, avoid harmful substances, and manufacture locally to reduce our carbon footprint. Our shutters are a sustainable choice for modern homes.</p>
      </li>
    </ul>
  </section>

  {/* ─── AWARDS CTA ─────────────────────────────────────── */}
  <AwardsCTABox
    backgroundImage="/wp-content/uploads/2026/05/01-shutter-envy.jpeg"
    eyebrow="Ready for your 5-star service?"
    heading="Ready to Transform Your Home With British Made Shutters?"
    body="Contact us for a free quote or to schedule an in-home consultation today. Get started with a no-obligation, personalised consultation."
    awardImages={[
      '/wp-content/uploads/2025/11/Shutter-Envy-Shutter-and-Blind-Company-of-the-Year-Award-winner-Leicestershire.-Shutters.-Blinds-300x78.png',
      '/wp-content/uploads/2025/11/Shutter-Envy-Shutter-and-Blind-Company-of-the-Year-Award-winner-Leicestershire.-Shutters.-Blinds-1-300x78.png',
      '/wp-content/uploads/2025/11/Shutter-Envy-Shutter-and-Blind-Company-of-the-Year-Award-winner-Leicestershire.-Shutters.-Blinds-3-300x78.png',
    ]}
    awardsCaption="Blind & Shutter Specialists of the Year"
    ctaNote="Get started today with a no-obligation, personalised consultation."
    cta={{ label: 'Arrange a Home Visit', href: '/contact/' }}
  />

  {/* ─── TRANSFORM CTA ──────────────────────────────────── */}
  <TransformCTA
    image="/wp-content/uploads/2024/11/shutter-envy.jpg"
    heading="Transform Your Home Today with Shutter Envy"
    body="Ready to elevate your living space with bespoke British Made Shutters? Our expert team is here to guide you every step of the way, from consultation to installation."
    cta={{ label: 'Arrange a Home Visit', href: '/contact/' }}
  />
</BaseLayout>

<style>
  .bms-eyebrow {
    display: inline-block;
    background: rgba(199,154,8,0.12);
    color: var(--color-gold-600);
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-pill);
    font-size: var(--text-link-12-700);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 1.25rem;
  }

  /* ─── HERO ─────────────────────────────────────────────── */
  .bms-hero {
    position: relative;
    margin: 0 calc(50% - 50vw);
    padding: 6rem 1.25rem;
    background-color: var(--color-cream);
    background-size: cover;
    background-position: center;
    text-align: center;
    overflow: hidden;
  }
  .bms-hero__overlay {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(249,248,244,0.86) 0%, rgba(249,248,244,0.94) 100%);
  }
  .bms-hero__inner {
    position: relative;
    max-width: 48rem;
    margin: 0 auto;
  }
  .bms-hero__eyebrow {
    display: inline-block;
    background: rgba(199,154,8,0.15);
    color: var(--color-gold-600);
    border: 1px solid rgba(199,154,8,0.3);
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-pill);
    font-size: var(--text-link-12-700);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }
  .bms-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, var(--text-h2-60-500));
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.027em;
    margin: 0 0 1.5rem;
    text-wrap: balance;
  }
  .bms-hero p {
    color: var(--color-ink-soft);
    font-size: var(--text-large-body-19-400);
    line-height: 1.6;
    margin: 0 0 1.5rem;
  }
  .bms-hero__lead {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.125rem;
    background: #fff;
    border: 1px solid rgba(199,154,8,0.25);
    border-radius: var(--radius-pill);
    font-size: var(--text-small-body-15-400);
    font-weight: 500;
    color: var(--color-ink);
    margin-bottom: 1.75rem;
    box-shadow: var(--shadow-sm);
  }
  .bms-hero__lead svg { color: var(--color-gold-600); }
  .bms-hero__lead strong { color: var(--color-gold-600); font-weight: 700; }
  .bms-hero__actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .bms-hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 2rem;
    background: linear-gradient(180deg, var(--color-gold-400), var(--color-gold-600));
    color: #fff;
    border-radius: var(--radius-pill);
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: var(--text-button-14-500);
    letter-spacing: 0.02em;
    text-decoration: none;
    box-shadow: 0 12px 32px -8px rgba(199,154,8,0.55), inset 0 1px 0 rgba(255,255,255,0.2);
    transition: transform 200ms, filter 200ms;
  }
  .bms-hero__btn:hover { transform: translateY(-2px); filter: brightness(1.08); color: #fff; }
  .bms-hero__btn svg { transition: transform 200ms; }
  .bms-hero__btn:hover svg { transform: translateX(3px); }
  .bms-hero__phone {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 1rem 1.75rem;
    color: var(--color-ink);
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: var(--text-button-14-500);
    letter-spacing: 0.02em;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition: all 200ms;
  }
  .bms-hero__phone:hover { background: var(--color-cream); border-color: var(--color-gold-400); color: var(--color-gold-600); }
  .bms-hero__phone svg { color: var(--color-gold-600); }

  /* ─── WHY CHOOSE ──────────────────────────────────────── */
  .bms-why {
    background: var(--color-cream);
    padding: 6rem 1.25rem;
    margin: 0 calc(50% - 50vw);
  }

  /* Top row: logo (left) + reasons (right) */
  .bms-why__top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
    max-width: 80rem;
    margin: 0 auto 4rem;
  }
  @media (min-width: 768px) {
    .bms-why__top { grid-template-columns: 0.85fr 1.15fr; gap: 4rem; }
  }

  /* Logo card */
  .bms-why__logo { display: flex; flex-direction: column; align-items: center; }
  .bms-why__logo-card {
    background: #2a2a26;
    border-radius: var(--radius-lg);
    padding: 3rem 2.5rem;
    box-shadow: var(--shadow-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 26rem;
    position: relative;
    overflow: hidden;
  }
  .bms-why__logo-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at top right, rgba(199,154,8,0.15), transparent 60%);
    pointer-events: none;
  }
  .bms-why__logo-card img {
    position: relative;
    width: 100%;
    max-width: 320px;
    height: auto;
  }
  .bms-why__flag {
    display: flex;
    gap: 0.25rem;
    margin-top: 1rem;
    width: 100%;
    max-width: 18rem;
  }
  .bms-why__flag-stripe { flex: 1; height: 4px; border-radius: 2px; }
  .bms-why__flag-stripe--red   { background: #C8102E; }
  .bms-why__flag-stripe--white { background: #fff; box-shadow: inset 0 0 0 1px var(--color-line); }
  .bms-why__flag-stripe--blue  { background: #012169; }

  /* Feature cards — bottom full-width 3-col grid */
  .bms-why__feature-grid {
    list-style: none; padding: 0; margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    max-width: 80rem;
    margin-inline: auto;
  }
  @media (min-width: 480px) { .bms-why__feature-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 960px) { .bms-why__feature-grid { grid-template-columns: repeat(3, 1fr); } }
  .bms-why__feature-grid li {
    margin: 0;
    background: #fff;
    border: 1px solid rgba(199,154,8,0.12);
    border-radius: var(--radius-lg);
    padding: 2rem 1.75rem;
    text-align: left;
    box-shadow: var(--shadow-sm);
    transition: transform 220ms, box-shadow 220ms, border-color 220ms;
  }
  .bms-why__feature-grid li:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-gold-400);
  }
  .bms-why__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: rgba(199,154,8,0.12);
    color: var(--color-gold-600);
    margin: 0 0 1rem;
    transition: background 220ms, color 220ms, transform 220ms;
  }
  .bms-why__feature-grid li:hover .bms-why__icon {
    background: var(--color-gold-400);
    color: #fff;
    transform: scale(1.05);
  }
  .bms-why__feature-grid h3 {
    font-family: var(--font-display);
    font-size: var(--text-h3-21-500);
