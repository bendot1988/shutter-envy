---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeatureChecklist from '../../components/home/FeatureChecklist.astro';
import MarqueeGallery from '../../components/MarqueeGallery.astro';
import PortchesterCallout from '../../components/PortchesterCallout.astro';
import ProcessTimeline from '../../components/home/ProcessTimeline.astro';
import ReviewsRow from '../../components/home/ReviewsRow.astro';
import InlineCTA from '../../components/home/InlineCTA.astro';
import { faqPage, breadcrumbList, service } from '../../lib/schema';

const entry = await getEntry('pages', 'our-shutters');
if (!entry) throw new Error('Missing pages/our-shutters content entry');
const { Content } = await render(entry);

const jsonLd: object[] = [
  breadcrumbList([
    { name: 'Home', url: '/' },
    { name: 'Our Shutters', url: '/our-shutters/' },
  ]),
  service({
    url: 'https://shutter-envy.co.uk/our-shutters/',
    name: 'Made-to-measure plantation shutters',
    description: 'Bespoke plantation, café-style, full-height and tier-on-tier shutters, surveyed, manufactured and installed across Leicester, Loughborough and Leicestershire.',
    serviceType: 'Window shutters',
  }),
];
if (entry.data.faqs.length) jsonLd.push(faqPage(entry.data.faqs));

// ─── Page-specific content (placeholders ready for swap) ──
const heroImage = '/wp-content/uploads/2026/04/Bay-window-shutters-in-Loughborough.jpeg';

// Marquee — placeholder images using existing installation photos.
// Swap entries here when you've added the real ones.
const marqueeImages = [
  { src: '/wp-content/uploads/2026/04/Bay-window-shutters-in-Loughborough.jpeg',                              alt: 'Bay window shutters in Loughborough' },
  { src: '/wp-content/uploads/2026/02/cafe-Style-Shutters-Shutter-Envy-in-Loughborough.jpg',                  alt: 'Café-style shutters fitted in Loughborough' },
  { src: '/wp-content/uploads/2026/04/01-Shutter-Envy-shutters-in-Loughbray-and-Leicester-.jpeg',             alt: 'Shutter Envy install in Leicester' },
  { src: '/wp-content/uploads/2026/04/02-Shutter-Envy-shutters-in-Loughbray-and-Leicester-.jpeg',             alt: 'Shutter Envy install in Loughborough' },
  { src: '/wp-content/uploads/2026/04/03-Shutter-Envy-shutters-in-Loughbray-and-Leicester-.jpeg',             alt: 'Tier-on-tier shutters in Leicester' },
  { src: '/wp-content/uploads/2026/04/04-Shutter-Envy-shutters-in-Loughbray-and-Leicester-.jpeg',             alt: 'Full-height shutters in Leicester' },
  { src: '/wp-content/uploads/2026/04/05-Shutter-Envy-shutters-in-Loughbray-and-Leicester-.jpeg',             alt: 'Bedroom shutters in Loughborough' },
  { src: '/wp-content/uploads/2026/05/01-shutter-envy.jpeg',                                                  alt: 'Recent shutter installation' },
  { src: '/wp-content/uploads/2026/05/02-shutter-envy.jpeg',                                                  alt: 'Recent shutter installation' },
  { src: '/wp-content/uploads/2026/05/03-shutter-envy.jpeg',                                                  alt: 'Recent shutter installation' },
  { src: '/wp-content/uploads/2026/04/faux-wood-shutters-kitchen-window-uk.jpeg',                             alt: 'Faux wood shutters on a kitchen window' },
  { src: '/wp-content/uploads/2026/02/Castile-shutters-in-Leicester.jpg',                                     alt: 'Castile shutters in Leicester' },
];

// Feature bullets — VERBATIM from the live-ranking copy. Do not paraphrase.
const features = [
  { heading: 'Five louvre sizes ranging from 47mm to 114mm', body: '' },
  { heading: 'Independent panel adjustments for complete light control', body: '' },
  { heading: 'Classic tilt rods for a timeless feel, or silent tilt for a minimalist look', body: '' },
  { heading: 'Fully automated louvre systems for ultimate luxury and convenience', body: '' },
  { heading: 'Excellent insulation to regulate temperature year-round', body: '' },
  { heading: '5-Star fitting service', body: '' },
];

// Installation Styles — VERBATIM copy from the live page (preserves SEO).
const styles = [
  {
    name: 'Full Height Shutters',
    body: 'This type of Installation is the most common, covering the full height of your window opening. You can choose to have all of the louvres operate together, or in two separate sections, with our "split tilt" option.',
    image: '/wp-content/uploads/2026/04/02-Shutter-Envy-shutters-in-Loughbray-and-Leicester-.jpeg',
  },
  {
    name: 'Tier-on-Tier Shutters',
    body: 'Tier-on-Tier Shutters offer you the same levels of privacy and light control as a Full Height Shutter, while giving you the added benefit of fully opening either section to enjoy a scenic view or allowing more daylight to flood into a beautiful room.',
    image: '/wp-content/uploads/2026/04/03-Shutter-Envy-shutters-in-Loughbray-and-Leicester-.jpeg',
  },
  {
    name: 'Cafe-Style Shutters',
    body: 'Cafe-Style Shutter installation is for when you only require privacy and light control to either the bottom section of your window, or a given height. Allowing daylight to flood into your room from the opening above while maintaining a high level of privacy. See our dedicated café-style shutters page for room-by-room advice.',
    image: '/wp-content/uploads/2026/02/cafe-Style-Shutters-Shutter-Envy-in-Loughborough.jpg',
    href: '/cafe-style-shutters/',
  },
  {
    name: 'Bay Window Shutters',
    body: "Bay Window Shutters are one of our speciality products. With the ability to use precisely measured and manufactured custom angled bay post, we'll ensure a perfect fit every time. Bay Windows can be fitted with any of the available styles from Full Height to Cafe-Style and Tier-on-Tier. All Shapes of Bay including Box, Hockey Stick and Bow Window bays can be transformed.",
    image: '/wp-content/uploads/2026/04/Bay-window-shutters-in-Loughborough.jpeg',
  },
  {
    name: 'Track Shutter Installations',
    body: 'Track Shutters have the ability to give you complete light and privacy control while also retaining totally function with our Free-Floating option. They are a perfect shading solution for large bifold door installations, and patio and french doors.',
    image: null,
  },
  {
    name: 'Shaped Windows',
    body: 'Shutters can be manufactured into almost any shape, from Apex windows to Arches and even portholes. One of our expert team will template and measure your shutter perfectly, to give you the shaped shutter solution you require.',
    image: null,
  },
];

// Materials — VERBATIM bullet copy from the live page.
const materials = [
  {
    name: 'Montana',
    sub: 'Hardwood',
    description: '',
    bullets: [
      'High-grade premium hardwood panels and frame',
      '50 colour pathways, including stained and painted finishes',
      'Special shapes',
      'Custom-colour option',
    ],
    image: null,
  },
  {
    name: 'Hollywood',
    sub: 'ABS',
    description: '',
    bullets: [
      '100% Waterproof product',
      'Ideal for wet areas, including shower rooms',
      '22 Colour pathways',
    ],
    image: null,
  },
  {
    name: 'Boston',
    sub: 'MDF / Hardwood',
    description: '',
    bullets: [
      'Hardwood Panels and MDF Frame',
      'Combines the strength of an MDF frame with the lightweight benefits of a hardwood panel',
      '22 Colour pathways',
    ],
    image: null,
  },
  {
    name: 'Georgia',
    sub: 'MDF / ABS',
    description: '',
    bullets: [
      'MDF frame with ABS Louvres',
      'Light weight',
      'Easy clean',
      '22 Colour pathways',
      'Polymer-coated',
    ],
    image: null,
  },
  {
    name: 'Seattle',
    sub: 'MDF',
    description: '',
    bullets: [
      'Entry-level shutter product — Strong and robust',
      '9 Colour pathways',
      'Polymer-coated',
      'Long-lasting, hard-wearing finish',
    ],
    image: null,
  },
];

// Intro paragraphs — VERBATIM "Bespoke Shutters for Every Home" copy.
// Slotted into a dedicated intro section so the original H2 + paragraphs still
// render on the page (Google reads them, ranking signals preserved).
const intro = {
  heading: 'Bespoke Shutters for Every Home',
  paragraphs: [
    "Shutter Envy designs, supplies and fits made-to-measure plantation shutters for homes across Leicester, Loughborough, Melton Mowbray, Market Harborough and surrounding Leicestershire areas. From bay window shutters to full-height, tier-on-tier and shaped window shutters, our family-run team helps you choose a style that suits your home, privacy needs and budget.",
    'We provide expert measuring, design advice and professional fitting for shutters across Leicester, Loughborough and the wider Leicestershire area.',
  ],
};

const reviews = [
  { name: 'Liz Twitchell', rating: 5, date: '1 year ago', body: "Top notch job by Mark and team yet again. From initial consultation to fitting — a totally professional, efficient and friendly experience." },
  { name: 'Wendy Harrison', rating: 5, date: '2 years ago', body: "I would like to thank Mark & Co at Shutter Envy. Their service is excellent. From the minute I contacted them they were helpful and professional." },
  { name: 'Sandra Mould', rating: 5, date: '2 years ago', body: "Fantastic service from Mark. First class product. Excellent results. Fast, efficient and perfect. So pleased." },
];

const processSteps = [
  { title: 'Schedule a Home Visit', body: "Book a time that suits you. We'll come to your home with samples.", image: '/wp-content/uploads/2024/10/106shots_so.jpeg' },
  { title: 'Personalised Home Visit', body: 'Mark brings samples and gives you a no-obligation quote on the day.', image: '/images/mark-shutter-envy-van.png' },
  { title: 'Manufacturing With Care', body: 'Your custom shutters are made to order with regular updates.', image: '/wp-content/uploads/2024/09/5bc529c6-242f-4aab-8112-67d895fc7c43-1024x768.jpg' },
  { title: 'Professional Installation', body: 'Tidy installation by our own team — no mess, perfect finish.', image: '/wp-content/uploads/2024/10/dotwall-Web-Design2024-10-07-at-14.08.01.jpeg' },
  { title: 'Enjoy Your New Shutters', body: '5-year warranty and a care brochure on installation day.', image: '/wp-content/uploads/2024/09/431555826_2629833587193609_4928996973115882659_n-300x169.jpg' },
];

const faqs = entry.data.faqs ?? [];
---
<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogImage={entry.data.ogImage}
  jsonLd={jsonLd}
>
  {/* ─── HERO ────────────────────────────────────────────── */}
  <section class="osh-hero" style={`background-image: url('${heroImage}')`}>
    <div class="osh-hero__overlay"></div>
    <div class="osh-hero__inner" data-reveal>
      <span class="osh-hero__eyebrow">Our Shutters</span>
      <h1>{entry.data.h1}</h1>
      <p>Designed, supplied and fitted by our family-run team — across Leicester, Loughborough, Melton Mowbray, Market Harborough and the surrounding villages.</p>
      <div class="osh-hero__actions">
        <a href="/contact/" class="osh-hero__btn">
          Arrange a Home Visit
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M3 7h8m0 0L7 3m4 4l-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="/our-shutters/colour-swatches/" class="osh-hero__btn osh-hero__btn--ghost">See Colour Swatches</a>
      </div>
    </div>
  </section>

  {/* ─── INTRO — preserves original ranking copy ─────────── */}
  <section class="osh-intro container" data-reveal>
    <h2>{intro.heading}</h2>
    {intro.paragraphs.map((p) => <p>{p}</p>)}
  </section>

  {/* ─── MARQUEE — auto-scrolling install gallery ──────── */}
  <MarqueeGallery images={marqueeImages} speed={55} tileWidth={340} />

  {/* ─── FEATURE CHECKLIST ──────────────────────────────── */}
  <FeatureChecklist
    heading="Made to Measure, Made to Last"
    body="Every set of shutters we fit is bespoke to the window. Here's what's standard."
    items={features}
    cta={{ label: 'Arrange a Home Visit', href: '/contact/' }}
    backgroundImage={heroImage}
  />

  {/* ─── INSTALLATION STYLES ────────────────────────────── */}
  <section class="osh-styles" data-reveal>
    <div class="osh-styles__inner container">
      <header>
        <span class="osh-eyebrow">Installation Styles</span>
        <h2>Window Shutter Installation Styles</h2>
        <p>Each style suits different windows and rooms. We'll recommend the right one during your free home survey.</p>
      </header>
      <ul class="osh-styles__grid" data-reveal-children>
        {styles.map((s) => (
          <li>
            <article class="osh-style-card">
              <div class="osh-style-card__image">
                {s.image
                  ? <img src={s.image} alt={s.name} loading="lazy" />
                  : <div class="osh-placeholder" role="img" aria-label={`${s.name} — image coming soon`}>
                      <svg viewBox="0 0 60 60" fill="none" aria-hidden="true">
                        <rect x="12" y="10" width="36" height="40" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
                        <path d="M30 10 Q30 16 22 16 M30 10 Q30 16 38 16" stroke="currentColor" stroke-width="1.2" fill="none"/>
                        <line x1="22" y1="22" x2="38" y2="22" stroke="currentColor" stroke-width="0.8"/>
                        <line x1="22" y1="28" x2="38" y2="28" stroke="currentColor" stroke-width="0.8"/>
                        <line x1="22" y1="34" x2="38" y2="34" stroke="currentColor" stroke-width="0.8"/>
                        <line x1="22" y1="40" x2="38" y2="40" stroke="currentColor" stroke-width="0.8"/>
                      </svg>
                      <span>Photo coming soon</span>
                    </div>
                }
              </div>
              <div class="osh-style-card__body">
                <h3>{s.name}</h3>
                <p>{s.body}</p>
                {'href' in s && s.href && (
                  <p class="osh-style-card__link"><a href={s.href}>Learn more →</a></p>
                )}
              </div>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ─── PORTCHESTER CALLOUT (reusable component) ───────── */}
  <PortchesterCallout />

  {/* ─── MATERIALS ──────────────────────────────────────── */}
  <section class="osh-materials" data-reveal>
    <div class="osh-materials__inner container">
      <header>
        <span class="osh-eyebrow">Shutter Materials</span>
        <h2>Window Shutter Materials</h2>
        <p>From premium hardwood to 100% waterproof ABS — we'll recommend the right material for your room and budget.</p>
      </header>
      <ul class="osh-materials__grid" data-reveal-children>
        {materials.map((m) => (
          <li>
            <article class="osh-material-card">
              <div class="osh-material-card__image">
                {m.image
                  ? <img src={m.image} alt={`${m.name} ${m.sub} shutter sample`} loading="lazy" />
                  : <div class="osh-placeholder osh-placeholder--material" role="img" aria-label={`${m.name} swatch — image coming soon`}>
                      <span class="osh-placeholder__label">{m.sub}</span>
                      <svg viewBox="0 0 40 60" fill="none" aria-hidden="true">
                        <rect x="6" y="6" width="28" height="48" rx="1" stroke="currentColor" stroke-width="1.2"/>
                        <line x1="10" y1="14" x2="30" y2="14" stroke="currentColor" stroke-width="0.6"/>
                        <line x1="10" y1="22" x2="30" y2="22" stroke="currentColor" stroke-width="0.6"/>
                        <line x1="10" y1="30" x2="30" y2="30" stroke="currentColor" stroke-width="0.6"/>
                        <line x1="10" y1="38" x2="30" y2="38" stroke="currentColor" stroke-width="0.6"/>
                        <line x1="10" y1="46" x2="30" y2="46" stroke="currentColor" stroke-width="0.6"/>
                      </svg>
                    </div>
                }
              </div>
              <div class="osh-material-card__body">
                <h3>{m.name} <span>· {m.sub}</span></h3>
                {m.description && <p>{m.description}</p>}
                <ul>
                  {m.bullets.map((b) => <li>{b}</li>)}
                </ul>
              </div>
            </article>
          </li>
        ))}
      </ul>
      <p class="osh-materials__cta">
        Want to see the finishes? <a href="/our-shutters/colour-swatches/">Browse our full range of colour swatches →</a>
      </p>
    </div>
  </section>

  {/* ─── PROCESS TIMELINE (reused) ──────────────────────── */}
  <ProcessTimeline steps={processSteps} />

  {/* ─── REVIEWS (reused) ───────────────────────────────── */}
  <ReviewsRow
    heading="What Our Customers Say"
    rating="5.0"
    totalReviews="25"
    source="Google"
    link="https://www.google.com/maps/place/Shutter+Envy+Ltd/@52.7208272,-1.1413311,15z"
    reviews={reviews}
  />

  {/* (Markdown body intentionally not rendered here — all original copy is
     now placed verbatim in the structured sections above so Google reads
     it once, in a clean semantic location.) */}

  {/* ─── END CTA ────────────────────────────────────────── */}
  <InlineCTA
    eyebrow="Ready to Get Started?"
    heading="Book Your Free Home Survey"
    body="Mark visits your home with samples, takes measurements, and gives you a no-obligation quote on the day. Most surveys are booked within a few days."
    cta={{ label: 'Arrange a Home Visit', href: '/contact/' }}
    secondaryCta={{ label: 'Call 07729 572277', href: 'tel:+447729572277' }}
    tone="gold"
  />
</BaseLayout>

<style>
  /* ─── Shared utility eyebrow ──────────────────────────── */
  .osh-eyebrow {
    display: inline-block;
    background: rgba(199,154,8,0.12);
    color: var(--color-gold-600);
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-pill);
    font-size: var(--text-link-12-700);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 1.25rem;
  }

  /* ─── HERO ────────────────────────────────────────────── */
  .osh-hero {
    position: relative;
    margin: 0 calc(50% - 50vw);
    padding: 5rem 1.25rem 5.5rem;
    background-color: var(--color-cream);
    background-size: cover;
    background-position: center;
    text-align: center;
    overflow: hidden;
  }
  .osh-hero__overlay {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(249,248,244,0.86) 0%, rgba(249,248,244,0.94) 100%);
  }
  .osh-hero__inner { position: relative; max-width: 48rem; margin: 0 auto; }
  .osh-hero__eyebrow {
    display: inline-block;
    background: rgba(199,154,8,0.12);
    color: var(--color-gold-600);
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-pill);
    font-size: var(--text-link-12-700);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 1.25rem;
  }
  .osh-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, var(--text-h2-60-500));
    font-weight: 500;
    line-height: 1.075;
    letter-spacing: -0.027em;
    margin: 0 0 1.5rem;
    text-wrap: balance;
  }
  .osh-hero p {
    color: var(--color-ink-soft);
    font-size: var(--text-large-body-19-400);
    line-height: 1.6;
    margin: 0 0 2rem;
    max-width: 36rem;
    margin-left: auto;
    margin-right: auto;
  }
  .osh-hero__actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .osh-hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.875rem;
    background: linear-gradient(180deg, var(--color-gold-400), var(--color-gold-600));
    color: #fff;
    border-radius: var(--radius-pill);
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: var(--text-button-14-500);
    letter-spacing: 0.02em;
    text-decoration: none;
    box-shadow: 0 12px 32px -8px rgba(199,154,8,0.55), inset 0 1px 0 rgba(255,255,255,0.2);
    transition: transform 200ms, filter 200ms;
  }
  .osh-hero__btn:hover { transform: translateY(-2px); filter: brightness(1.08); color: #fff; }
  .osh-hero__btn svg { transition: transform 200ms; }
  .osh-hero__btn:hover svg { transform: translateX(3px); }
  .osh-hero__btn--ghost {
    background: #fff;
    color: var(--color-ink);
    border: 1px solid var(--color-line);
    box-shadow: var(--shadow-sm);
  }
  .osh-hero__btn--ghost:hover {
    background: var(--color-cream);
    border-color: var(--color-gold-400);
    color: var(--color-gold-600);
  }

  /* ─── INTRO (verbatim ranking copy) ──────────────────── */
  .osh-intro {
    max-width: 48rem;
    padding: 4rem 1.25rem 1rem;
    text-align: center;
  }
  .osh-intro h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, var(--text-h2-60-500));
    font-weight: 500;
    line-height: 1.075;
    letter-spacing: -0.027em;
    margin: 0 0 1.5rem;
    text-wrap: balance;
  }
  .osh-intro p {
    color: var(--color-ink-soft);
    font-size: var(--text-large-body-19-400);
    line-height: 1.6;
    margin: 0 auto 1rem;
    max-width: 40rem;
  }

  /* ─── STYLES SECTION ─────────────────────────────────── */
  .osh-styles { padding: 6rem 0 5rem; background: #fff; }
  .osh-styles__inner { padding: 0 1.25rem; }
  .osh-styles header { text-align: center; max-width: 44rem; margin: 0 auto 3rem; }
  .osh-styles h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, var(--text-h2-60-500));
    font-weight: 500;
    line-height: 1.075;
    letter-spacing: -0.027em;
    margin: 0 0 1rem;
  }
  .osh-styles header p {
    color: var(--color-ink-soft);
    font-size: var(--text-large-body-19-400);
    line-height: 1.6;
    margin: 0;
  }
  .osh-styles__grid {
    list-style: none; padding: 0; margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 640px) { .osh-styles__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .osh-styles__grid { grid-template-columns: repeat(3, 1fr); } }
  .osh-styles__grid li { margin: 0; }

  .osh-style-card {
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform 280ms cubic-bezier(0.16,1,0.3,1), box-shadow 280ms, border-color 280ms;
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  .osh-style-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-gold-400);
  }
  .osh-style-card__image { overflow: hidden; background: var(--color-cream); }
  .osh-style-card__image img,
  .osh-style-card__image > div {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    display: block;
    transition: transform 600ms cubic-bezier(0.16,1,0.3,1);
  }
  .osh-style-card:hover .osh-style-card__image img { transform: scale(1.05); }
  .osh-style-card__body { padding: 1.5rem 1.75rem 1.75rem; }
  .osh-style-card h3 {
    font-family: var(--font-display);
    color: var(--color-gold-600);
    font-size: var(--text-h3-24-500);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.027em;
    margin: 0 0 0.625rem;
  }
  .osh-style-card p {
    color: var(--color-ink-soft);
    font-size: var(--text-small-body-15-400);
    line-height: 1.65;
    margin: 0;
  }
  .osh-style-card__link {
    margin: 0.875rem 0 0 !important;
  }
  .osh-style-card__link a {
