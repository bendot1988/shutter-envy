---
// Brand / design-system reference page for Shutter Envy.
import BaseLayout from '../../layouts/BaseLayout.astro';

const colours = [
  { name: 'Gold 400 (Brand Primary)', hex: '#C79A08', token: '--color-gold-400', use: 'CTAs, accents, links' },
  { name: 'Gold 600 (Brand Dark)',    hex: '#8B6900', token: '--color-gold-600', use: 'Hover, italic emphasis' },
  { name: 'Cream',                    hex: '#F9F8F4', token: '--color-cream',    use: 'Soft section backgrounds' },
  { name: 'Ink',                      hex: '#070707', token: '--color-ink',      use: 'Body text' },
  { name: 'Ink Soft',                 hex: '#3E3E3E', token: '--color-ink-soft', use: 'Secondary text' },
  { name: 'Ink Mute',                 hex: '#565656', token: '--color-ink-mute', use: 'Captions, meta' },
  { name: 'Line',                     hex: '#E3E3E3', token: '--color-line',     use: 'Borders, dividers' },
  { name: 'White',                    hex: '#FFFFFF', token: '#fff',             use: 'Backgrounds, inverted text' },
];

const goldRamp = [
  { name: 'Gold 50',  hex: '#FAF4DD' },
  { name: 'Gold 100', hex: '#F0DFA0' },
  { name: 'Gold 200', hex: '#E5C772' },
  { name: 'Gold 300', hex: '#D8B440' },
  { name: 'Gold 400', hex: '#C79A08' },
  { name: 'Gold 500', hex: '#B68A07' },
  { name: 'Gold 600', hex: '#8B6900' },
  { name: 'Gold 700', hex: '#6E5300' },
];

const typeStyles = [
  { name: 'h2-60-500',          font: 'Spectral 500',         size: '60 / 70.5 / -1.62', sample: 'Award-Winning Shutters', class: 'demo-h2-60' },
  { name: 'h2-30-500',          font: 'Spectral 500',         size: '30 / 35.25 / -0.81', sample: 'Inline Section Heading',  class: 'demo-h2-30' },
  { name: 'h4-28-500',          font: 'Spectral 500',         size: '28 / 39.76 / -0.756', sample: 'Subsection Title',       class: 'demo-h4-28' },
  { name: 'h3-24-500',          font: 'Spectral 500',         size: '24 / 28.8 / -0.648',  sample: 'Card Title',             class: 'demo-h3-24' },
  { name: 'subheading-22-500',  font: 'Spectral 500',         size: '22.5 / 42.19',        sample: 'Featured copy lead-in',  class: 'demo-sub-22' },
  { name: 'h3-21-500',          font: 'Spectral 500',         size: '21 / 25.2 / -0.567',  sample: 'Compact Card Title',     class: 'demo-h3-21' },
  { name: 'h5-20-500',          font: 'Spectral 500',         size: '20 / 23.74 / -0.3',   sample: 'List item heading',      class: 'demo-h5-20' },
  { name: 'large-body-19-400',  font: 'Libre Franklin 400',   size: '19 / 35.625',         sample: 'A lead paragraph that draws people in.', class: 'demo-large-19' },
  { name: 'subheading-21-400',  font: 'Libre Franklin 400',   size: '21 / 39.375',         sample: 'Subheading sans-serif.', class: 'demo-sub-21' },
  { name: 'body-18-700',        font: 'Libre Franklin 700',   size: '18 / 24',             sample: 'Bold body text for emphasis.', class: 'demo-body-18' },
  { name: 'body-16-400',        font: 'Libre Franklin 400',   size: '16 / 30',             sample: 'Standard body copy for reading.', class: 'demo-body-16' },
  { name: 'small-body-15-400',  font: 'Libre Franklin 400',   size: '15 / 28.125',         sample: 'Card descriptions and meta.', class: 'demo-small-15' },
  { name: 'button-14-500',      font: 'Libre Franklin 500',   size: '14 / 24',             sample: 'BUTTON LABEL',           class: 'demo-button-14' },
  { name: 'link-12-700',        font: 'Libre Franklin 700',   size: '12 / 22.5',           sample: 'OVERLINE / EYEBROW',     class: 'demo-link-12' },
];

const shadows = [
  { name: '--shadow-sm', desc: 'Subtle base for resting cards' },
  { name: '--shadow-md', desc: 'Hover state on cards' },
  { name: '--shadow-lg', desc: 'Featured cards, dropdowns' },
  { name: '--shadow-xl', desc: 'Lifted hero form, modal panels' },
  { name: '--shadow-gold', desc: 'Gold-tinted bloom (CTAs)' },
];

const radii = [
  { name: '--radius-sm', value: '6px' },
  { name: '--radius-md', value: '12px' },
  { name: '--radius-lg', value: '16px' },
  { name: '--radius-xl', value: '24px' },
  { name: '--radius-pill', value: '999px' },
];

const capRules = [
  { title: 'Page & Section Headings', rule: 'Title Case', example: 'Have You Experienced Shutter Envy?' },
  { title: 'Card Titles',             rule: 'Title Case', example: 'Premium Quality Materials' },
  { title: 'Buttons & CTAs',          rule: 'Title Case', example: 'Arrange a Home Visit' },
  { title: 'Eyebrows & Overlines',    rule: 'UPPERCASE',  example: 'READY FOR YOUR 5-STAR SERVICE?' },
  { title: 'Body Copy',               rule: 'Sentence case', example: 'We design and fit made-to-measure shutters across Leicestershire.' },
  { title: 'Lowercase exceptions in titles', rule: 'a, an, the, and, but, or, at, by, for, in, of, on, to, with — unless first or last word', example: 'Years in the Shutter Industry · Customisable to Fit Any Space' },
];
---
<BaseLayout
  title="Shutter Envy Brand Guidelines | Design System"
  description="Shutter Envy brand guidelines: colours, typography, buttons, shadows and animation tokens used across shutter-envy.co.uk. Reference for keeping new pages on-brand."
>
  <article class="brand-page">
    <header class="brand-hero" data-reveal>
      <p class="brand-hero__eyebrow">Design System</p>
      <h1>Shutter Envy <em>Brand</em> Guidelines</h1>
      <p class="brand-hero__sub">Every token, every component, exactly as it renders on the live site. Use this page to keep new pages on-brand.</p>
    </header>

    {/* ─── Colours ─────────────────────────────────────────── */}
    <section class="brand-section" data-reveal>
      <div class="brand-section__head">
        <span class="brand-section__num">01</span>
        <h2>Colour Palette</h2>
        <p>Verified against the Peek brand audit (2026-05-16). Every value is the exact hex used on shutter-envy.co.uk.</p>
      </div>
      <div class="brand-colours" data-reveal-children>
        {colours.map((c) => (
          <article class="brand-colour" style={`--swatch: ${c.hex};`}>
            <div class="brand-colour__swatch" />
            <div class="brand-colour__meta">
              <p class="brand-colour__name">{c.name}</p>
              <p class="brand-colour__hex">{c.hex}</p>
              <p class="brand-colour__token">{c.token}</p>
              <p class="brand-colour__use">{c.use}</p>
            </div>
          </article>
        ))}
      </div>

      <div class="brand-subhead">Gold ramp</div>
      <ul class="brand-ramp" data-reveal-children>
        {goldRamp.map((s) => (
          <li style={`--swatch: ${s.hex};`}>
            <span class="brand-ramp__chip" />
            <span class="brand-ramp__label">{s.name}<br/><code>{s.hex}</code></span>
          </li>
        ))}
      </ul>

      <div class="brand-subhead">Brand Gradient</div>
      <div class="brand-gradient" data-reveal>
        <p><code>linear-gradient(180deg, #F9F8F4 0%, #FFFFFF 100%)</code></p>
      </div>
    </section>

    {/* ─── Typography ──────────────────────────────────────── */}
    <section class="brand-section" data-reveal>
      <div class="brand-section__head">
        <span class="brand-section__num">02</span>
        <h2>Typography</h2>
        <p>Spectral (serif) for display, Libre Franklin (sans) for body and UI. Letter-spacing is baked into the type scale — don't override.</p>
      </div>

      <ul class="brand-type" data-reveal-children>
        {typeStyles.map((t) => (
          <li class="brand-type__row">
            <div class="brand-type__meta">
              <code>{t.name}</code>
              <span>{t.font}</span>
              <span>{t.size}</span>
            </div>
            <div class={`brand-type__sample ${t.class}`}>{t.sample}</div>
          </li>
        ))}
      </ul>
    </section>

    {/* ─── Buttons ─────────────────────────────────────────── */}
    <section class="brand-section" id="brand-buttons" data-reveal>
      <div class="brand-section__head">
        <span class="brand-section__num">03</span>
        <h2>Buttons &amp; CTAs</h2>
        <p>All buttons use Libre Franklin 500 at 14px (button-14-500) with letter-spacing 0.02em. Pill radius (999px) is the brand default.</p>
      </div>
      <div class="brand-buttons" data-reveal-children>
        <div class="brand-buttons__row">
          <span class="button" role="img" aria-label="Primary pill button example">Primary Pill</span>
          <span class="button-ghost" role="img" aria-label="Ghost pill button example">Ghost Pill</span>
        </div>
        <div class="brand-buttons__row">
          <span class="demo-btn-gold" role="img" aria-label="Gold gradient button example">Gold Gradient</span>
          <span class="demo-btn-pill-white" role="img" aria-label="White pill button example">White Pill</span>
        </div>
      </div>
    </section>

    {/* ─── Shadows & Radius ────────────────────────────────── */}
    <section class="brand-section" data-reveal>
      <div class="brand-section__head">
        <span class="brand-section__num">04</span>
        <h2>Shadows &amp; Radius</h2>
        <p>Use the scale; don't invent custom drop shadows or border-radius values.</p>
      </div>

      <div class="brand-subhead">Shadow scale</div>
      <ul class="brand-shadows" data-reveal-children>
        {shadows.map((s) => (
          <li>
            <div class={`brand-shadow__chip brand-shadow__${s.name.replace('--shadow-', '')}`}></div>
            <p><code>{s.name}</code></p>
            <p>{s.desc}</p>
          </li>
        ))}
      </ul>

      <div class="brand-subhead">Radius scale</div>
      <ul class="brand-radii" data-reveal-children>
        {radii.map((r) => (
          <li>
            <div class="brand-radius__chip" style={`border-radius: ${r.value};`}></div>
            <p><code>{r.name}</code></p>
            <p>{r.value}</p>
          </li>
        ))}
      </ul>
    </section>

    {/* ─── Capitalisation ──────────────────────────────────── */}
    <section class="brand-section" data-reveal>
      <div class="brand-section__head">
        <span class="brand-section__num">05</span>
        <h2>Capitalisation Rules</h2>
        <p>Consistency in casing keeps the site looking professional. Defaults below.</p>
      </div>
      <ul class="brand-caps" data-reveal-children>
        {capRules.map((c) => (
          <li>
            <p class="brand-caps__title">{c.title}</p>
            <p class="brand-caps__rule">{c.rule}</p>
            <p class="brand-caps__example">{c.example}</p>
          </li>
        ))}
      </ul>
    </section>

    {/* ─── Intro Animations ────────────────────────────────── */}
    <section class="brand-section" data-reveal>
      <div class="brand-section__head">
        <span class="brand-section__num">06</span>
        <h2>Intro Animations</h2>
        <p>Sections fade up as they enter the viewport. Add <code>data-reveal</code> to a wrapper; <code>data-reveal-children</code> to stagger its direct children.</p>
      </div>
      <ul class="brand-anims" data-reveal-children>
        <li>
          <p><code>data-reveal</code></p>
          <p>Fade up (default). 28px slide, 700ms, ease <code>cubic-bezier(0.16, 1, 0.3, 1)</code>.</p>
        </li>
        <li>
          <p><code>data-reveal="left"</code></p>
          <p>Slides in from the left. Used on 2-column intros (Product Showcase, Bay Windows).</p>
        </li>
        <li>
          <p><code>data-reveal="right"</code></p>
          <p>Slides in from the right. Pairs with "left" in 2-col layouts.</p>
        </li>
        <li>
          <p><code>data-reveal="fade"</code></p>
          <p>Opacity only, no slide. Used for elements that shouldn't shift position.</p>
        </li>
        <li>
          <p><code>data-reveal="scale"</code></p>
          <p>Scales from 0.97 → 1 with fade. Used on the Awards CTA box.</p>
        </li>
        <li>
          <p><code>data-reveal-children</code></p>
          <p>Staggers direct children (60ms + 70ms per child up to 12). Used on grids.</p>
        </li>
        <li>
          <p><code>prefers-reduced-motion</code></p>
          <p>All reveal animations are disabled if the user has reduced motion enabled — content shows instantly.</p>
        </li>
      </ul>
    </section>

    {/* ─── Hover Animations ────────────────────────────────── */}
    <section class="brand-section" data-reveal>
      <div class="brand-section__head">
        <span class="brand-section__num">07</span>
        <h2>Hover Animations</h2>
        <p>Every interactive element lifts on hover. Consistency in timing is more important than the exact pattern.</p>
      </div>
      <div class="brand-hovers" data-reveal-children>
        <div class="demo-hover-card">
          <p class="demo-hover-card__title">Card lift</p>
          <p class="demo-hover-card__desc">220ms · translateY(-3px) · shadow grows from sm → md → lg. Used on every clickable card.</p>
        </div>
        <div class="demo-hover-img">
          <img src="/images/mark-shutter-envy-van.png" alt="Shutter Envy branded van used for home surveys" loading="lazy" decoding="async" />
          <p class="demo-hover-img__desc">Image tile · scale(1.06) on hover · 600ms · gold gradient overlay fades in</p>
        </div>
        <div class="demo-hover-btn">
          <span class="demo-hover-link">Hover me</span>
          <p>Button · translateY(-1px) · background gold-400 → gold-600 · 200ms</p>
        </div>
        <div class="demo-hover-icon">
          <div class="demo-hover-icon__shape">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          </div>
          <p>Icon · background fills gold + scales 1.05 + colour inverts to white</p>
        </div>
      </div>
    </section>

    <footer class="brand-foot" data-reveal>
      <p>This page is <code>noindex</code> and not linked from the public navigation. Add to <code>/brand/</code> in the URL.</p>
    </footer>
  </article>
</BaseLayout>

<style>
  .brand-page {
    max-width: 76rem;
    margin: 0 auto;
    padding: 3rem 1.25rem 6rem;
  }

  /* ─── Hero ─────────────────────────────────────────────── */
  .brand-hero { text-align: center; padding: 3rem 0 4rem; }
  .brand-hero__eyebrow {
    display: inline-block;
    background: rgba(199,154,8,0.12);
    color: var(--color-gold-600);
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-pill);
    font-size: var(--text-link-12-700);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 1rem;
  }
  .brand-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5.5vw, var(--text-h2-60-500));
    font-weight: 500;
    line-height: 1.075;
    letter-spacing: -0.027em;
    margin: 0 0 1rem;
  }
  .brand-hero h1 em {
    color: var(--color-gold-600);
    font-style: italic;
    font-weight: 500;
  }
  .brand-hero__sub {
    color: var(--color-ink-soft);
    max-width: 38rem;
    margin: 0 auto;
    font-size: var(--text-large-body-19-400);
    line-height: 1.6;
  }

  /* ─── Section ──────────────────────────────────────────── */
  .brand-section {
    border-top: 1px solid var(--color-line);
    padding: 5rem 0;
  }
  .brand-section__head {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.25rem 2rem;
    align-items: start;
    margin-bottom: 3rem;
  }
  .brand-section__num {
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 500;
    color: var(--color-gold-600);
    line-height: 1;
    grid-row: span 2;
  }
  .brand-section h2 {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, var(--text-h2-30-500));
    font-weight: 500;
    line-height: 1.175;
    letter-spacing: -0.027em;
    margin: 0;
  }
  .brand-section__head p {
    grid-column: 2;
    color: var(--color-ink-soft);
    font-size: var(--text-body-16-400);
    margin: 0;
    max-width: 44rem;
    line-height: 1.6;
  }

  .brand-subhead {
    font-family: var(--font-display);
    font-size: var(--text-h5-20-500);
    margin: 3rem 0 1.25rem;
    color: var(--color-ink);
    font-weight: 500;
    letter-spacing: -0.015em;
  }

  /* ─── Colours ──────────────────────────────────────────── */
  .brand-colours {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 1rem;
  }
  .brand-colour {
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform 220ms cubic-bezier(0.16,1,0.3,1), box-shadow 220ms;
  }
  .brand-colour:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
  .brand-colour__swatch {
    height: 100px;
    background: var(--swatch);
    border-bottom: 1px solid var(--color-line);
  }
  .brand-colour__meta { padding: 1rem 1.125rem; }
  .brand-colour__name { font-family: var(--font-display); font-weight: 500; margin: 0; font-size: 1rem; }
  .brand-colour__hex { font-family: ui-monospace, Menlo, monospace; color: var(--color-ink); margin: 0.25rem 0 0; font-size: 0.875rem; }
  .brand-colour__token { font-family: ui-monospace, Menlo, monospace; color: var(--color-gold-600); margin: 0.125rem 0 0.625rem; font-size: 0.75rem; }
  .brand-colour__use { color: var(--color-ink-mute); font-size: var(--text-small-body-15-400); margin: 0; line-height: 1.4; }

  .brand-ramp { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 0.5rem; }
  .brand-ramp li { margin: 0; }
  .brand-ramp__chip { display: block; height: 64px; background: var(--swatch); border-radius: var(--radius-sm); box-shadow: var(--shadow-sm); }
  .brand-ramp__label { display: block; font-family: var(--font-sans); font-size: var(--text-small-body-15-400); margin-top: 0.5rem; }
  .brand-ramp__label code { font-family: ui-monospace, Menlo, monospace; color: var(--color-ink-mute); font-size: 0.75rem; }

  .brand-gradient {
    background: var(--gradient-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    padding: 2.5rem 1.5rem;
    text-align: center;
  }
  .brand-gradient code { font-family: ui-monospace, Menlo, monospace; font-size: 0.875rem; color: var(--color-ink-soft); }

  /* ─── Typography ───────────────────────────────────────── */
  .brand-type { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; }
  .brand-type__row {
    margin: 0;
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    align-items: center;
    transition: border-color 200ms, box-shadow 200ms;
  }
  @media (min-width: 768px) { .brand-type__row { grid-template-columns: 18rem 1fr; } }
  .brand-type__row:hover { border-color: var(--color-gold-400); box-shadow: var(--shadow-sm); }
  .brand-type__meta { display: flex; flex-direction: column; gap: 0.25rem; }
  .brand-type__meta code { font-family: ui-monospace, Menlo, monospace; color: var(--color-gold-600); font-size: 0.8125rem; }
  .brand-type__meta span { color: var(--color-ink-mute); font-size: 0.75rem; }

  /* Type sample classes — render each named style exactly */
  .demo-h2-60   { font-family: var(--font-display); font-weight: 500; font-size: 60px; line-height: 70.5px; letter-spacing: -1.62px; }
  .demo-h2-30   { font-family: var(--font-display); font-weight: 500; font-size: 30px; line-height: 35.25px; letter-spacing: -0.81px; }
  .demo-h4-28   { font-family: var(--font-display); font-weight: 500; font-size: 28px; line-height: 39.76px; letter-spacing: -0.756px; }
  .demo-h3-24   { font-family: var(--font-display); font-weight: 500; font-size: 24px; line-height: 28.8px; letter-spacing: -0.648px; }
  .demo-sub-22  { font-family: var(--font-display); font-weight: 500; font-size: 22.5px; line-height: 42.1875px; }
  .demo-h3-21   { font-family: var(--font-display); font-weight: 500; font-size: 21px; line-height: 25.2px; letter-spacing: -0.567px; }
  .demo-h5-20   { font-family: var(--font-display); font-weight: 500; font-size: 20px; line-height: 23.74px; letter-spacing: -0.3px; }
  .demo-large-19{ font-family: var(--font-sans);   font-weight: 400; font-size: 19px; line-height: 35.625px; }
  .demo-sub-21  { font-family: var(--font-sans);   font-weight: 400; font-size: 21px; line-height: 39.375px; }
  .demo-body-18 { font-family: var(--font-sans);   font-weight: 700; font-size: 18px; line-height: 24px; }
  .demo-body-16 { font-family: var(--font-sans);   font-weight: 400; font-size: 16px; line-height: 30px; }
  .demo-small-15{ font-family: var(--font-sans);   font-weight: 400; font-size: 15px; line-height: 28.125px; }
  .demo-button-14{ font-family: var(--font-sans);  font-weight: 500; font-size: 14px; line-height: 24px; letter-spacing: 0.02em; text-transform: uppercase; }
  .demo-link-12 { font-family: var(--font-sans);   font-weight: 700; font-size: 12px; line-height: 22.5px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-gold-600); }

  /* ─── Buttons ──────────────────────────────────────────── */
  .brand-buttons { display: flex; flex-direction: column; gap: 1.25rem; }
  .brand-buttons__row { display: flex; flex-wrap: wrap; gap: 1rem; }
  .demo-btn-gold {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.875rem 1.75rem;
    background: linear-gradient(180deg, var(--color-gold-400), var(--color-gold-600));
    color: #fff; border-radius: var(--radius-pill);
    font-family: var(--font-sans); font-weight: 500;
    font-size: var(--text-button-14-500); letter-spacing: 0.02em;
    text-decoration: none;
    box-shadow: 0 12px 32px -8px rgba(199,154,8,0.55), inset 0 1px 0 rgba(255,255,255,0.2);
    transition: transform 200ms, filter 200ms;
  }
  .demo-btn-gold:hover { transform: translateY(-2px); filter: brightness(1.08); color: #fff; }
  .demo-btn-pill-white {
    display: inline-flex; padding: 0.875rem 1.75rem;
    background: #fff; color: var(--color-ink);
