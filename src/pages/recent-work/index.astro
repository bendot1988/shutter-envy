---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Gallery from '../../components/Gallery.astro';
import InlineCTA from '../../components/home/InlineCTA.astro';
import { breadcrumbList } from '../../lib/schema';

const entry = await getEntry('pages', 'recent-work');
if (!entry) throw new Error('Missing pages/recent-work content entry');
const { Content } = await render(entry);

const jsonLd = [
  breadcrumbList([
    { name: 'Home', url: '/' },
    { name: 'Recent Work', url: '/recent-work/' },
  ]),
];
---
<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogImage={entry.data.ogImage}
  jsonLd={jsonLd}
>
  <section class="rw-hero" data-reveal>
    <span class="rw-hero__eyebrow">Recent Work</span>
    <h1>{entry.data.h1}</h1>
    <p>{entry.data.description}</p>
  </section>

  {entry.data.gallery.length > 0 && (
    <div class="rw-gallery container">
      <Gallery images={entry.data.gallery} />
    </div>
  )}

  <section class="rw-intro container" data-reveal>
    <Content />
  </section>

  <InlineCTA
    eyebrow="Like What You See?"
    heading="Imagine It in Your Home"
    body="Every installation starts with a free, no-obligation home survey. Mark visits with samples, takes the measurements, and you get a quote on the day."
    cta={{ label: 'Arrange a Home Visit', href: '/contact/' }}
    secondaryCta={{ label: 'See Reviews', href: '/reviews/' }}
    tone="gold"
  />
</BaseLayout>

<style>
  .rw-hero {
    text-align: center;
    padding: 5rem 1.25rem 3rem;
    max-width: 48rem;
    margin: 0 auto;
  }
  .rw-hero__eyebrow {
    display: inline-block;
    background: rgba(199,154,8,0.12);
    color: var(--color-gold-600);
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-pill);
    font-size: var(--text-link-12-700);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 1.25rem;
  }
  .rw-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, var(--text-h2-60-500));
    font-weight: 500;
    line-height: 1.075;
    letter-spacing: -0.027em;
    margin: 0 0 1.25rem;
  }
  .rw-hero p {
    color: var(--color-ink-soft);
    font-size: var(--text-large-body-19-400);
    line-height: 1.6;
    margin: 0;
  }

  .rw-gallery { padding: 0 1.25rem 4rem; }

  .rw-intro {
    padding: 0 1.25rem 5rem;
    max-width: 44rem;
    font-size: var(--text-body-16-400);
    line-height: 1.875;
    color: var(--color-ink);
  }
  .rw-intro :global(h2), .rw-intro :global(h3) {
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: -0.027em;
  }
  .rw-intro :global(p) { margin: 0 0 1.5rem; }
  .rw-intro :global(a) {
    color: var(--color-gold-600);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(199,154,8,0.4);
  }
  .rw-intro :global(a:hover) { color: var(--color-gold-400); }
</style>
