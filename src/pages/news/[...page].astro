---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { breadcrumbList } from '../../lib/schema';
import { plainTextExcerpt } from '../../lib/text';
import {
  BLOG_CATEGORY_BY_SLUG,
  BLOG_CATEGORY_LABELS,
  BLOG_CATEGORY_ORDER,
  type BlogCategoryId,
} from '../../data/blog-categories';

// One static page only — client-side filter + search across all posts.
// We keep the [...page].astro filename so the existing route shape doesn't
// change (sitemap still resolves /news/). Pagination removed.
export async function getStaticPaths() {
  return [{ params: { page: undefined }, props: {} }];
}

const posts = (await getCollection('blog')).sort(
  (a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate),
);

type PostWithMeta = (typeof posts)[number] & {
  _category: BlogCategoryId;
  _categoryLabel: string;
  _excerptPlain: string;
};

function categoryForPost(slug: string): BlogCategoryId {
  const cat = BLOG_CATEGORY_BY_SLUG[slug];
  if (!cat) {
    throw new Error(
      `Missing news category for blog post "${slug}". Add it to src/data/blog-categories.ts.`,
    );
  }
  return cat;
}

const enriched: PostWithMeta[] = posts.map((p) => {
  const _excerptPlain = p.data.excerpt ? plainTextExcerpt(p.data.excerpt) : '';
  const _category = categoryForPost(p.id);
  return Object.assign(p, {
    _category,
    _categoryLabel: BLOG_CATEGORY_LABELS[_category],
    _excerptPlain,
  });
});

const categoryCounts: Record<BlogCategoryId, number> = {
  portchester: 0,
  awnings: 0,
  blinds: 0,
  'bay-windows': 0,
  guides: 0,
  projects: 0,
  news: 0,
  shutters: 0,
};
for (const p of enriched) categoryCounts[p._category] += 1;

const visibleCategories = BLOG_CATEGORY_ORDER.filter((id) => categoryCounts[id] > 0).map((id) => ({
  id,
  label: BLOG_CATEGORY_LABELS[id],
  count: categoryCounts[id],
}));

const [featured, ...rest] = enriched;

const jsonLd = [
  breadcrumbList([
    { name: 'Home', url: '/' },
    { name: 'News', url: '/news/' },
  ]),
];

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<BaseLayout
  title="News – Latest on Blinds and Wooden Shutters UK"
  description="Stay updated with the latest news on bespoke blinds, wooden shutters, and home design trends from Shutter Envy. Tips, updates, and inspiration."
  jsonLd={jsonLd}
>
  {/* ─── Hero ───────────────────────────────────────────── */}
  <header class="news-hero" data-reveal>
    <span class="news-hero__eyebrow">News & Updates</span>
    <h1>Shutter Envy News</h1>
    <p>Real projects, plain-English advice, and updates from across Leicester&nbsp;&amp;&nbsp;Leicestershire.</p>
  </header>

  {/* ─── Two-column layout: sidebar + grid ─────────────── */}
  <div class="news-layout">
    {/* Sidebar — sticky on desktop, collapses above grid on mobile */}
    <aside class="news-sidebar" aria-label="Filter posts">
      <div class="news-sidebar__inner">
        <div class="news-sidebar__block">
          <label class="news-search">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.75"/>
              <path d="M20 20l-3.5-3.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
            </svg>
            <input
              type="search"
              id="news-search"
              placeholder="Search posts…"
              aria-label="Search posts"
              autocomplete="off"
            />
            <button type="button" class="news-search__clear" id="news-search-clear" aria-label="Clear search" hidden>×</button>
          </label>
          <p class="news-search__hint">Tip: press <kbd>⌘ K</kbd> to jump here.</p>
        </div>

        <div class="news-sidebar__block">
          <h3 class="news-sidebar__title">Categories</h3>
          <ul class="news-cats" role="group" aria-label="Filter by category">
            <li>
              <button type="button" class="news-cat is-active" data-cat="all" aria-pressed="true">
                <span class="news-cat__label">All posts</span>
                <span class="news-cat__count">{enriched.length}</span>
              </button>
            </li>
            {visibleCategories.map((c) => (
              <li>
                <button type="button" class="news-cat" data-cat={c.id} aria-pressed="false">
                  <span class="news-cat__label">{c.label}</span>
                  <span class="news-cat__count">{c.count}</span>
                </button>
              </li>
            ))}
          </ul>
        </div>

        <div class="news-sidebar__block news-sidebar__cta">
          <p class="news-sidebar__cta-eyebrow">Ready to redesign?</p>
          <p class="news-sidebar__cta-body">Book a free home survey. Samples in hand, quote on the day.</p>
          <a href="/contact/" class="news-sidebar__cta-btn">Arrange a Home Visit →</a>
        </div>
      </div>
    </aside>

    {/* Main column — featured + count + card grid + empty state */}
    <section class="news-main">
      {featured && (
        <article class="news-featured" id="news-featured" data-featured-cat={featured._category}>
          <a href={`/${featured.id}/`} class="news-featured__card">
            <div class="news-featured__image">
              {featured.data.heroImage && (
                <img src={featured.data.heroImage} alt={featured.data.h1 ?? featured.data.title} loading="eager" />
              )}
            </div>
            <div class="news-featured__body">
              <span class="news-featured__badge">★ Featured · {featured._categoryLabel}</span>
              <h2>{featured.data.h1 ?? featured.data.title}</h2>
              {featured._excerptPlain && <p>{featured._excerptPlain}</p>}
              <p class="news-featured__meta">
                <time datetime={featured.data.pubDate.toISOString()}>{fmtDate(featured.data.pubDate)}</time>
                <span aria-hidden="true">·</span>
                <span>By {featured.data.author}</span>
              </p>
              <span class="news-featured__read">Read article →</span>
            </div>
          </a>
        </article>
      )}

      <p class="news-grid__count" id="news-count" aria-live="polite">
        Showing <strong>{rest.length}</strong> of <strong>{rest.length}</strong> posts
      </p>
      <ul class="news-grid__list" id="news-list">
        {rest.map((post) => (
          <li
            class="news-card-wrap"
            data-cat={post._category}
            data-search={`${post.data.title} ${post.data.h1 ?? ''} ${post._excerptPlain}`.toLowerCase()}
          >
            <a href={`/${post.id}/`} class="news-card">
              <div class="news-card__image">
                {post.data.heroImage ? (
                  <img src={post.data.heroImage} alt={post.data.h1 ?? post.data.title} loading="lazy" />
                ) : (
                  <div class="news-card__image-placeholder" aria-hidden="true" />
                )}
                <span class="news-card__tag">{post._categoryLabel}</span>
              </div>
              <div class="news-card__body">
                <h3>{post.data.h1 ?? post.data.title}</h3>
                {post._excerptPlain && <p class="news-card__excerpt">{post._excerptPlain}</p>}
                <p class="news-card__meta">
                  <time datetime={post.data.pubDate.toISOString()}>{fmtDate(post.data.pubDate)}</time>
                  <span class="news-card__read">Read more →</span>
                </p>
              </div>
            </a>
          </li>
        ))}
      </ul>

      <div class="news-empty" id="news-empty" hidden>
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.5"/>
          <path d="M20 20l-3.5-3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <h3>No posts match</h3>
        <p>Try a different search term, or clear the filter.</p>
        <button type="button" class="news-empty__btn" id="news-reset">Reset filters</button>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  // ─── Filter + search behaviour ───────────────────────────────
  const input = document.querySelector<HTMLInputElement>('#news-search');
  const clearBtn = document.querySelector<HTMLButtonElement>('#news-search-clear');
  const resetBtn = document.querySelector<HTMLButtonElement>('#news-reset');
  const pills = Array.from(document.querySelectorAll<HTMLButtonElement>('.news-cat'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.news-card-wrap'));
  const count = document.querySelector<HTMLElement>('#news-count');
  const empty = document.querySelector<HTMLElement>('#news-empty');
  const featured = document.querySelector<HTMLElement>('#news-featured');
  const featuredCat = featured?.dataset.featuredCat ?? '';
  const totalRest = cards.length;

  let activeCat = 'all';
  let activeSearch = '';

  const apply = () => {
    const q = activeSearch.trim().toLowerCase();
    let visible = 0;
    for (const card of cards) {
      const matchesCat = activeCat === 'all' || card.dataset.cat === activeCat;
      const matchesSearch = !q || (card.dataset.search ?? '').includes(q);
      const show = matchesCat && matchesSearch;
      card.hidden = !show;
      if (show) visible++;
    }
    if (featured) {
      // Hide the featured banner whenever a search is active OR a category that
      // doesn't match the featured post is selected.
      const showFeatured =
        !q && (activeCat === 'all' || featuredCat === activeCat);
      featured.hidden = !showFeatured;
    }
    if (count) {
      count.innerHTML = `Showing <strong>${visible}</strong> of <strong>${totalRest}</strong> posts`;
    }
    if (empty) empty.hidden = visible !== 0;
    if (clearBtn) clearBtn.hidden = !q;
  };

  // Search input — lightly debounced
  let t: ReturnType<typeof setTimeout>;
  input?.addEventListener('input', (e) => {
    clearTimeout(t);
    const v = (e.target as HTMLInputElement).value;
    t = setTimeout(() => { activeSearch = v; apply(); }, 80);
  });

  clearBtn?.addEventListener('click', () => {
    if (!input) return;
    input.value = '';
    activeSearch = '';
    input.focus();
    apply();
  });

  // Category pills
  pills.forEach((pill) => {
    pill.addEventListener('click', () => {
      pills.forEach((p) => { p.classList.remove('is-active'); p.setAttribute('aria-pressed', 'false'); });
      pill.classList.add('is-active');
      pill.setAttribute('aria-pressed', 'true');
      activeCat = pill.dataset.cat ?? 'all';
      apply();
    });
  });

  resetBtn?.addEventListener('click', () => {
    if (input) input.value = '';
    activeSearch = '';
    activeCat = 'all';
    pills.forEach((p) => { p.classList.remove('is-active'); p.setAttribute('aria-pressed', 'false'); });
    pills[0]?.classList.add('is-active');
    pills[0]?.setAttribute('aria-pressed', 'true');
    apply();
  });

  // Cmd/Ctrl-K → focus search
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      input?.focus();
      input?.select();
    }
  });
</script>

<style>
  /* ─── Hero ─────────────────────────────────────────────── */
  .news-hero {
    text-align: center;
    padding: 4rem 1.25rem 2rem;
    max-width: 48rem;
    margin: 0 auto;
  }
  .news-hero__eyebrow {
    display: inline-block;
    background: rgba(199,154,8,0.12);
    color: var(--color-gold-600);
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-pill);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0 0 1.25rem;
  }
  .news-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, var(--text-h2-60-500));
    font-weight: 500;
    line-height: 1.075;
    letter-spacing: -0.027em;
    margin: 0 0 1rem;
  }
  .news-hero p {
    color: var(--color-ink-soft);
    font-size: var(--text-large-body-19-400);
    line-height: 1.6;
    margin: 0 auto;
    max-width: 36rem;
    text-wrap: balance;
  }

  /* ─── Two-column layout ────────────────────────────────── */
  .news-layout {
    max-width: var(--container-wide);
    margin: 0 auto;
    padding: 0 1.25rem 5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (min-width: 960px) {
    .news-layout {
      grid-template-columns: 16rem 1fr;
      gap: 3rem;
    }
  }
  @media (min-width: 1280px) {
    .news-layout {
      grid-template-columns: 17rem 1fr;
      gap: 3.5rem;
    }
  }

  /* ─── Sidebar ──────────────────────────────────────────── */
  .news-sidebar {
    min-width: 0;
  }
  .news-sidebar__inner {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  @media (min-width: 960px) {
    .news-sidebar__inner {
      position: sticky;
      top: 90px;
      max-height: calc(100vh - 110px);
      overflow-y: auto;
      padding-right: 0.25rem;
      scrollbar-width: thin;
    }
    .news-sidebar__inner::-webkit-scrollbar { width: 6px; }
    .news-sidebar__inner::-webkit-scrollbar-thumb {
      background: var(--color-line);
      border-radius: 999px;
    }
  }
  .news-sidebar__block {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .news-sidebar__title {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gold-600);
    margin: 0 0 0.25rem;
    padding-bottom: 0.625rem;
    border-bottom: 1px solid var(--color-line);
  }

  /* Search field */
  .news-search {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 0.875rem;
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 10px;
    box-shadow: var(--shadow-sm);
    transition: border-color 200ms, box-shadow 200ms;
    min-width: 0;
  }
  .news-search:focus-within {
    border-color: var(--color-gold-400);
    box-shadow: 0 0 0 4px rgba(199,154,8,0.12);
  }
  .news-search svg { color: var(--color-ink-mute); flex-shrink: 0; }
  .news-search input {
    flex: 1;
    border: 0;
    background: transparent;
    outline: 0;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    color: var(--color-ink);
    min-width: 0;
  }
  .news-search input::placeholder { color: var(--color-ink-mute); }
  .news-search__clear {
    background: var(--color-cream);
    color: var(--color-ink-mute);
    border: 0;
    border-radius: 999px;
    width: 20px;
    height: 20px;
    cursor: pointer;
    font-size: 1rem;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    flex-shrink: 0;
    transition: background 150ms, color 150ms;
  }
  .news-search__clear:hover { background: var(--color-gold-400); color: #fff; }
  .news-search__hint {
    margin: 0;
    color: var(--color-ink-mute);
    font-size: 0.75rem;
  }
  .news-search__hint kbd {
    font-family: ui-monospace, Menlo, monospace;
    font-size: 0.6875rem;
    background: var(--color-cream);
    border: 1px solid var(--color-line);
    border-radius: 4px;
    padding: 0.0625rem 0.3125rem;
    color: var(--color-ink-soft);
  }

  /* Category list */
  .news-cats {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }
  .news-cats li { margin: 0; }
  .news-cat {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    width: 100%;
    padding: 0.5rem 0.75rem;
    background: transparent;
    color: var(--color-ink-soft);
    border: 0;
    border-radius: 8px;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.875rem;
    line-height: 1.3;
    text-align: left;
    cursor: pointer;
    transition: background 160ms, color 160ms, transform 160ms;
  }
  .news-cat:hover {
    background: rgba(199,154,8,0.06);
    color: var(--color-gold-600);
    transform: translateX(2px);
  }
  .news-cat.is-active {
    background: linear-gradient(135deg, rgba(199,154,8,0.14), rgba(199,154,8,0.06));
    color: var(--color-gold-600);
    font-weight: 600;
    position: relative;
  }
  .news-cat.is-active::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.375rem;
    bottom: 0.375rem;
    width: 3px;
    border-radius: 0 3px 3px 0;
    background: linear-gradient(180deg, var(--color-gold-400), var(--color-gold-600));
  }
  .news-cat__label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
  }
  .news-cat__count {
    flex-shrink: 0;
    background: var(--color-cream);
    color: var(--color-ink-mute);
    font-weight: 700;
    font-size: 0.6875rem;
    padding: 0.125rem 0.4375rem;
    border-radius: 999px;
    line-height: 1.4;
  }
  .news-cat.is-active .news-cat__count {
    background: var(--color-gold-400);
    color: #fff;
  }

  /* Sidebar mini CTA card */
  .news-sidebar__cta {
    background: linear-gradient(180deg, var(--color-ink) 0%, #1a1a1a 100%);
    color: #fff;
    padding: 1.25rem 1.25rem 1.5rem;
    border-radius: 12px;
    position: relative;
    overflow: hidden;
  }
  .news-sidebar__cta::before {
    content: "";
    position: absolute;
    top: -40%;
    right: -30%;
    width: 12rem;
    height: 12rem;
    background: radial-gradient(circle, rgba(199,154,8,0.5), transparent 70%);
    pointer-events: none;
  }
  .news-sidebar__cta-eyebrow {
    margin: 0 0 0.5rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-gold-400);
    position: relative;
  }
  .news-sidebar__cta-body {
    margin: 0 0 1rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: rgba(255,255,255,0.85);
    position: relative;
  }
  .news-sidebar__cta-btn {
    display: inline-block;
    width: 100%;
    text-align: center;
    background: linear-gradient(180deg, var(--color-gold-400), var(--color-gold-600));
    color: #fff;
    padding: 0.625rem 1rem;
    border-radius: 999px;
    text-decoration: none;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    box-shadow: 0 10px 24px -10px rgba(199,154,8,0.55);
    transition: filter 200ms, transform 200ms;
    position: relative;
  }
  .news-sidebar__cta-btn:hover { filter: brightness(1.08); transform: translateY(-1px); color: #fff; }

  /* ─── Main column ──────────────────────────────────────── */
  .news-main { min-width: 0; }

  /* ─── Featured (inside main column) ────────────────────── */
  .news-featured { margin: 0 0 2rem; }
  .news-featured[hidden] { display: none; }
  .news-featured__card {
    display: grid;
    grid-template-columns: 1fr;
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    text-decoration: none;
    color: inherit;
    transition: transform 280ms cubic-bezier(0.16,1,0.3,1), box-shadow 280ms, border-color 280ms;
  }
  @media (min-width: 768px) {
    .news-featured__card { grid-template-columns: 1.05fr 1fr; align-items: stretch; }
  }
  .news-featured__card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-gold-400);
  }
  .news-featured__image { background: var(--color-cream); overflow: hidden; }
  .news-featured__image img {
    width: 100%; height: 100%; min-height: 240px; object-fit: cover; display: block;
    transition: transform 600ms cubic-bezier(0.16,1,0.3,1);
  }
  .news-featured__card:hover .news-featured__image img { transform: scale(1.04); }
  .news-featured__body { padding: 1.5rem 1.75rem 1.75rem; display: flex; flex-direction: column; justify-content: center; }
  .news-featured__badge {
    display: inline-block;
    align-self: flex-start;
    background: var(--color-gold-400);
    color: #fff;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-pill);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 1rem;
  }
  .news-featured__body h2 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.5vw, var(--text-h4-28-500));
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.027em;
    margin: 0 0 0.75rem;
    color: var(--color-ink);
  }
  .news-featured__body p {
    color: var(--color-ink-soft);
    font-size: var(--text-body-16-400);
    line-height: 1.65;
    margin: 0 0 1rem;
  }
  .news-featured__meta {
    color: var(--color-ink-mute);
    font-size: var(--text-small-body-15-400);
    display: flex;
    gap: 0.5rem;
    margin: 0 0 1rem;
  }
  .news-featured__read {
    color: var(--color-gold-600);
    font-weight: 700;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* ─── Card grid (inside main column) ───────────────────── */
  .news-grid__count {
    color: var(--color-ink-mute);
    font-size: 0.8125rem;
    margin: 0 0 1.25rem;
    font-weight: 500;
  }
  .news-grid__count strong { color: var(--color-ink); font-weight: 700; }
  .news-grid__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: stretch;
  }
  @media (min-width: 640px) {
    .news-grid__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) {
    .news-grid__list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .news-grid__list li { margin: 0; min-width: 0; }
  .news-card-wrap {
    display: flex;
