---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { breadcrumbList } from '../../lib/schema';

export async function getStaticPaths() {
  const PAGE_SIZE = 10;
  const posts = (await getCollection('blog')).sort(
    (a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate),
  );
  const totalPages = Math.max(1, Math.ceil(posts.length / PAGE_SIZE));
  const paths = [];
  for (let i = 1; i <= totalPages; i++) {
    const start = (i - 1) * PAGE_SIZE;
    paths.push({
      params: { page: i === 1 ? undefined : `page/${i}` },
      props: {
        posts: posts.slice(start, start + PAGE_SIZE),
        currentPage: i,
        totalPages,
      },
    });
  }
  return paths;
}

const { posts, currentPage, totalPages } = Astro.props;
const isFirst = currentPage === 1;
const pageLabel = isFirst ? '' : ` — Page ${currentPage}`;

const prevUrl =
  currentPage === 1 ? null
  : currentPage === 2 ? '/news/'
  : `/news/page/${currentPage - 1}/`;
const nextUrl = currentPage < totalPages ? `/news/page/${currentPage + 1}/` : null;

const jsonLd = [
  breadcrumbList([
    { name: 'Home', url: '/' },
    { name: 'News', url: '/news/' },
    ...(isFirst ? [] : [{ name: `Page ${currentPage}`, url: `/news/page/${currentPage}/` }]),
  ]),
];

// Featured + rest split (first page only)
const [featured, ...rest] = posts;
const showFeatured = isFirst && featured;
const remainder = showFeatured ? rest : posts;

const fmtDate = (d: Date) => d.toLocaleDateString('en-GB', {
  day: 'numeric', month: 'long', year: 'numeric',
});
---
<BaseLayout
  title={
    isFirst
      ? 'News – Latest on Blinds and Wooden Shutters UK'
      : `News – Page ${currentPage} | Shutter Envy`
  }
  description="Stay updated with the latest news on bespoke blinds, wooden shutters, and home design trends from Shutter Envy. Tips, updates, and inspiration."
  jsonLd={jsonLd}
>
  {/* ─── Hero ───────────────────────────────────────────── */}
  <header class="news-hero" data-reveal>
    <span class="news-hero__eyebrow">News & Updates</span>
    <h1>Shutter Envy News{pageLabel}</h1>
    <p>Real projects, plain-English advice, and updates from across Leicester &amp; Leicestershire.</p>
  </header>

  {/* ─── Featured (page 1 only) ─────────────────────────── */}
  {showFeatured && (
    <section class="news-featured" data-reveal="scale">
      <a href={`/${featured.id}/`} class="news-featured__card">
        <div class="news-featured__image">
          {featured.data.heroImage && (
            <img src={featured.data.heroImage} alt={featured.data.h1 ?? featured.data.title} loading="eager" />
          )}
        </div>
        <div class="news-featured__body">
          <span class="news-featured__badge">★ Featured</span>
          <h2>{featured.data.h1 ?? featured.data.title}</h2>
          {featured.data.excerpt && <p>{featured.data.excerpt}</p>}
          <p class="news-featured__meta">
            <time datetime={featured.data.pubDate.toISOString()}>{fmtDate(featured.data.pubDate)}</time>
            <span aria-hidden="true">·</span>
            <span>By {featured.data.author}</span>
          </p>
          <span class="news-featured__read">Read article →</span>
        </div>
      </a>
    </section>
  )}

  {/* ─── Card grid ──────────────────────────────────────── */}
  {remainder.length > 0 && (
    <section class="news-grid">
      <ul class="news-grid__list" data-reveal-children>
        {remainder.map((post: any) => (
          <li>
            <a href={`/${post.id}/`} class="news-card">
              {post.data.heroImage && (
                <div class="news-card__image">
                  <img src={post.data.heroImage} alt={post.data.h1 ?? post.data.title} loading="lazy" />
                </div>
              )}
              <div class="news-card__body">
                <h3>{post.data.h1 ?? post.data.title}</h3>
                {post.data.excerpt && <p class="news-card__excerpt">{post.data.excerpt}</p>}
                <p class="news-card__meta">
                  <time datetime={post.data.pubDate.toISOString()}>{fmtDate(post.data.pubDate)}</time>
                  <span class="news-card__read">Read more →</span>
                </p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {/* ─── Pagination ─────────────────────────────────────── */}
  <nav class="news-pagination" aria-label="News pagination" data-reveal>
    {prevUrl ? (
      <a rel="prev" href={prevUrl} class="news-pagination__btn">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M11 7H3m0 0l4-4m-4 4l4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Newer posts
      </a>
    ) : <span />}
    <span class="news-pagination__counter">Page {currentPage} of {totalPages}</span>
    {nextUrl ? (
      <a rel="next" href={nextUrl} class="news-pagination__btn">
        Older posts
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M3 7h8m0 0L7 3m4 4l-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    ) : <span />}
  </nav>
</BaseLayout>

<style>
  /* ─── Hero ─────────────────────────────────────────────── */
  .news-hero {
    text-align: center;
    padding: 4rem 1.25rem 3rem;
    max-width: 48rem;
    margin: 0 auto;
  }
  .news-hero__eyebrow {
    display: inline-block;
    background: rgba(199,154,8,0.12);
    color: var(--color-gold-600);
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-pill);
    font-size: var(--text-link-12-700);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 1.25rem;
  }
  .news-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, var(--text-h2-60-500));
    font-weight: 500;
    line-height: 1.075;
    letter-spacing: -0.027em;
    margin: 0 0 1rem;
  }
  .news-hero p {
    color: var(--color-ink-soft);
    font-size: var(--text-large-body-19-400);
    line-height: 1.6;
    margin: 0;
  }

  /* ─── Featured card ────────────────────────────────────── */
  .news-featured {
    max-width: var(--container-wide);
    margin: 0 auto 4rem;
    padding: 0 1.25rem;
  }
  .news-featured__card {
    display: grid;
    grid-template-columns: 1fr;
    background: #fff;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    text-decoration: none;
    color: inherit;
    transition: transform 280ms cubic-bezier(0.16,1,0.3,1), box-shadow 280ms;
  }
  @media (min-width: 768px) {
    .news-featured__card { grid-template-columns: 1.1fr 1fr; align-items: stretch; }
  }
  .news-featured__card:hover { transform: translateY(-3px); box-shadow: var(--shadow-xl); }
  .news-featured__image { background: var(--color-cream); overflow: hidden; }
  .news-featured__image img {
    width: 100%; height: 100%; min-height: 280px; object-fit: cover; display: block;
    transition: transform 600ms cubic-bezier(0.16,1,0.3,1);
  }
  .news-featured__card:hover .news-featured__image img { transform: scale(1.04); }
  .news-featured__body { padding: 2rem 2.25rem 2.25rem; display: flex; flex-direction: column; justify-content: center; }
  .news-featured__badge {
    display: inline-block;
    align-self: flex-start;
    background: var(--color-gold-400);
    color: #fff;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-pill);
    font-size: var(--text-link-12-700);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0 0 1rem;
  }
  .news-featured__body h2 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.5vw, var(--text-h4-28-500));
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.027em;
    margin: 0 0 0.75rem;
    color: var(--color-ink);
  }
  .news-featured__body p {
    color: var(--color-ink-soft);
    font-size: var(--text-body-16-400);
    line-height: 1.65;
    margin: 0 0 1rem;
  }
  .news-featured__meta {
    color: var(--color-ink-mute);
    font-size: var(--text-small-body-15-400);
    display: flex;
    gap: 0.5rem;
    margin: 0 0 1rem;
  }
  .news-featured__read {
    color: var(--color-gold-600);
    font-weight: 700;
    font-size: var(--text-link-12-700);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* ─── Card grid ────────────────────────────────────────── */
  .news-grid {
    max-width: var(--container-wide);
    margin: 0 auto;
    padding: 0 1.25rem;
  }
  .news-grid__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (min-width: 640px) { .news-grid__list { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .news-grid__list { grid-template-columns: repeat(3, 1fr); } }
  .news-grid__list li { margin: 0; }

  .news-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    box-shadow: var(--shadow-sm);
    transition: transform 250ms cubic-bezier(0.16,1,0.3,1), box-shadow 250ms, border-color 250ms;
  }
  .news-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-gold-400);
  }
  .news-card__image { overflow: hidden; background: var(--color-cream); }
  .news-card__image img {
    width: 100%;
    aspect-ratio: 16/10;
    object-fit: cover;
    display: block;
    transition: transform 600ms cubic-bezier(0.16,1,0.3,1);
  }
  .news-card:hover .news-card__image img { transform: scale(1.05); }
  .news-card__body { padding: 1.25rem 1.5rem 1.5rem; display: flex; flex-direction: column; flex: 1; gap: 0.75rem; }
  .news-card h3 {
    font-family: var(--font-display);
    font-size: var(--text-h3-21-500);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.027em;
    margin: 0;
    color: var(--color-ink);
  }
  .news-card:hover h3 { color: var(--color-gold-600); }
  .news-card__excerpt {
    color: var(--color-ink-soft);
    font-size: var(--text-small-body-15-400);
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }
  .news-card__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 0;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-line);
    font-size: var(--text-link-12-700);
    color: var(--color-ink-mute);
  }
  .news-card__read {
    color: var(--color-gold-600);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* ─── Pagination ───────────────────────────────────────── */
  .news-pagination {
    max-width: var(--container-wide);
    margin: 4rem auto 5rem;
    padding: 0 1.25rem;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
  }
  .news-pagination__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    background: #fff;
    color: var(--color-ink);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: var(--text-button-14-500);
    letter-spacing: 0.02em;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition: all 200ms;
    width: fit-content;
    justify-self: start;
  }
  .news-pagination__btn:last-child { justify-self: end; }
  .news-pagination__btn:hover {
    background: var(--color-gold-400);
    color: #fff;
    border-color: var(--color-gold-400);
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
  }
  .news-pagination__counter {
    color: var(--color-ink-mute);
    font-size: var(--text-small-body-15-400);
    font-weight: 500;
    text-align: center;
  }
</style>
