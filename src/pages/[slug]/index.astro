---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import FAQ from '../../components/FAQ.astro';
import { blogPosting, breadcrumbList, faqPage } from '../../lib/schema';

// Root-level blog posts (CLAUDE.md §2): /<slug>/, NOT /blog/<slug>/.
// Static .astro routes (e.g. /our-shutters/, /about/) take precedence over this
// dynamic route, so collisions are caught by Astro at build time.
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Show the featured image at the bottom of the body when the body either
// doesn't reference any image, or doesn't reference the hero image itself.
// Stops bare-looking posts (often the ones where the hero is the only photo)
// from ending in a wall of text.
const body = (post as any).body ?? '';
const heroImg = post.data.heroImage ?? '';
const bodyHasAnyImage = /!\[.*?\]\(|<img/i.test(body);
const bodyHasHero = heroImg && body.includes(heroImg);
const showHeroAtEnd = !!heroImg && (!bodyHasAnyImage || !bodyHasHero);

const url = `https://shutter-envy.co.uk/${post.id}/`;
const jsonLd = [
  blogPosting({
    url,
    headline: post.data.h1 ?? post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate,
    dateModified: post.data.updatedDate,
    image: post.data.heroImage,
    author: post.data.author,
  }),
  breadcrumbList([
    { name: 'Home', url: '/' },
    { name: 'News', url: '/news/' },
    { name: post.data.h1 ?? post.data.title, url: `/${post.id}/` },
  ]),
];
if (post.data.faqs.length) jsonLd.push(faqPage(post.data.faqs));
---
<ArticleLayout
  title={post.data.title}
  description={post.data.description}
  h1={post.data.h1}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  heroImage={post.data.heroImage}
  heroImageAlt={post.data.heroImageAlt}
  author={post.data.author}
  jsonLd={jsonLd}
  showHeroAtEnd={showHeroAtEnd}
>
  <Content />
  {post.data.faqs.length > 0 && (
    <FAQ
      items={post.data.faqs}
      id="post-faqs"
      heading="Frequently Asked Questions"
      layout="stacked"
      className="post-faq"
      closingCta={{
        prompt: 'Need advice for your own bedroom windows?',
        label: 'Arrange a home visit',
        href: '/contact/',
      }}
    />
  )}
</ArticleLayout>
