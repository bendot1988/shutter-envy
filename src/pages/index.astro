---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/home/HomeHero.astro';
import AwardsBand from '../components/home/AwardsBand.astro';
import FeatureChecklist from '../components/home/FeatureChecklist.astro';
import StatsRow from '../components/home/StatsRow.astro';
import ReviewsRow from '../components/home/ReviewsRow.astro';
import ProductShowcase from '../components/home/ProductShowcase.astro';
import BayWindowsSection from '../components/home/BayWindowsSection.astro';
import PortchesterCallout from '../components/PortchesterCallout.astro';
import ProcessTimeline from '../components/home/ProcessTimeline.astro';
import AwardsCTABox from '../components/home/AwardsCTABox.astro';
import InlineCTA from '../components/home/InlineCTA.astro';
import TeamCards from '../components/home/TeamCards.astro';
import LatestNewsBand from '../components/home/LatestNewsBand.astro';
import TransformCTA from '../components/home/TransformCTA.astro';
import StickyMobileCTA from '../components/home/StickyMobileCTA.astro';
import Gallery from '../components/Gallery.astro';
import FAQ from '../components/FAQ.astro';
import { faqPage, aggregateRating } from '../lib/schema';

const entry = await getEntry('pages', 'home');
if (!entry) throw new Error('Missing pages/home content entry');

const jsonLd: object[] = [
  // AggregateRating linked to the site-wide LocalBusiness. Mirrors the
  // visible Trustindex/Google count shown on /reviews/. Update both when
  // the review highlights are refreshed.
  aggregateRating({ ratingValue: 5.0, reviewCount: 34 }),
];
if (entry.data.faqs.length) jsonLd.push(faqPage(entry.data.faqs));

// Section background image — used for FeatureChecklist + FAQ overlay
const sectionBg = '/images/mark-shutter-envy-van.png';
---
<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogImage={entry.data.ogImage}
  jsonLd={jsonLd}
  isHome
  announcement={entry.data.announcement}
>
  {/* HERO — image bg + form + dropdown "How can we help?" + animated trust badges */}
  <HomeHero
    backgroundImage={entry.data.heroBackgroundImage}
    eyebrow={entry.data.heroEyebrow ?? ''}
    heading={entry.data.h1}
    location={entry.data.heroLocation}
    badges={entry.data.trustStrip}
  />

  {/* AWARDS BAND — white, replaces awards-in-hero */}
  {entry.data.heroAwardImages.length > 0 && (
    <AwardsBand images={entry.data.heroAwardImages} />
  )}

  {/* FEATURE CHECKLIST — shutter image bg with cream overlay */}
  {entry.data.featureChecklist && (
    <FeatureChecklist {...entry.data.featureChecklist} backgroundImage={sectionBg} />
  )}

  {/* STATS — clean white */}
  {entry.data.stats.length > 0 && <StatsRow items={entry.data.stats} />}

  {/* REVIEWS — cream */}
  {entry.data.reviewsRow && <ReviewsRow {...entry.data.reviewsRow} />}

  {/* GALLERY — white container */}
  {entry.data.gallery.length > 0 && (
    <div class="container" style="padding-block: 4rem;">
      <Gallery images={entry.data.gallery} />
    </div>
  )}

  {/* PRODUCT SHOWCASE — DARK with image bg, white cards stand out */}
  {entry.data.productShowcase && (
    <ProductShowcase
      {...entry.data.productShowcase}
      backgroundImage="/wp-content/uploads/2026/04/Bay-window-shutters-in-Loughborough.jpeg"
    />
  )}

  {/* BAY WINDOWS — speciality service spotlight (cream band) */}
  {entry.data.bayWindows && <BayWindowsSection {...entry.data.bayWindows} />}

  {/* PORTCHESTER® — premium aluminium upsell (dark image band) */}
  <PortchesterCallout />

  {/* PROCESS TIMELINE — cream gradient with subtle shutter pattern */}
  {entry.data.processSteps.length > 0 && <ProcessTimeline steps={entry.data.processSteps} />}

  {/* MID-PAGE CTA — gold band */}
  {entry.data.midPageCta && <InlineCTA {...entry.data.midPageCta} />}

  {/* AWARDS CTA — dark box on white */}
  {entry.data.awardsCTA && <AwardsCTABox {...entry.data.awardsCTA} />}

  {/* TEAM — cream radial */}
  {entry.data.team && <TeamCards {...entry.data.team} />}

  {/* FAQ — shutter image bg with light overlay */}
  {entry.data.faqs.length > 0 && (
    <FAQ
      items={entry.data.faqs}
      heading="Your Questions Answered"
      intro={entry.data.faqsIntro}
      backgroundImage={sectionBg}
      closingCta={{
        label: 'Talk to Mark Directly',
        href: '/contact/',
        prompt: 'Still have questions?',
      }}
    />
  )}

  {/* LATEST NEWS — dark olive band */}
  <LatestNewsBand />

  {/* TRANSFORM CTA — half image / half cream */}
  {entry.data.transformCTA && <TransformCTA {...entry.data.transformCTA} />}

  <StickyMobileCTA />
</BaseLayout>
