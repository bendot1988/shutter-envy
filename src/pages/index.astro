---
import { getEntry, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import { faqPage } from '../lib/schema';

const entry = await getEntry('pages', 'home');
if (!entry) throw new Error('Missing pages/home content entry');
const { Content } = await render(entry);

// Homepage: omit BreadcrumbList per Google guidance.
const jsonLd: object[] = [];
if (entry.data.faqs.length) jsonLd.push(faqPage(entry.data.faqs));
---
<PageLayout
  title={entry.data.title}
  description={entry.data.description}
  h1={entry.data.h1}
  hero={entry.data.hero}
  gallery={entry.data.gallery}
  faqs={entry.data.faqs}
  cta={entry.data.cta}
  ogImage={entry.data.ogImage}
  jsonLd={jsonLd}
>
  <Content />
</PageLayout>
