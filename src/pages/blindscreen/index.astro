---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeatureChecklist from '../../components/home/FeatureChecklist.astro';
import FAQ from '../../components/FAQ.astro';
import ProcessTimeline from '../../components/home/ProcessTimeline.astro';
import ReviewsRow from '../../components/home/ReviewsRow.astro';
import InlineCTA from '../../components/home/InlineCTA.astro';
import ClearLineForm from '../../components/ClearLineForm.astro';
import { faqPage, breadcrumbList, service } from '../../lib/schema';
import { TRACK } from '../../data/tracking';

const entry = await getEntry('pages', 'blindscreen');
if (!entry) throw new Error('Missing pages/blindscreen content entry');

const jsonLd: object[] = [
  breadcrumbList([
    { name: 'Home', url: '/' },
    { name: 'BlindScreen', url: '/blindscreen/' },
  ]),
  service({
    url: 'https://shutter-envy.co.uk/blindscreen/',
    name: 'BlindScreen external solar blinds',
    description: 'Heat-blocking external BlindScreen installations for homes and conservatories across Leicestershire.',
    serviceType: 'External solar shading',
  }),
];
if (entry.data.faqs?.length) jsonLd.push(faqPage(entry.data.faqs));

const locationEntries = await getCollection('locations');
const towns = locationEntries
  .map((l) => {
    const slug = l.id.replace(/\.md$/, '');
    const town = slug
      .replace(/^shutters-(in-)?/, '')
      .split('-')
      .map((w) => (w === 'upon' ? 'upon' : w.charAt(0).toUpperCase() + w.slice(1)))
      .join(' ');
    return { town, href: `/locations/${slug}/` };
  })
  .filter((t) => !/charnwood/i.test(t.town))
  .sort((a, b) => a.town.localeCompare(b.town));

const logoSrc = '/images/blindscreen/logo.png';
const heroImage = '/images/blindscreen/kitchen-wide.webp';
const blindCloseup = '/images/blindscreen/blind-closeup.webp';

const blackoutBeforeAfter = '/images/blindscreen/blackout-before-after.png';

const showcaseImages = [
  { src: heroImage, alt: 'BlindScreen® pleated blackout blind fitted above a kitchen sink' },
  {
    src: blackoutBeforeAfter,
    alt: 'Before and after: bright bedroom with sheer curtains versus the same room darkened with BlindScreen blackout',
  },
  { src: blindCloseup, alt: 'Close-up of BlindScreen® charcoal pleated fabric on a kitchen window' },
];

const pillars = [
  {
    title: 'Blackout',
    body: 'Perfect for night-shift workers and undisturbed sleep. Total light control for bedrooms and cinema rooms.',
    points: [
      'Great for day sleepers & night-shift workers',
      '100% blackout for bedrooms',
      'Ideal for cinema & media rooms',
      'Blocks streetlights & early-morning sun',
      'Honeycomb fabric helps retain warmth in winter',
    ],
  },
  {
    title: 'Privacy',
    body: 'Enjoy daytime security without losing your view. Ideal for street-facing bifolds and large patio doors.',
    points: [
      'Daytime privacy without losing your view',
      'Perfect for street-facing bifolds',
      'Discreet slimline frames on any opening',
      'Custom-made to your exact sizes',
      'Optional dual fabric layers',
    ],
  },
  {
    title: 'Insect Screen',
    body: 'Keep the summer breeze flowing and the bugs out. Ultra-fine mesh that disappears when not in use.',
    points: [
      'Integrated ultra-fine fly mesh',
      'Keep bifolds & patio doors open all summer',
      'Mesh retracts completely when not in use',
      'Keeps wasps, flies & midges outside',
      'Fresh air in — bugs stay out',
    ],
  },
];

const features = [
  { heading: 'Up to 49% reduction in heat loss', body: '' },
  { heading: 'Integrated fly screen for bifolds and patios', body: '' },
  { heading: '100% blackout for bedrooms', body: '' },
  { heading: 'Slimline frames — discreet on any opening', body: '' },
  { heading: 'Dual-track blackout and mesh options', body: '' },
  { heading: 'Measured and fitted by our Leicestershire team', body: '' },
];

const energyCompare = [
  { label: 'BlindScreen® honeycomb blackout', pct: 49, highlight: true },
  { label: 'Roller blind with zipped side channels', pct: 33, highlight: false },
  { label: 'Honeycomb blackout in framed bead system', pct: 32, highlight: false },
  { label: 'Internal plantation shutter', pct: 28, highlight: false },
  { label: 'Standard roller blinds', pct: 13, highlight: false },
];

const difference = [
  { title: 'Personal commitment', body: 'When you choose Shutter Envy, you get our guarantee of quality and service on every BlindScreen® install.' },
  { title: 'Precision and customisation', body: 'Every system is made to measure for your exact opening. We focus on perfect fit and a flawless finish.' },
  { title: 'Premium materials', body: 'Durable, high-grade fabrics and hardware chosen for long-term performance and a clean, modern look.' },
  { title: 'Genuine local focus', body: 'We are based in Leicestershire. We know local property styles and we are accountable to our neighbours.' },
  { title: 'In-house expertise', body: 'From the first home visit to the final fitting, our team manages the entire process — no outsourced measuring or installation.' },
  { title: 'Reputation over revenue', body: 'Our growth is driven by recommendations. We prioritise exceptional results over high-volume sales.' },
];

const reviews = [
  { name: 'Liz Twitchell', rating: 5, date: '1 year ago', body: 'Top notch job by Mark and team yet again. From initial consultation to fitting — a totally professional, efficient and friendly experience.' },
  { name: 'Wendy Harrison', rating: 5, date: '2 years ago', body: 'I would like to thank Mark & Co at Shutter Envy. Their service is excellent. From the minute I contacted them they were helpful and professional.' },
  { name: 'Sandra Mould', rating: 5, date: '2 years ago', body: 'Fantastic service from Mark. First class product. Excellent results. Fast, efficient and perfect. So pleased.' },
];

const processSteps = [
  { title: 'Schedule a Home Visit', body: "Book a time that suits you. We'll assess your openings and talk through BlindScreen® options.", image: '/wp-content/uploads/2024/10/106shots_so.jpeg' },
  { title: 'Personalised Home Visit', body: 'Mark surveys your windows or bifolds and gives you a no-obligation quote on the day.', image: '/images/mark-shutter-envy-van.png' },
  { title: 'Manufacturing With Care', body: 'Your BlindScreen® is made to order to your exact sizes and fabric choices.', image: '/wp-content/uploads/2024/09/5bc529c6-242f-4aab-8112-67d895fc7c43-1024x768.jpg' },
  { title: 'Professional Installation', body: 'Tidy fitting by our own team — frames, fabrics and insect mesh commissioned on the day.', image: '/wp-content/uploads/2024/10/dotwall-Web-Design2024-10-07-at-14.08.01.jpeg' },
  { title: 'Enjoy Your BlindScreen®', body: 'Full handover and guidance on operating blackout, privacy and fly-screen modes.', image: '/wp-content/uploads/2024/09/431555826_2629833587193609_4928996973115882659_n-300x169.jpg' },
];

const cta = entry.data.cta;
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogImage={entry.data.ogImage}
  jsonLd={jsonLd}
  fullWidthMain
>
  <section class="bs-hero" style={`background-image: url('${heroImage}')`}>
    <div class="bs-hero__overlay" />
    <div class="bs-hero__inner" data-reveal>
      <img class="bs-hero__logo" src={logoSrc} alt="BlindScreen® logo" width="240" height="80" />
      <h1>{entry.data.h1}</h1>
      <p class="bs-hero__lede">
        Expertly fitted for bedrooms, bifold doors and large windows. A modern alternative with up to <strong>49% better thermal efficiency</strong> and a typical <strong>14-day</strong> survey-to-fit turnaround.
      </p>
      <div class="bs-hero__actions">
        <a href="/contact/" class="bs-hero__btn" data-track={TRACK.productHeroCtas}>
          Arrange a Free Home Visit
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M3 7h8m0 0L7 3m4 4l-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="/about/" class="bs-hero__btn bs-hero__btn--ghost">Why Choose Us?</a>
      </div>
    </div>
  </section>

  <section class="bs-ba" aria-label="BlindScreen installations" data-reveal>
    <div class="bs-ba__inner container">
      <ul class="bs-ba__grid" data-reveal-children>
        {showcaseImages.map((img) => (
          <li>
            <figure>
              <img src={img.src} alt={img.alt} loading="lazy" width="1024" height="576" />
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="bs-pillars" aria-label="BlindScreen benefits" data-reveal>
    <div class="bs-pillars__inner container">
      <ul class="bs-pillars__grid" data-reveal-children>
        {pillars.map((p) => (
          <li class="bs-pillar">
            <h2>{p.title}</h2>
            <p>{p.body}</p>
            <ul class="bs-pillar__points">
              {p.points.map((point, i) => (
                <li style={`--point-i: ${i}`}>
                  <span class="bs-pillar__check" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
                      <path d="M4 10.5l4 4 8-9" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="bs-intro container" data-reveal>
    <h2>High-Performance Blackout &amp; Fly Screens for Every Room</h2>
    <p>
      For homeowners across <strong>Leicestershire</strong> — from Leicester and <strong>Loughborough</strong> to
      <strong> Melton Mowbray</strong> and <strong>Market Harborough</strong> — finding a window treatment that handles
      summer pests and winter heat loss is a challenge. BlindScreen® offers a dual-action solution: 100% blackout for
      restful bedrooms and a durable fly screen for bifold doors, with slimline frames that do not sacrifice style.
    </p>
    <p>
      Whether you are upgrading a bifold in a new build or adding versatility to a family home, this space-saving design
      is engineered for local properties while delivering year-round comfort and practical control over light, privacy
      and ventilation.
    </p>
    <a href="/contact/" class="bs-hero__btn">Arrange Your Free Home Visit</a>
  </section>

  <FeatureChecklist
    heading="Engineered for Real Homes"
    body="BlindScreen® combines blackout fabric, optional privacy layers and integrated insect mesh in one slim system."
    items={features}
    cta={{ label: 'Arrange a Home Visit', href: '/contact/' }}
    backgroundImage={heroImage}
  />

  <section class="bs-thermal container" data-reveal>
    <div class="bs-thermal__grid">
      <div class="bs-thermal__copy" data-reveal="left">
        <h2>Reduce Heat Loss by Up to 49%</h2>
        <p>
          Standard blinds leave gaps. BlindScreen® uses a honeycombed cellular structure that traps air — a thermal
          barrier that keeps you warm in winter and cooler in summer.
        </p>
        <ul class="bs-thermal__bullets">
          <li><strong>Fast turnaround:</strong> Typically around 14 days from survey to installation.</li>
          <li><strong>Bifold specialists:</strong> Custom-tracked for large openings.</li>
          <li><strong>Certified installation:</strong> Fitted by the Shutter Envy team.</li>
        </ul>
        <a href="/contact/" class="bs-hero__btn">Arrange Your Free Home Visit</a>
      </div>
      <div class="bs-thermal__media" data-reveal="right">
        <img src={blindCloseup} alt="BlindScreen® honeycomb pleated fabric reducing heat loss at the window" loading="lazy" width="1024" height="1024" />
      </div>
    </div>
  </section>

  <aside class="bs-pledge" data-reveal>
    <p>Measured by us, fitted by us. No sub-contractors. No national call centres. <strong>Just local expertise.</strong></p>
  </aside>

  <section class="bs-testimonial container" data-reveal>
    <figure class="bs-testimonial__card">
      <img src="/images/mark-shutter-envy-van.png" alt="Mark, Shutter Envy" width="96" height="96" loading="lazy" />
      <blockquote>
        <p>
          "BlindScreen® finally solves the bifold problem — massive energy savings without sacrificing how a modern
          home looks. It is a genuine game-changer for bedrooms and patio doors across Leicestershire."
        </p>
        <figcaption>Mark, Shutter Envy</figcaption>
      </blockquote>
    </figure>
  </section>

  <section class="bs-locations" data-reveal>
    <div class="bs-locations__overlay"></div>
    <div class="bs-locations__inner container">
      <header>
        <span class="bs-locations__eyebrow">Coverage</span>
        <h2>Our BlindScreen® Service Areas</h2>
        <p>We fit BlindScreen® across Leicester, Loughborough, Melton Mowbray, Market Harborough and nearby villages.</p>
      </header>
      <ul class="bs-locations__grid" data-reveal-children>
        {towns.map((t) => (
          <li>
            <a href={t.href} class="bs-location-card">
              <span class="bs-location-card__label">BlindScreen® in</span>
              <span class="bs-location-card__town">{t.town}</span>
              <span class="bs-location-card__cta">View area →</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="bs-energy container" data-reveal>
    <header>
      <h2>Energy Saving by Type of Blind and Shutter</h2>
      <p class="bs-energy__intro">Independent comparisons show how BlindScreen® compares with other window treatments.</p>
    </header>
    <ul class="bs-energy__grid" data-reveal-children>
      {energyCompare.map((item) => (
        <li class:list={['bs-energy__card', item.highlight && 'bs-energy__card--highlight']}>
          <p class="bs-energy__label">{item.label}</p>
          <p class="bs-energy__caption">heat loss reduction, up to</p>
          <p class="bs-energy__pct"><span>{item.pct}</span>%</p>
        </li>
      ))}
    </ul>
    <p class="bs-energy__source">Comparative data from industry sources including the BBSA.</p>
  </section>

  {entry.data.faqs.length > 0 && (
    <FAQ
      items={entry.data.faqs}
      heading="FAQ About BlindScreen"
      intro="Common questions about BlindScreen® blackout and fly screens."
      layout="stacked"
    />
  )}

  <section class="bs-difference" data-reveal>
    <div class="bs-difference__inner">
      <header>
        <span class="bs-eyebrow">Why Shutter Envy</span>
        <h2>What Makes Shutter Envy Different?</h2>
        <p>
          We are a family-run Leicestershire company built on craftsmanship, care and quality — not a national franchise.
        </p>
      </header>
      <ul class="bs-difference__grid" data-reveal-children>
        {difference.map((d) => (
          <li>
            <h3>{d.title}</h3>
            <p>{d.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {cta && (
    <section class="bs-form" data-reveal>
      <div class="bs-form__grid">
        <div class="bs-form__copy" data-reveal="left">
          <span class="bs-eyebrow">Get Started</span>
          <h2>{cta.heading}</h2>
          {cta.body && <p>{cta.body}</p>}
        </div>
        <div class="bs-form__panel" data-reveal="right">
          <ClearLineForm showIntro={false} />
        </div>
      </div>
    </section>
  )}

  <ProcessTimeline steps={processSteps} />

  <ReviewsRow
    heading="What Our Customers Say"
    rating="5.0"
    totalReviews="25"
    source="Google"
    link="https://www.google.com/maps/place/Shutter+Envy+Ltd/@52.7208272,-1.1413311,15z"
    reviews={reviews}
  />

  <InlineCTA
    eyebrow="Ready for BlindScreen®?"
    heading="Book Your Free Home Survey"
    body="Mark visits your home, surveys your openings and gives you a no-obligation quote on the day."
    cta={{ label: 'Arrange a Home Visit', href: '/contact/' }}
    secondaryCta={{ label: 'Call 07729 572277', href: 'tel:+447729572277' }}
    tone="gold"
  />
</BaseLayout>

<style>
  .bs-eyebrow {
    display: inline-block;
    background: rgba(199, 154, 8, 0.12);
    color: var(--color-gold-600);
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-pill);
    font-size: var(--text-link-12-700);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 1.25rem;
  }

  .bs-hero {
    position: relative;
    margin: 0 calc(50% - 50vw);
    padding: 5.5rem 1.25rem 6rem;
    background-color: #1a1a1a;
    background-size: cover;
    background-position: center;
    text-align: center;
    overflow: hidden;
  }
  .bs-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(12, 12, 12, 0.55) 0%, rgba(12, 12, 12, 0.82) 100%);
  }
  .bs-hero__inner { position: relative; max-width: 44rem; margin: 0 auto; color: #fff; }
  .bs-hero__logo {
    display: block;
    width: min(240px, 70vw);
    height: auto;
    margin: 0 auto 1.5rem;
    filter: drop-shadow(0 4px 16px rgba(0, 0, 0, 0.35));
  }
  .bs-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.027em;
    margin: 0 0 1.25rem;
    text-wrap: balance;
    color: #fff;
  }
  .bs-hero__lede {
    color: rgba(255, 255, 255, 0.88);
    font-size: var(--text-large-body-19-400);
    line-height: 1.6;
    margin: 0 auto 2rem;
    max-width: 36rem;
  }
  .bs-hero__actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .bs-hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.875rem;
    background: linear-gradient(180deg, var(--color-gold-400), var(--color-gold-600));
    color: #fff;
    border-radius: var(--radius-pill);
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: var(--text-button-14-500);
    letter-spacing: 0.02em;
    text-decoration: none;
    box-shadow: 0 12px 32px -8px rgba(199, 154, 8, 0.55);
    transition: transform 200ms, filter 200ms;
  }
  .bs-hero__btn:hover { transform: translateY(-2px); filter: brightness(1.08); color: #fff; }
  .bs-hero__btn--ghost {
    background: transparent;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.35);
    box-shadow: none;
  }
  .bs-hero__btn--ghost:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: var(--color-gold-400);
    color: #fff;
  }

  .bs-ba { padding: 3rem 0; background: #fff; overflow: visible; }
  .bs-ba__inner { overflow: visible; }
  .bs-ba__grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    overflow: visible;
  }
  @media (min-width: 768px) {
    .bs-ba__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
      align-items: center;
    }
  }
  .bs-ba__grid li {
    margin: 0;
    position: relative;
    z-index: 1;
  }
  .bs-ba__grid li:hover { z-index: 3; }
  .bs-ba__grid figure {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-line);
    box-shadow: var(--shadow-sm);
    transform: scale(1);
    transform-origin: center center;
    transition:
      transform 500ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 500ms cubic-bezier(0.16, 1, 0.3, 1),
      border-color 300ms ease;
    cursor: zoom-in;
  }
  .bs-ba__grid figure:hover {
    transform: scale(1.12);
    border-color: rgba(199, 154, 8, 0.4);
    box-shadow:
      var(--shadow-xl),
      0 32px 64px -28px rgba(0, 0, 0, 0.28);
  }
  .bs-ba__grid img {
    display: block;
    width: 100%;
    aspect-ratio: 4/5;
    object-fit: cover;
    object-position: center;
    transform: scale(1);
    transition: transform 650ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .bs-ba__grid figure:hover img {
    transform: scale(1.05);
  }
  @media (prefers-reduced-motion: reduce) {
    .bs-ba__grid figure,
    .bs-ba__grid img { transition: none; cursor: default; }
    .bs-ba__grid li:hover { z-index: 1; }
    .bs-ba__grid figure:hover {
      transform: none;
      box-shadow: var(--shadow-sm);
    }
    .bs-ba__grid figure:hover img { transform: none; }
  }

  .bs-pillars { padding: 4rem 0; background: var(--color-cream); }
  .bs-pillars__grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 768px) { .bs-pillars__grid { grid-template-columns: repeat(3, 1fr); } }
  .bs-pillars__grid li { margin: 0; }
  .bs-pillar {
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    padding: 2rem 1.75rem;
    box-shadow: var(--shadow-sm);
    height: 100%;
    transition:
      transform 450ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 450ms cubic-bezier(0.16, 1, 0.3, 1),
      border-color 300ms ease;
  }
  .bs-pillar:hover {
    transform: translateY(-6px);
    border-color: rgba(199, 154, 8, 0.35);
    box-shadow: var(--shadow-md), 0 20px 40px -24px rgba(0, 0, 0, 0.12);
  }
  .bs-pillar h2 {
    font-family: var(--font-display);
    font-size: var(--text-h3-24-500);
    font-weight: 500;
    color: var(--color-gold-600);
    margin: 0 0 0.75rem;
  }
  .bs-pillar > p {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: var(--text-body-16-400);
    line-height: 1.6;
  }
  .bs-pillar__points {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .bs-pillar__points > li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.625rem;
    align-items: start;
    margin: 0;
    font-size: var(--text-small-body-15-400);
    line-height: 1.45;
    color: var(--color-ink);
    transition: color 350ms ease;
  }
  @media (hover: hover) {
    .bs-pillar__points > li {
      transform: translateX(-5px);
      transition:
        transform 400ms cubic-bezier(0.16, 1, 0.3, 1),
        color 350ms ease;
      transition-delay: calc(var(--point-i, 0) * 55ms);
    }
    .bs-pillar:hover .bs-pillar__points > li {
      transform: translateX(0);
      color: var(--color-gold-600);
    }
  }
  .bs-pillar__check {
    color: #16a34a;
    flex-shrink: 0;
    margin-top: 0.1rem;
    transition: color 350ms ease, transform 400ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  @media (hover: hover) {
    .bs-pillar__check {
      transform: scale(0.9);
      transition-delay: calc(var(--point-i, 0) * 55ms + 30ms);
    }
    .bs-pillar:hover .bs-pillar__check {
      color: var(--color-gold-600);
      transform: scale(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bs-pillar,
    .bs-pillar__points > li,
    .bs-pillar__check { transition: none; }
    .bs-pillar:hover { transform: none; }
    .bs-pillar__points > li {
      opacity: 1;
      transform: none;
    }
    .bs-pillar__check { transform: none; }
  }

  .bs-intro {
